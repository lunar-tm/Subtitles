Dialogue: 0,0:35:15.25,0:35:18.04,Default,,0,0,0,,!اخرجوا! هيا
Dialogue: 0,0:35:18.13,0:35:20.26,Default,,0,0,0,,!هيا
Dialogue: 0,0:35:23.63,0:35:26.05,Default,,0,0,0,,!اذهبوا
Dialogue: 0,0:35:26.14,0:35:27.64,Default,,0,0,0,,!هيا
Dialogue: 0,0:36:07.22,0:36:09.01,Default,,0,0,0,,!إنهم بالقرب من السور
Dialogue: 0,0:36:13.10,0:36:15.35,Default,,0,0,0,,!اجلبوا المزيد من الرجال إلى هنا
Dialogue: 0,0:36:19.61,0:36:21.82,Default,,0,0,0,,!سدّوا الفجوات بسرعة -\N!تعالوا -
Dialogue: 0,0:36:21.90,0:36:23.03,Default,,0,0,0,,!يتسلقون الأسوار
Dialogue: 0,0:36:23.11,0:36:25.74,Default,,0,0,0,,!لينتشر الرماة -\N!لينتشر الرماة -
Dialogue: 0,0:36:27.82,0:36:29.20,Default,,0,0,0,,!الرماة في الأعلى
Dialogue: 0,0:36:29.28,0:36:31.95,Default,,0,0,0,,!اصعدوا -\N!هيا! تعالوا -
Dialogue: 0,0:36:32.04,0:36:33.66,Default,,0,0,0,,!هيا -\N!تراجعوا -
Dialogue: 0,0:36:33.75,0:36:35.41,Default,,0,0,0,,!اصطفوا -\N!تحركوا! هيا -
Dialogue: 0,0:36:35.50,0:36:37.83,Default,,0,0,0,,!تراجعوا -\N!تراجعوا أيها الرماة -
Dialogue: 0,0:36:54.10,0:36:56.69,Default,,0,0,0,,!احموا السور -\N!إنهم يتسلقون السور -
