Dialogue: 0,0:49:33.61,0:49:35.40,Default,,0,0,0,,!رجاءً
Dialogue: 0,0:49:35.49,0:49:36.90,Default,,0,0,0,,!افتحوه
Dialogue: 0,0:51:11.87,0:51:14.50,Default,,0,0,0,,!تحركي! هيا
Dialogue: 0,0:51:14.58,0:51:17.09,Default,,0,0,0,,!هيا -\N!اركضي -
Dialogue: 0,0:51:43.24,0:51:44.53,Default,,0,0,0,,!علينا أن نسرع
Dialogue: 0,0:52:46.26,0:52:48.43,Default,,0,0,0,,،لقد أعاده "إله النور" لهدف ما
Dialogue: 0,0:52:53.44,0:52:55.61,Default,,0,0,0,,.وقد تحقق هذا الهدف الآن
Dialogue: 0,0:53:00.99,0:53:02.03,Default,,0,0,0,,.أنا أعرفك
Dialogue: 0,0:53:07.70,0:53:08.91,Default,,0,0,0,,.وأنا أعرفك
Dialogue: 0,0:53:16.71,0:53:18.25,Default,,0,0,0,,.قلت إننا سنتقابل ثانيةً
Dialogue: 0,0:53:19.00,0:53:20.30,Default,,0,0,0,,.وها قد تقابلنا
Dialogue: 0,0:53:21.30,0:53:22.59,Default,,0,0,0,,.في نهاية العالم
Dialogue: 0,0:53:24.84,0:53:28.14,Default,,0,0,0,,قلت إنني سأغلق الكثير من العيون\N.إلى الأبد بالموت
Dialogue: 0,0:53:28.39,0:53:29.93,Default,,0,0,0,,.كنت على حق في ذلك أيضًا
Dialogue: 0,0:53:30.97,0:53:32.14,Default,,0,0,0,,...عيون بنية
Dialogue: 0,0:53:32.89,0:53:34.14,Default,,0,0,0,,...وعيون خضراء
Dialogue: 0,0:53:36.44,0:53:37.81,Default,,0,0,0,,.وعيون زرقاء
Dialogue: 0,0:53:57.29,0:53:59.92,Default,,0,0,0,,ماذا نقول لـ"إله الموت"؟
Dialogue: 0,0:54:04.13,0:54:05.26,Default,,0,0,0,,.ليس اليوم
Dialogue: 0,0:54:30.74,0:54:31.79,Default,,0,0,0,,!ها قد جاؤوا
Dialogue: 0,0:54:35.54,0:54:36.66,Default,,0,0,0,,.تشبثوا يا رجال
Dialogue: 0,0:54:38.00,0:54:39.04,Default,,0,0,0,,.تشبثوا
Dialogue: 0,0:54:41.92,0:54:43.25,Default,,0,0,0,,.استغلوا كل ضربة أقصى استغلال
