1
00:00:15,497 --> 00:00:16,873
‫"الحديقة مغلقة"‬

2
00:01:21,938 --> 00:01:24,858
‫اسم الضحية (نوا فاليكيت)‬
‫عمره ٣٢ ويقطن على بعد بضعة مبان‬

3
00:01:25,066 --> 00:01:27,277
‫قالت الشرطة المحلية‬
‫إن مهرجاً أطلق النار على ظهره‬

4
00:01:27,444 --> 00:01:30,363
‫- وقطع إصبعه‬
‫- مهرج؟ أي إصبع؟‬

5
00:01:30,488 --> 00:01:31,906
‫- السبابة الأيمن‬
‫- هل من شهود؟‬

6
00:01:32,032 --> 00:01:35,410
‫أجل، سمع صاحب متجر الطلق الناري‬
‫ولمح المشتبه به وهو يهرب‬

7
00:01:35,577 --> 00:01:38,663
‫أظن بأن القاتل أجبره‬
‫على سلك الممشى ومن ثم قتله‬

8
00:01:38,788 --> 00:01:40,915
‫- هل أخذ القاتل الإصبع معه؟‬
‫- هذا ما يبدو‬

9
00:01:43,084 --> 00:01:46,004
‫استخدامات السبابة الأيمن المقطوع‬

10
00:01:46,254 --> 00:01:47,630
‫بعث رسالة؟‬

11
00:01:48,965 --> 00:01:51,176
‫- هل أنتما من مكتب (كاليفورنيا) للتحقيقات؟‬
‫- العميلة (تيريزا ليزبن)‬

12
00:01:51,301 --> 00:01:52,802
‫- هذا (باتريك جاين)‬
‫- (إليس هيندن)‬

13
00:01:53,011 --> 00:01:55,889
‫يسرني أن مكتبكما قريب‬
‫فالقضية تفوق طاقتنا‬

14
00:01:56,181 --> 00:01:57,557
‫حاولنا عدم إفساد الأمر‬

15
00:01:58,224 --> 00:02:01,186
‫حافظنا على موقع الجريمة‬
‫وفتشنا المنطقة بحثاً عن شهود‬

16
00:02:01,478 --> 00:02:03,313
‫وتوصلنا إلى وصف للقاتل‬

17
00:02:03,480 --> 00:02:06,149
‫يبدو أنكم تعرفون ما عليكم فعله‬
‫لماذا اتصلتم بنا؟‬

18
00:02:06,649 --> 00:02:08,818
‫هذا من أمسكنا به‬
‫بالاعتماد على الوصف‬

19
00:02:14,407 --> 00:02:16,284
‫- أبعد يديك عني!‬
‫- ماذا تفعل؟‬

20
00:02:16,451 --> 00:02:19,871
‫- عد إلى الصف يا سيدي...‬
‫- كنت فقط أحاول التقدم، لدي موعد آخر‬

21
00:02:23,917 --> 00:02:25,502
‫جميعهم يبكون من الداخل‬

22
00:02:34,770 --> 00:02:36,563
‫"ما سبب ارتدائك هذا الزي؟"‬

23
00:02:36,855 --> 00:02:38,398
‫كان هناك إعلان تمثيلي‬
‫على الإنترنت‬

24
00:02:38,774 --> 00:02:40,859
‫ذكر أنهم سينظمون تجارب أداء اليوم‬
‫من أجل فيلم عن سيرك‬

25
00:02:40,984 --> 00:02:42,361
‫سيتم تصويره في مقاطعة (سولانو)‬

26
00:02:42,778 --> 00:02:45,781
‫كانوا يبحثون عن ممثل مهرج‬
‫وحددوا أن نأتي مرتدين الزي‬

27
00:02:46,073 --> 00:02:48,033
‫هل ذكر الإعلان اسماً‬
‫معلومات عن كيفية الاتصال؟‬

28
00:02:48,617 --> 00:02:49,993
{\an8}‫لا، العنوان والوقت فقط‬

29
00:02:50,285 --> 00:02:52,162
{\an8}‫- ما هو اسمك مجدداً؟‬
‫- (فان بيلت)‬

30
00:02:52,454 --> 00:02:53,831
{\an8}‫حسناً آنسة (فان بي)‬

31
00:02:54,706 --> 00:02:58,710
{\an8}‫ما هذا؟ قلبي موجود في جيبك‬

32
00:03:01,255 --> 00:03:02,631
‫شكراً على منحي وقتك‬

33
00:03:03,632 --> 00:03:05,384
{\an8}‫- أكره المهرجين‬
‫- لدي الشعور نفسه‬

34
00:03:05,509 --> 00:03:08,428
{\an8}‫- القصة نفسها؟‬
‫- قال إنه جاء من أجل تجربة أداء‬

35
00:03:08,595 --> 00:03:11,515
{\an8}‫تابعي الاستجواب‬
‫وحددي هوية كل المتنكرين‬

36
00:03:11,682 --> 00:03:14,893
{\an8}‫ومن ثم عودي إلى المكتب‬
‫وحاولي تعقب واضع الإعلان‬

37
00:03:15,018 --> 00:03:17,604
‫حسناً‬
‫أنت، تعال‬

38
00:03:21,984 --> 00:03:24,027
{\an8}‫- أين كنت؟‬
‫- سوق المزارعين‬

39
00:03:24,236 --> 00:03:26,446
{\an8}‫تفاح لذيذ‬
‫إن كنت تفضلين هذه الفاكهة‬

40
00:03:27,197 --> 00:03:28,574
‫هل ستحتجزين كل المهرجين؟‬

41
00:03:28,699 --> 00:03:30,117
‫إن كان القاتل هنا، أريد الإمساك به‬

42
00:03:30,450 --> 00:03:31,869
{\an8}‫فات الأوان، لقد هرب‬

43
00:03:32,315 --> 00:03:33,900
{\an8}‫هؤلاء هم ستار من الدخان فقط‬

44
00:03:34,079 --> 00:03:35,455
‫وإلا ما الهدف من وضع الإعلان؟‬

45
00:03:35,581 --> 00:03:37,833
‫ولكنه يوم جميل إن أردت هدر‬
‫وقتك في استجواب المهرجين‬

46
00:03:37,958 --> 00:03:41,920
{\an8}‫علينا فعل ذلك، ربما ارتكب المهرج‬
‫خطأ وألقي عليه القبض مع الجميع‬

47
00:03:42,171 --> 00:03:43,672
{\an8}‫عرفت مهرجاً في السابق‬

48
00:03:44,423 --> 00:03:46,884
{\an8}‫كان اسمه (كاتاستروفو)‬
‫كان رامي ورق لعب‬

49
00:03:47,426 --> 00:03:50,220
{\an8}‫كان باستطاعته إلصاق ورقة الأص‬
‫على حبة شمام من على بعد ١٥ متراً‬

50
00:03:50,372 --> 00:03:54,542
{\an8}‫- علينا التحدث إلى زوجة الضحية‬
‫- ١٥ متراً، رائع‬

51
00:03:56,643 --> 00:04:01,106
{\an8}‫"إن تم تعريف دالة الزيتا‬
‫لجميع الأعداد المركبة"‬

52
00:04:01,344 --> 00:04:03,692
‫"حيث إن (سين)‬
‫لا تساوي الرقم واحد"‬

53
00:04:03,859 --> 00:04:05,402
{\an8}‫- "يمكننا..."‬
‫- "توجه إلى جمهورك يا عزيزي"‬

54
00:04:05,527 --> 00:04:07,279
{\an8}‫"انظر إليّ، تحدث إليّ"‬

55
00:04:09,823 --> 00:04:11,700
{\an8}‫"أعلم بأنك تحاولين المساعدة‬
‫يا (داف)"‬

56
00:04:11,867 --> 00:04:14,328
{\an8}‫"أخبرني المزيد عن الزيتا‬
‫يمكنك فعل ذلك"‬

57
00:04:14,453 --> 00:04:17,080
{\an8}‫- "لست مؤهلاً لذلك"‬
‫- "أنت تقوم بعمل رائع"‬

58
00:04:17,414 --> 00:04:18,790
{\an8}‫"آسف"‬

59
00:04:20,626 --> 00:04:24,254
{\an8}‫صورنا هذا الشريط قبل عامين‬
‫من زواجنا بقليل‬

60
00:04:24,588 --> 00:04:26,757
‫أراد (نوا) الحصول‬
‫على وظيفة تعليم ثابتة‬

61
00:04:26,942 --> 00:04:29,277
{\an8}‫- كيف سار الأمر؟‬
‫- ليس جيداً‬

62
00:04:30,208 --> 00:04:31,929
{\an8}‫لديه مشكلة في مخاطبة الحشد‬

63
00:04:32,095 --> 00:04:35,682
{\an8}‫كان أخي عبقرياً في الرياضيات‬

64
00:04:35,891 --> 00:04:38,769
{\an8}‫أنهى الثانوية العامة‬
‫وهو في الـ١٥ من العمر‬

65
00:04:38,894 --> 00:04:42,940
{\an8}‫ونال شهادته الأولى في عامين‬

66
00:04:43,680 --> 00:04:45,182
‫ولكنه لم يجد التعامل مع الناس‬

67
00:04:45,638 --> 00:04:47,014
‫كان جيداً في التعامل معي‬

68
00:04:47,402 --> 00:04:52,741
‫(مسائل مختارة من المعادلات‬
‫التفاوتية في الترتيب الرابع)‬

69
00:04:53,033 --> 00:04:56,036
{\an8}‫- أظن أنه لـ(نوا)‬
‫- أجل‬

70
00:04:56,286 --> 00:04:58,830
{\an8}‫و(لوفز تاندر باشين)‬

71
00:04:59,081 --> 00:05:02,584
‫- أهو لك؟‬
‫- يمكنك أن تسخر‬

72
00:05:02,709 --> 00:05:05,003
‫- ما كنت لأجرؤ‬
‫- لا، لا بأس‬

73
00:05:05,462 --> 00:05:07,923
‫أتفهم‬
‫أعلم كيف يبدو الأمر‬

74
00:05:08,799 --> 00:05:10,175
‫لست عبقرية‬

75
00:05:10,592 --> 00:05:13,428
‫ولو التقيت به لظننت على الأرجح‬
‫بأن (نوا) هو سيد غريب الأطوار‬

76
00:05:13,804 --> 00:05:16,265
‫ماذا عساي أن أقول‬
‫لطالما أعجبت بالشبان الأذكياء‬

77
00:05:17,224 --> 00:05:19,017
‫اعتقدت صديقاتي أنني مجنونة‬

78
00:05:20,602 --> 00:05:23,981
‫ولكن عندما كان (نوا) ينفتح‬
‫كان يظهر روحاً جميلة‬

79
00:05:25,232 --> 00:05:27,651
‫كنت مناسبة له‬
‫ساعدته بالتعامل مع العالم‬

80
00:05:28,443 --> 00:05:29,861
‫ما الذي كان يفعله‬
‫لكسب رزقه؟‬

81
00:05:30,195 --> 00:05:34,324
‫قام بنشر بعض البحوث‬
‫في مجلات الرياضيات‬

82
00:05:35,242 --> 00:05:38,537
‫ومن الواضح‬
‫أنهم لا يدفعون الكثير‬

83
00:05:38,829 --> 00:05:40,205
‫كان سيبلي جيداً‬

84
00:05:41,081 --> 00:05:45,043
‫كان دائماً يكتشف...‬

85
00:05:45,377 --> 00:05:47,462
‫ما تسمونه أنتم بالأدلة‬

86
00:05:47,629 --> 00:05:49,423
‫كان يخترع بعض الأشياء‬

87
00:05:50,424 --> 00:05:52,426
‫كانت ستحقق أرباحاً‬
‫أنا واثقة من ذلك‬

88
00:05:53,218 --> 00:05:54,594
‫وإلى حين حدوث ذلك‬

89
00:05:55,762 --> 00:05:58,640
‫كنا نعيش من راتبي كنادلة‬

90
00:05:59,474 --> 00:06:03,478
‫وهذا الأمر كان يزعج (نوا)‬
‫بحيث قال إنه يود المساعدة أكثر‬

91
00:06:05,564 --> 00:06:08,233
‫بدأ بالتداول اليومي‬
‫قبل بضعة أشهر ولكن...‬

92
00:06:08,900 --> 00:06:11,153
‫- لا أظن أن الأمر سار جيداً‬
‫- لماذا؟‬

93
00:06:11,445 --> 00:06:13,739
‫لا أدري، رفض التحدث بالأمر‬

94
00:06:14,323 --> 00:06:16,074
‫(دافني)، لم يتحدث يوماً عن أي شيء‬

95
00:06:17,159 --> 00:06:18,994
‫إلى أين كان ذاهباً‬
‫هذا الصباح؟‬

96
00:06:19,411 --> 00:06:23,457
‫إلى مقهى في وسط البلدة‬
‫(أريالز)‬

97
00:06:24,458 --> 00:06:29,338
‫قضى معظم أيامه هناك مع حاسوبه‬
‫المحمول يعمل على التداول اليومي‬

98
00:06:29,546 --> 00:06:31,298
‫قال إنه أحب تردد الخلفية‬

99
00:06:31,631 --> 00:06:33,008
‫ما خطبك؟‬

100
00:06:33,342 --> 00:06:36,053
‫لا يمكنك الجلوس أو الوقوف بثبات‬
‫هل تشعر بالذنب؟‬

101
00:06:36,219 --> 00:06:37,804
‫لا، أنا...‬

102
00:06:40,182 --> 00:06:41,641
‫توفي أخي الصغير منذ قليل‬

103
00:06:43,018 --> 00:06:44,728
‫وكان يرتعب من المهرجين‬

104
00:06:44,978 --> 00:06:46,355
‫لذا من ارتكب الجريمة‬
‫هو شخص مريض نفسياً‬

105
00:06:46,480 --> 00:06:48,899
‫هل كنت تعلمين‬
‫عن خوف (نوا) من المهرجين؟‬

106
00:06:49,191 --> 00:06:51,401
‫أجل، كان لـ(نوا) بعض الميزات الغريبة‬

107
00:06:51,610 --> 00:06:55,572
‫بداعي التحقيق فقط، أين كنت‬
‫هذا الصباح الساعة ٧:٣٠؟‬

108
00:06:55,739 --> 00:06:58,950
‫كنت هنا ونائمة‬
‫عملت حتى ساعة متأخرة ليلة البارحة‬

109
00:06:59,117 --> 00:07:00,494
‫وأنت؟‬

110
00:07:01,328 --> 00:07:04,206
‫في سيارتي‬
‫وفي طريقي إلى العمل‬

111
00:07:04,498 --> 00:07:06,124
‫كان (نوا) يشارك‬
‫في جولة صعبة هنا‬

112
00:07:06,416 --> 00:07:08,627
‫هل كان يلعب مع أي منكما؟‬

113
00:07:09,252 --> 00:07:11,129
‫- لا‬
‫- مع من كان يلعب؟‬

114
00:07:11,463 --> 00:07:14,049
‫غالباً مع شخص واحد‬
‫(تولمان بانتينغ)‬

115
00:07:14,216 --> 00:07:16,718
‫(تولمان بانتينغ)، يدير متجراً‬
‫اسمه (ذا بازيل نوك)‬

116
00:07:16,843 --> 00:07:18,428
‫قريباً من (فاليكتس)‬

117
00:07:18,637 --> 00:07:20,847
‫يظهر سجل الهاتف مكالمات كثيرة‬
‫ما بين المتجر والمنزل‬

118
00:07:21,098 --> 00:07:23,600
‫سنذهب للتحدث معه‬
‫كيف تجري الأمور مع المهرجين؟‬

119
00:07:23,809 --> 00:07:25,685
‫"عثرت شرطة (كينمور)‬
‫على زي مهرج على جانب الطريق"‬

120
00:07:25,811 --> 00:07:28,814
‫"على بعد ٤ كيلومترات من موقع الجريمة‬
‫ولكن لا أثر لأي حمض نووي"‬

121
00:07:29,189 --> 00:07:33,026
‫حسناً، دعك من المهرجين الآن ولكن‬
‫أبق الملفات جاهزة في حال احتجت إليها‬

122
00:07:33,151 --> 00:07:34,528
‫حسناً أيتها الرئيسة، لك ذلك‬

123
00:07:38,073 --> 00:07:40,742
‫كان لـ(نوا) عقل مميز‬

124
00:07:41,410 --> 00:07:43,453
‫قبل بضع سنوات أصدرت‬
‫كتاباً يحوي عدداً من الأحجيات‬

125
00:07:43,578 --> 00:07:46,164
‫وبعد فترة قصيرة‬
‫أرسل لي (نوا) بريداً إلكترونياً‬

126
00:07:47,082 --> 00:07:48,834
‫كان قد حل كل الأحجيات طبعاً‬

127
00:07:48,959 --> 00:07:51,795
‫ولكن وجد بعض الأخطاء المنطقية‬
‫في أحجيتين‬

128
00:07:52,045 --> 00:07:57,467
‫عندئذ أدركت بضرورة ضم‬
‫شخص بمقدرته الثقافية إلى دائرتي‬

129
00:07:58,427 --> 00:08:00,554
‫مباشرة بعد ذلك‬
‫بدأنا نلعب الشطرنج‬

130
00:08:00,720 --> 00:08:02,097
‫كم مرة كنت تراه؟‬

131
00:08:03,056 --> 00:08:08,019
‫مرة في الشهر ولكن كنا نلعب‬
‫عبر الإنترنت أو الهاتف‬

132
00:08:09,604 --> 00:08:13,191
‫أظن أنك ستحب هذه‬
‫إنها صعبة بعض الشيء‬

133
00:08:13,608 --> 00:08:17,863
‫تدخل هذه بهذه‬
‫وهذه تدخل هناك‬

134
00:08:18,071 --> 00:08:19,448
‫ومن ثم هكذا‬

135
00:08:21,241 --> 00:08:22,617
‫هل هذا صحيح؟‬

136
00:08:23,702 --> 00:08:25,704
‫جيد جداً، أجل!‬

137
00:08:27,247 --> 00:08:28,623
‫كان الأمر ممتعاً‬

138
00:08:29,124 --> 00:08:34,254
‫هل تعرف شخصاً كان غاضباً‬
‫من (نوا) أو يكنّ له ضغينة؟‬

139
00:08:34,379 --> 00:08:36,465
‫لا، على الإطلاق‬
‫ولكن كما ترين‬

140
00:08:36,882 --> 00:08:39,384
‫كان (نوا) غير مدرك‬
‫لمشاعر الناس‬

141
00:08:39,509 --> 00:08:41,720
‫وأحياناً كانوا يعتبرون سلوكه‬
‫نوعاً من الفظاظة‬

142
00:08:42,429 --> 00:08:45,724
‫ولكن بصراحة‬
‫إنه ألطف شخص يمكن تخيله‬

143
00:08:45,891 --> 00:08:49,311
‫لا يمكنني تصور‬
‫أي شخص قد يرغب في قتل (نوا)‬

144
00:08:49,769 --> 00:08:51,146
‫هل كنت تعلم بأنه‬
‫يعاني من الكولروفوبيا؟‬

145
00:08:51,271 --> 00:08:53,940
‫- أي أنه كان يخاف...‬
‫- يخاف من المهرجين‬

146
00:08:54,524 --> 00:08:55,901
‫لا، أبداً‬

147
00:08:56,067 --> 00:08:57,819
‫- هل أنت واثق؟‬
‫- جداً‬

148
00:08:57,944 --> 00:08:59,696
‫أين كنت هذا الصباح‬
‫عند الساعة الـ٧:٣٠؟‬

149
00:09:00,030 --> 00:09:01,406
‫خرجت لممارسة الجري‬

150
00:09:03,492 --> 00:09:05,076
‫أهذه هي الجولة‬
‫التي كنت تلعبها مع (نوا)؟‬

151
00:09:05,577 --> 00:09:07,287
‫في الواقع، أجل‬

152
00:09:09,748 --> 00:09:11,875
‫- أظن بأنه كان سيتغلب عليك‬
‫- هل تلعب؟‬

153
00:09:12,209 --> 00:09:15,504
‫- قليلاً‬
‫- علينا اللعب أحياناً‬

154
00:09:15,795 --> 00:09:19,508
‫حسناً، سأبدأ بتحريك‬
‫البيدق إلى المربع (سي ٤)‬

155
00:09:22,135 --> 00:09:24,429
‫- البيدق إلى المربع (إي ٦)‬
‫- الحصان إلى (أف ٣)‬

156
00:09:24,596 --> 00:09:25,972
‫البيدق إلى المربع (دي ٥)‬

157
00:09:26,097 --> 00:09:27,474
‫تتجنب المناورة، هذا مثير للاهتمام‬

158
00:09:27,974 --> 00:09:29,768
‫البيدق إلى المربع (دي ٤)‬

159
00:09:30,018 --> 00:09:31,978
‫- حقاً؟‬
‫- شرف الكشافة‬

160
00:09:32,312 --> 00:09:33,980
‫هل يمكننا العودة‬
‫إلى المقابلة من فضلك؟‬

161
00:09:34,147 --> 00:09:37,400
‫طبعاً، أقدم اعتذاري‬
‫ستندم على تلك الحركة الافتتاحية‬

162
00:09:37,609 --> 00:09:39,736
‫- سنرى‬
‫- هل لاحظت شيئاً غير اعتيادي‬

163
00:09:39,903 --> 00:09:43,240
‫- في سلوك (نوا) مؤخراً؟‬
‫- لا، ولكن كان ثمة أمر واحد‬

164
00:09:44,199 --> 00:09:47,827
‫عندما بدأنا هذه الجولة‬

165
00:09:48,995 --> 00:09:51,122
‫كان (نوا) مصمماً على المراهنة‬

166
00:09:51,748 --> 00:09:54,125
‫- وهو أمر لم يسبق أن فعله من قبل‬
‫- هل قبلت الرهان؟‬

167
00:09:54,292 --> 00:09:56,086
‫لا، أحب مالي كثيراً‬

168
00:09:56,503 --> 00:09:58,505
‫- أواثق بأنك ستلتزم بهذه الحركة؟‬
‫- لم لا؟‬

169
00:09:59,923 --> 00:10:01,633
‫الحصان إلى المربع (أف ٦)‬

170
00:10:01,841 --> 00:10:06,304
‫- الحصان إلى المربع (سي ٣)‬
‫- الفيل إلى المربع (إي ٧)‬

171
00:10:07,556 --> 00:10:09,558
‫- إنها جنازتك‬
‫- شكراً على منحنا وقتك‬

172
00:10:10,183 --> 00:10:12,852
‫- شكراً لك‬
‫- شكراً على زيارتكما‬

173
00:10:13,019 --> 00:10:16,273
‫بالمناسبة ، الفيل إلى المربع (جي ٥)‬

174
00:10:17,190 --> 00:10:18,567
‫انتبه إلى ملكتك‬

175
00:10:22,153 --> 00:10:25,031
‫مرحباً، وصلتك رسالة‬
‫من شخص يدعى (تولمان)‬

176
00:10:26,116 --> 00:10:27,492
‫"حركة استبدال القلعة والملك"‬

177
00:10:30,954 --> 00:10:33,331
‫ها هو يتجه إلى هلاكه‬

178
00:10:33,623 --> 00:10:35,542
‫الشطرنج هي لعبة الملوك‬

179
00:10:35,667 --> 00:10:37,043
‫ملوك يملكون الكثير من وقت الفراغ‬

180
00:10:37,544 --> 00:10:39,254
‫- "حضرة الرئيسة؟"‬
‫- ما الأمر؟‬

181
00:10:39,462 --> 00:10:42,924
‫قالت زوجة (نوا فاليكيت) إنه كان يجني‬
‫المال من المداولة اليومية، صحيح؟‬

182
00:10:43,049 --> 00:10:44,426
‫هذا صحيح‬

183
00:10:44,551 --> 00:10:47,387
‫لديهما مبلغ صغير في المصرف‬
‫ولكن تحققت من موقعه للتجارة‬

184
00:10:47,512 --> 00:10:48,888
‫لم يقم بعملية تداول واحدة‬

185
00:10:49,139 --> 00:10:51,766
‫تحققت من وضعه الاجتماعي‬
‫وتبين أنه لم يملك سهماً واحداً‬

186
00:10:51,975 --> 00:10:53,977
‫- ما الذي كان يفعله إذاً؟‬
‫- لا أعرف‬

187
00:10:54,144 --> 00:10:57,647
‫هناك ملفات كثيرة‬
‫تحوي رسائل وأرقاماً عشوائية‬

188
00:10:57,981 --> 00:11:00,317
‫يرسلها كل أسبوع بالبريد‬
‫الإلكتروني إلى العنوان نفسه‬

189
00:11:00,609 --> 00:11:02,193
‫(بيستسلاير ٩٤٩)‬

190
00:11:02,360 --> 00:11:03,737
‫اتصلي بمزود خدمة الإنترنت لـ(نوا)‬

191
00:11:03,862 --> 00:11:05,614
‫أجبريهم على كشف هوية‬
‫(بيستسلاير)‬

192
00:11:06,323 --> 00:11:08,992
‫حضرة الرئيسة؟ (دافني فاليكيت)‬
‫على الخط الثاني وتبدو مذعورة‬

193
00:11:11,995 --> 00:11:13,413
‫- (دافني)‬
‫- "عليكم المجيء"‬

194
00:11:13,538 --> 00:11:14,914
‫"ثمة شخص في منزلي"‬

195
00:11:15,790 --> 00:11:18,543
‫اتصلت عندما رأيت الباب‬

196
00:11:18,752 --> 00:11:21,421
‫- لا بأس، اهدئي‬
‫- تغيبت لأقل من ساعة‬

197
00:11:21,546 --> 00:11:23,840
‫كان علي الاتصال بالشرطة‬
‫أعلم، لم أكن أفكر‬

198
00:11:24,007 --> 00:11:26,259
‫- كم مدخلاً إلى المنزل مع الأمامي؟‬
‫- الباب الخلفي فقط‬

199
00:11:26,384 --> 00:11:27,761
‫- سأتولى الأمر‬
‫- وأنتما توليا المدخل الأمامي‬

200
00:11:31,139 --> 00:11:32,515
‫هناك من خلع الباب‬

201
00:11:43,318 --> 00:11:44,694
‫المطبخ آمن‬

202
00:11:46,655 --> 00:11:48,907
‫- الحمام آمن‬
‫- غرفة المعيشة خالية‬

203
00:11:50,742 --> 00:11:52,118
‫غرفة النوم آمنة‬

204
00:11:53,078 --> 00:11:54,454
‫يا رفاق، عليكم رؤية هذا‬

205
00:11:58,041 --> 00:11:59,417
‫"خزنة (إلايد سايف)"‬

206
00:12:03,713 --> 00:12:05,715
‫أراد أحدهم شيئاً بشدة‬

207
00:12:06,007 --> 00:12:07,926
‫- خزنة تحت الأرض‬
‫- أسلوب تقليدي جداً‬

208
00:12:10,011 --> 00:12:12,722
‫إنه قفل استشعار متطور‬
‫سيكون من الصعب فتحه‬

209
00:12:12,847 --> 00:12:15,058
‫سأتصل بالخدمات التقنية‬
‫لأعلمهم بحاجتنا إلى صانع أقفال‬

210
00:12:15,266 --> 00:12:16,643
‫لا تزعج نفسك‬

211
00:12:18,436 --> 00:12:19,813
‫وجدت المفتاح‬

212
00:12:20,438 --> 00:12:22,065
‫لا، هذا النوع من الخزنات‬
‫لا يعمل بالمفتاح‬

213
00:12:22,399 --> 00:12:23,775
‫بل يعمل‬

214
00:12:30,865 --> 00:12:32,242
‫ضعيه في كيس الأدلة‬

215
00:12:54,436 --> 00:12:58,524
‫هل تقولين إن أحداً قتل زوجي‬
‫وقطع إصبعه ليتمكن من فتح خزنة؟‬

216
00:12:58,774 --> 00:13:01,151
‫أجل وهذا كل ما وجدناه فيها‬

217
00:13:01,276 --> 00:13:04,863
‫لوح شطرنج ومجلة هزلية وبضع أوراق‬
‫هل سبق أن رأيتها من قبل؟‬

218
00:13:05,489 --> 00:13:07,741
‫- لا‬
‫- ألم يذكر (نوا) الخزنة أمامك؟‬

219
00:13:07,908 --> 00:13:11,829
‫لا، أبداً‬
‫هذا كان منزله قبل أن نتزوج‬

220
00:13:12,329 --> 00:13:14,164
‫قمت بنقل أغراضي فقط‬

221
00:13:15,165 --> 00:13:18,168
‫من الواضح أن (نوا)‬
‫لم يكن يحبذ تقديم المعلومات‬

222
00:13:18,377 --> 00:13:21,130
‫نظن بأن القاتل ما كان يبحث‬
‫عنه، لم يكن موجوداً في الخزنة‬

223
00:13:21,296 --> 00:13:22,840
‫لهذا السبب خرب بقية المنزل‬

224
00:13:23,716 --> 00:13:25,426
‫- هلا عذرتني؟‬
‫- أجل‬

225
00:13:26,510 --> 00:13:27,886
‫(ليزبن)‬

226
00:13:59,752 --> 00:14:01,128
‫"(جاين)"‬

227
00:14:04,882 --> 00:14:06,925
‫اتصل (تشو) بمزود خدمة (فاليكيت)‬

228
00:14:07,092 --> 00:14:10,804
‫(بيستسلاير ٩٤٩) هو (أليك موسكا)‬
‫ويعيش على بعد ٢٤ كيلومتراً‬

229
00:14:11,013 --> 00:14:12,389
‫(تشو) و(ريغسبي) في الطريق إليه الآن‬

230
00:14:12,514 --> 00:14:13,891
‫ممتاز‬

231
00:14:14,349 --> 00:14:16,101
‫هل كان لدى (نوا) مخابئ أخرى؟‬

232
00:14:17,144 --> 00:14:19,021
‫ربما، أجل، طبعاً، لا أدري‬

233
00:14:19,688 --> 00:14:21,774
‫أشعر بأنني لم أعد أعرف شيئاً‬

234
00:14:22,524 --> 00:14:25,944
‫ما هو عدد الأسرار التي احتفظ بها؟‬
‫لماذا احتفظ بهذه الخردة في الخزنة؟‬

235
00:14:26,111 --> 00:14:29,448
‫ليست كلها خردة‬
‫هذه مجلة (سبايدرمان) عدد ٤٦‬

236
00:14:29,573 --> 00:14:32,659
‫في هذا العدد ، يقضي على الصاعق‬
‫إنه رائع‬

237
00:14:32,993 --> 00:14:34,369
‫وسعره مرتفع‬

238
00:14:35,662 --> 00:14:37,080
‫ولكن ما وجدته مثيراً للاهتمام‬

239
00:14:38,290 --> 00:14:43,545
‫بأن لوح الشطرنج الذي وضعه‬
‫زوجك على الطاولة باهظ الثمن‬

240
00:14:43,670 --> 00:14:48,342
‫فيما هذا مصنوع في (الصين)‬
‫وليس باهظ الثمن‬

241
00:14:49,343 --> 00:14:53,931
‫ما يدفعنا إلى التساؤل عن سبب‬
‫إخفاء اللوح الرخيص بعناية فائقة‬

242
00:14:54,348 --> 00:14:55,724
‫إلا...‬

243
00:15:01,563 --> 00:15:02,940
‫إن كان شيء في داخله‬

244
00:15:07,653 --> 00:15:10,072
‫مفتاح خزانة رقم ٤٢‬

245
00:15:10,322 --> 00:15:11,698
‫أين مكانها يا ترى؟‬

246
00:15:16,620 --> 00:15:17,996
‫- أهذه هي الشقة؟‬
‫- نعم‬

247
00:15:22,292 --> 00:15:24,002
‫- نعم؟‬
‫- (أليك موسكا)؟‬

248
00:15:25,462 --> 00:15:26,839
‫لماذا؟ من أنتما؟‬

249
00:15:26,964 --> 00:15:28,423
‫العميلان (تشو) و(ريغسبي)‬
‫من مكتب (كاليفورنيا) للتحقيقات‬

250
00:15:28,674 --> 00:15:30,050
‫- افتح الباب من فضلك‬
‫- من؟‬

251
00:15:30,175 --> 00:15:31,552
‫مكتب (كاليفورنيا) للتحقيقات يا سيدي‬
‫دعنا ندخل‬

252
00:15:31,885 --> 00:15:34,596
‫طبعاً، مكتب (كاليفورنيا) للتحقيقات‬
‫ما من مشكلة‬

253
00:15:34,763 --> 00:15:38,433
‫اسمعا، أنا في ملابسي الداخلية‬
‫امنحاني بعض الوقت لأرتدي ملابسي‬

254
00:15:40,227 --> 00:15:42,020
‫هل سيرتدي سرواله‬
‫قبل بلوغ النافذة؟‬

255
00:15:42,271 --> 00:15:43,647
‫لا، لا أظن ذلك‬

256
00:15:44,398 --> 00:15:45,774
‫سيد (موسكا)‬

257
00:15:51,238 --> 00:15:53,657
‫- دعني أر يديك! دعني أر يديك!‬
‫- ابتعد عن النافذة‬

258
00:15:53,782 --> 00:15:56,410
‫حسناً، لا بأس، ما من مشكلة‬
‫أتريان هذه؟‬

259
00:15:56,577 --> 00:15:58,537
‫هناك مبلغ ١٤ ألف دولار‬
‫في داخلها، خذاه إلى (مايك)‬

260
00:15:58,662 --> 00:16:01,707
‫أعلماه بأنني سأسدد الباقي‬
‫أقسم لكم بقبر شقيقة زوجتي‬

261
00:16:01,999 --> 00:16:03,375
‫عم تتحدث؟‬

262
00:16:03,584 --> 00:16:06,503
‫أرسلكما (مايك)، أليس كذلك؟‬
‫لقبض رهان (بوسطن) و(فيلادلفيا)؟‬

263
00:16:08,839 --> 00:16:10,215
‫تباً‬

264
00:16:11,091 --> 00:16:13,468
‫واجه الحائط وضع يديك فوق رأسك‬

265
00:16:17,180 --> 00:16:20,601
‫- من أنتما؟‬
‫- أتذكر الشارة؟ (سي بي أي)‬

266
00:16:20,809 --> 00:16:22,728
‫- ما هذا؟‬
‫- مكتب (كاليفورنيا) للتحقيقات‬

267
00:16:22,853 --> 00:16:24,229
‫وماذا يكون هذا؟‬

268
00:16:24,354 --> 00:16:26,189
‫مثل مكتب التحقيقات الفدرالي‬
‫ولكن موقعنا أقرب‬

269
00:16:32,154 --> 00:16:33,530
‫شكراً‬

270
00:16:33,655 --> 00:16:38,201
‫دعني أخبرك عن مدى أسفي‬
‫على سوء الفهم الذي حصل عند بابي‬

271
00:16:38,493 --> 00:16:39,953
‫لم أكن أعلم بأنكما شرطيان‬

272
00:16:40,120 --> 00:16:42,039
‫أريناك شارتنا وعرفنا عن نفسينا‬

273
00:16:42,664 --> 00:16:44,625
‫ألا تشاهد الأفلام؟‬
‫إنه أسلوب الأشرار‬

274
00:16:44,791 --> 00:16:46,168
‫لا، هذا ليس صحيحاً، اجلس‬

275
00:16:52,549 --> 00:16:53,926
‫كيف تعرف (نوا فاليكيت)؟‬

276
00:16:54,468 --> 00:16:56,678
‫من المقهى‬
‫(نوا) يحب قهوة (فيينا روست)‬

277
00:16:56,803 --> 00:16:58,597
‫وأنا أفضل مزيج (سومطرة)‬

278
00:16:59,473 --> 00:17:02,017
‫هل كان يرسل إليك‬
‫طلبات القهوة في البريد الإلكتروني؟‬

279
00:17:04,770 --> 00:17:06,855
‫عليك البوح بالحقيقة يا سيد (موسكا)‬
‫إنه أمر يسهل تذكره‬

280
00:17:08,565 --> 00:17:12,194
‫إليك ما يجري‬
‫أقوم بالرهانات من وقت لآخر‬

281
00:17:12,319 --> 00:17:13,779
‫هل تقصد بأنك مقامر منحط؟‬

282
00:17:14,071 --> 00:17:15,447
‫أجل، حسناً‬

283
00:17:15,739 --> 00:17:18,367
‫قبل شهرين‬
‫كنت في المقهى أراجع خياراتي‬

284
00:17:18,492 --> 00:17:21,495
‫عندما سألني (نوا) عما أفعله‬
‫حسناً وباختصار‬

285
00:17:21,703 --> 00:17:24,790
‫قال إنه يستطيع إعطائي‬
‫تحليلاً منطقياً للاحتمالات‬

286
00:17:24,915 --> 00:17:28,835
‫أشركته في بعض الألعاب‬
‫وقد نجحت كلها‬

287
00:17:29,211 --> 00:17:30,837
‫أحببت الأمر فعقدنا صفقة‬

288
00:17:31,129 --> 00:17:33,465
‫يعطني الخيار الرابح‬
‫مقابل ١٠ بالمئة من الأرباح‬

289
00:17:33,590 --> 00:17:36,551
‫- هذه لا تبدو خيارات رهان‬
‫- قال (نوا) إنه سيرسلها مشفرة‬

290
00:17:36,969 --> 00:17:38,595
‫لا تسلني، هذه هي طبيعته‬

291
00:17:40,430 --> 00:17:41,807
‫متى فشل الاتفاق؟‬

292
00:17:41,974 --> 00:17:43,350
‫- من قال ذلك؟‬
‫- أنت‬

293
00:17:43,558 --> 00:17:45,185
‫أنت متوتر منذ أن ذكرت اسمه‬

294
00:17:45,519 --> 00:17:49,189
‫قبل ٣ أسابيع‬
‫فشلت كل اختيارات (نوا)‬

295
00:17:49,731 --> 00:17:52,651
‫كان في حالة يرثى لها‬
‫سألته عما يجري‬

296
00:17:53,026 --> 00:17:55,362
‫فأجابني بأنه يواجه مشكلة‬
‫ويعجز عن التركيز‬

297
00:17:55,529 --> 00:17:57,364
‫- حتما أغضبك هذا‬
‫- حقاً؟‬

298
00:17:57,698 --> 00:18:00,075
‫هو يواجه مشكلة‬
‫وأنا أخسر المال‬

299
00:18:00,784 --> 00:18:04,621
‫ولكن إن سمعت عن حوار غاضب‬

300
00:18:04,997 --> 00:18:06,873
‫لا علاقة له بما حصل‬

301
00:18:07,040 --> 00:18:08,417
‫لم ألمس الرجل يوماً‬

302
00:18:09,167 --> 00:18:12,212
‫تم القبض على (موسكا) مرتين بتهمة‬
‫الاعتداء، ربما حاول ضرب (نوا)‬

303
00:18:12,379 --> 00:18:14,631
‫ربما في عراك في المقهى‬
‫ولكن ليس مرتدياً زي مهرج‬

304
00:18:15,215 --> 00:18:19,011
‫السؤال المطروح هو‬
‫لماذا فشلت اختيارات (نوا)؟‬

305
00:18:19,177 --> 00:18:22,014
‫- يمكن لأي شخص أن يخطئ‬
‫- ولكن (نوا) لم يكن أي شخص‬

306
00:18:22,139 --> 00:18:25,475
‫أعني، قد يخسر مرة أو مرتين‬
‫ولكن لفترة ثلاثة أسابيع؟‬

307
00:18:25,600 --> 00:18:27,811
‫حسب أقوال (موسكا)‬
‫كان لديه مشكلة ولم يكن يركز‬

308
00:18:28,020 --> 00:18:31,148
‫- ربما مشاكل في المنزل‬
‫- ليست مشاكل قد يهتم لأمرها‬

309
00:18:31,314 --> 00:18:34,276
‫- حتماً الأمر يتعلق بتحد فكري‬
‫- أوافقك في الرأي‬

310
00:18:34,651 --> 00:18:38,572
‫ولكن من بمقدوره تقديم‬
‫هذا النوع من التحدي الفكري أو الأحجية؟‬

311
00:18:40,699 --> 00:18:44,661
‫سيد (جاين)‬
‫هل جئت للانسحاب من اللعبة؟‬

312
00:18:45,037 --> 00:18:46,413
‫أبداً‬

313
00:18:47,706 --> 00:18:49,374
‫الفيل يقضي على المربع (إي ٧)‬

314
00:18:50,876 --> 00:18:52,252
‫مثير للاهتمام‬

315
00:18:52,377 --> 00:18:54,504
‫ما هي المسألة التي كان (نوا)‬
‫يعمل عليها من أجلك؟‬

316
00:18:54,629 --> 00:18:57,466
‫لا أعرف عم تتحدثين‬
‫أنا و(نوا) لعبنا الشطرنج‬

317
00:18:57,591 --> 00:19:00,594
‫- كاذب‬
‫- لست كاذباً‬

318
00:19:00,719 --> 00:19:02,679
‫ما الذي يجعلك تظن بأنني لا‬
‫أستطيع معرفة متى يكذب المرء؟‬

319
00:19:02,804 --> 00:19:05,557
‫- (جاين)؟‬
‫- كفى يا سيد (تولمان)‬

320
00:19:05,682 --> 00:19:07,559
‫ابدأ بقول الحقيقة‬
‫وإلا أطلقت عليك النار‬

321
00:19:07,976 --> 00:19:10,979
‫- لا تفكر في الأمر حتى‬
‫- أخفضي المسدس من يدك، الآن‬

322
00:19:12,814 --> 00:19:16,485
‫إنها يدي فقط‬
‫لا يوجد فيها شيء‬

323
00:19:16,902 --> 00:19:18,695
‫إنها مجرد يد، نحن بخير‬

324
00:19:18,987 --> 00:19:21,156
‫(آنيكا)، اخفضي سلاحك‬

325
00:19:23,909 --> 00:19:25,994
‫لماذا لديك حارسة شخصية مسلحة‬
‫يا سيد (بانتينغ)؟‬

326
00:19:27,621 --> 00:19:29,915
‫لم لا ندخل إلى مكتبي؟‬

327
00:19:30,665 --> 00:19:32,042
‫حسناً؟‬

328
00:19:36,171 --> 00:19:38,590
‫- رائع‬
‫- هل تدرك مدى أهمية‬

329
00:19:39,257 --> 00:19:41,301
‫الأحجيات والشفرات‬
‫بالنسبة إليكما أيها العميلان؟‬

330
00:19:41,676 --> 00:19:45,222
‫إنها تحمي بريدكما الإلكتروني‬
‫وتوقف سرقة بطاقات الائتمان‬

331
00:19:45,472 --> 00:19:49,017
‫تطوير الأحجيات وحلها هي‬
‫قضية أمنية بارزة في أيامنا هذه‬

332
00:19:49,142 --> 00:19:52,646
‫وأنا أدير شركة استشارية‬
‫تتعامل مع هذه المسائل تحديداً‬

333
00:19:54,106 --> 00:19:56,108
‫- لصالح من تعمل؟‬
‫- لسنا منحازين‬

334
00:19:56,483 --> 00:19:58,443
‫- لكل من يحتاج إلينا‬
‫- ما الذي كان يفعله (نوا) لك؟‬

335
00:19:58,777 --> 00:20:00,153
‫هذا سر‬

336
00:20:00,946 --> 00:20:03,782
‫سيد (بانتينغ)‬
‫إما أن تتعاون معنا بشكل كامل‬

337
00:20:03,949 --> 00:20:07,994
‫وإما أدخلت دائرة الحاسوب الجنائي‬
‫إلى مكتبك في غضون ساعة‬

338
00:20:10,163 --> 00:20:14,251
‫كنت أعد (نوا) لمشروع صغير وخاص‬

339
00:20:15,836 --> 00:20:17,212
‫من أجل ماذا؟‬

340
00:20:19,214 --> 00:20:23,385
‫جهاز بمقدوره فك رموز‬
‫أي معلومة مشفرة‬

341
00:20:23,635 --> 00:20:25,011
‫الاختراق العالمي‬

342
00:20:25,137 --> 00:20:26,721
‫إنها طريقة فظة لوصف الأمر‬

343
00:20:27,848 --> 00:20:31,184
‫عثرت على ٣ أشخاص بمقدورهم‬
‫إنجاز الأمر و(نوا) كان واحداً منهم‬

344
00:20:31,351 --> 00:20:33,812
‫عرضت على كل واحد منهم‬
‫مبلغ مليوني دولار‬

345
00:20:35,272 --> 00:20:38,900
‫في الأسبوع الماضي، اتصل بي‬
‫(نوا) وأعلمني بأنه طور الجهاز‬

346
00:20:40,110 --> 00:20:42,988
‫- وأنه لم يكن ينوي إعطائي إياه‬
‫- لماذا؟‬

347
00:20:43,405 --> 00:20:44,990
‫أخبرني بأنه متردد بعض الشيء‬

348
00:20:45,657 --> 00:20:48,034
‫كان يخشى وقوع الجهاز بالأيدي الخطأ‬

349
00:20:48,160 --> 00:20:51,580
‫- ألا يزعجك الأمر؟‬
‫- أنا رجل أعمال ولست فاضلاً‬

350
00:20:52,706 --> 00:20:56,084
‫- من المنزعج أن يتخلى عنك (نوا)‬
‫- ليس فعلاً‬

351
00:20:57,711 --> 00:21:00,672
‫كما ترى، ارتأيت أن (نوا)‬
‫لم يطور الجهاز فعلياً‬

352
00:21:01,173 --> 00:21:03,717
‫لم ينجح في ذلك‬
‫وكان محرجاً من فشله‬

353
00:21:03,842 --> 00:21:06,845
‫ماذا لو صنع الجهاز فعلاً؟‬
‫ماذا كنت لتفعل لتحصل عليه؟‬

354
00:21:07,179 --> 00:21:10,348
‫أي شيء، باستثناء قتله طبعاً‬

355
00:21:11,349 --> 00:21:14,019
‫وجدت مفتاح خزانة في منزل (نوا)‬
‫وقد أحسن تخبئته‬

356
00:21:14,144 --> 00:21:15,520
‫خزانة رقمها ٤٢‬

357
00:21:15,770 --> 00:21:18,565
‫- مثير للاهتمام، هل تعرفان مكانها؟‬
‫- ما زلنا نبحث‬

358
00:21:18,857 --> 00:21:24,070
‫إن وجدتماه، عليكما إعلامي‬
‫لأن ذلك الجهاز هو ملكي‬

359
00:21:24,446 --> 00:21:26,781
‫ليس بعد‬
‫لم تدفع ثمنه‬

360
00:21:27,073 --> 00:21:29,242
‫لدي مجموعة محامين يتولون الأمر‬

361
00:21:30,076 --> 00:21:32,662
‫سيد (جاين) ، قبل أن أنسى‬

362
00:21:33,163 --> 00:21:34,664
‫الملكة إلى المربع (إي ٧)‬

363
00:21:35,415 --> 00:21:36,791
‫تقضي على فيلك‬

364
00:21:38,293 --> 00:21:41,254
‫علينا التحدث إلى الأشخاص‬
‫الآخرين الذين يعملون على المشروع نفسه‬

365
00:21:41,546 --> 00:21:45,884
‫حسناً، ما من مشكلة، هناك (أليكس كروم)‬
‫الذي يعيش في (أمستردام) وهناك...‬

366
00:21:46,218 --> 00:21:49,262
‫الشخص الثالث محلي‬
‫(أوليفر ماكدانيال)‬

367
00:21:50,384 --> 00:21:53,220
‫- ولكن أشك في أنه قتل (نوا)‬
‫- لماذا؟‬

368
00:21:54,643 --> 00:21:57,646
{\an8}‫"مصح (كلارك) للأمراض العقلية"‬

369
00:22:04,027 --> 00:22:05,403
‫الغرفة ٤١‬

370
00:22:09,366 --> 00:22:10,742
‫تفضلا‬

371
00:22:14,162 --> 00:22:16,331
‫نفتح الباب، حسناً هنا‬

372
00:22:23,004 --> 00:22:25,048
‫(أوليفر سايمون ماكدانيال)‬

373
00:22:25,382 --> 00:22:28,635
‫يذكر سجلك بأنك أنهيت‬
‫الكلية في الـ١٦ من العمر‬

374
00:22:28,802 --> 00:22:30,387
‫وتخرجت من الجامعة‬
‫في سن الـ١٩‬

375
00:22:30,512 --> 00:22:34,057
‫أرسلت إلى هنا لأنك حاولت‬
‫خنق والدك حتى الموت‬

376
00:22:34,516 --> 00:22:35,892
‫إنه ليس والدي‬

377
00:22:36,351 --> 00:22:38,937
‫إنه مستنسخ إلكتروني تم إرساله‬
‫من قبل أسياد المجرة الكمية‬

378
00:22:39,062 --> 00:22:42,565
‫أجل، إنهم دائما يخططون لأمر مريب‬

379
00:22:43,191 --> 00:22:45,652
‫أجل، يريدون دفعي إلى الجنون‬

380
00:22:46,653 --> 00:22:48,029
‫ولكنهم لن ينجحوا‬

381
00:22:49,406 --> 00:22:51,616
‫- هل سمعت بأمر (نوا)؟‬
‫- أجل‬

382
00:22:52,158 --> 00:22:54,452
‫أمر مؤسف‬
‫هل تجيدين التدليك بأسلوب (سياتشو)؟‬

383
00:22:54,703 --> 00:22:56,079
‫لا‬

384
00:22:56,329 --> 00:23:02,460
‫هذا مؤسف، أشعر بتوتر شديد‬
‫وبشرتي جافة ومتقشرة‬

385
00:23:03,795 --> 00:23:06,965
‫يذكر السجل بأن (نوا)‬
‫كان الوحيد الذي أتى إلى زيارتك‬

386
00:23:07,090 --> 00:23:09,718
‫- كيف تعرفت عليه؟‬
‫- من الدراسات العليا‬

387
00:23:09,968 --> 00:23:11,344
‫شعرت بالأسى عليه‬

388
00:23:11,720 --> 00:23:14,723
‫كان غريب الأطوار‬
‫وأظن بأن الإشعاعات هي السبب‬

389
00:23:15,348 --> 00:23:16,725
‫كيف مات؟‬

390
00:23:17,142 --> 00:23:20,895
‫بطلق ناري، ما يؤكد بأن الفاعل‬
‫ليسوا حكام الكمية‬

391
00:23:21,271 --> 00:23:23,773
‫كانوا ليستخدموا شعاعاً قاتلاً‬

392
00:23:24,899 --> 00:23:27,068
‫لماذا قد يرغبون في قتل‬
‫(نوا) بأي حال؟ كان جباناً‬

393
00:23:27,319 --> 00:23:31,197
‫تماماً، ارتدى قاتله زي مهرج‬
‫هل تعرف من قد يكون؟‬

394
00:23:32,198 --> 00:23:35,160
‫مع الافتراض بأنه في شكل من أشكال‬
‫الحياة المبنية على الكربون‬

395
00:23:35,618 --> 00:23:37,912
‫لا، ولكن فكرة المهرج ذكية‬

396
00:23:38,663 --> 00:23:40,040
‫كان (نوا) يكرههم‬

397
00:23:40,498 --> 00:23:43,835
‫علمنا بأنك تعمل‬
‫على مسألة لدى (تولمان بانتينغ)؟‬

398
00:23:44,878 --> 00:23:47,589
‫أجل، عارض الأطباء الأمر‬
‫ولكنني أقنعتهم بأنه علاج نافع‬

399
00:23:47,714 --> 00:23:49,090
‫لا تلمس ذلك!‬

400
00:23:55,597 --> 00:23:58,558
{\an8}‫هل كنت تعلم بأن (نوا)‬
‫كان يعمل على مشروع له أيضاً؟‬

401
00:23:59,439 --> 00:24:01,691
‫وهذا يجعل منه منافقاً‬

402
00:24:03,772 --> 00:24:05,148
‫لماذا؟‬

403
00:24:05,398 --> 00:24:07,359
‫في كلية الدراسات العليا‬
‫عُرض علينا كتابة شفرة‬

404
00:24:07,484 --> 00:24:10,278
‫لبعض المقاولين في مجال الدفاع‬
‫رفض (نوا)‬

405
00:24:10,695 --> 00:24:12,781
‫قال إنه لا يريد فعل شيء‬
‫قد يؤذي الآخرين‬

406
00:24:12,989 --> 00:24:16,284
‫وكأن مشروع (تولمان) أفضل‬
‫إنه أسوأ‬

407
00:24:17,035 --> 00:24:19,871
‫يمكنك تدمير العالم عملياً‬
‫إن أردت‬

408
00:24:21,998 --> 00:24:24,667
‫أنجز (نوا) هذا المشروع‬

409
00:24:25,210 --> 00:24:27,712
‫- كيف وضع المشروع معك؟‬
‫- بخير‬

410
00:24:28,755 --> 00:24:30,131
‫لم تقترب من النهاية حتى‬

411
00:24:32,759 --> 00:24:34,677
‫يمكنني اقتلاع عينيك بواسطة الملعقة‬

412
00:24:34,969 --> 00:24:36,346
‫لنؤجل هذا لوقت آخر‬

413
00:24:36,471 --> 00:24:39,974
‫يبدو أن (نوا)‬
‫قام بإخفاء الجهاز في خزانة‬

414
00:24:40,850 --> 00:24:42,769
‫يفتحها هذا المفتاح‬

415
00:24:43,228 --> 00:24:46,231
‫ألديك فكرة عن مكان الخزانة؟‬

416
00:24:46,398 --> 00:24:51,027
‫سيدي، أنا مريض نفسي‬
‫أنا لا أعرف شيئاً ولا أحد يعرف‬

417
00:24:51,277 --> 00:24:53,196
‫ولكن كما ترى‬
‫أعرف بأنني لا أعرف‬

418
00:24:54,322 --> 00:24:55,698
‫عبارة متناقضة‬

419
00:24:56,991 --> 00:24:59,494
‫- انتهت المقابلة‬
‫- أجل، انتهت‬

420
00:25:01,579 --> 00:25:02,956
‫شكراً لك‬

421
00:25:03,832 --> 00:25:05,750
‫من الغريب كم اتفقتما‬

422
00:25:06,459 --> 00:25:09,838
‫في الواقع، لدي المشكلة نفسها‬
‫مع أسياد الكمية المزعجين‬

423
00:25:10,839 --> 00:25:13,967
‫من المفترض أن تكون أخلاقيات‬
‫(نوا) رادعاً لقبول المشروع أساساً‬

424
00:25:14,092 --> 00:25:16,594
‫- ولكنه قبله، لماذا؟‬
‫- أحب (نوا) الأحجيات‬

425
00:25:16,719 --> 00:25:20,056
‫- ربما لم يستطع مقاومة التحدي‬
‫- وهناك الكثير للاختيار منها‬

426
00:25:20,306 --> 00:25:21,683
‫شكراً‬

427
00:25:21,808 --> 00:25:24,310
‫أو إمكانية الحصول‬
‫على الكثير من المال‬

428
00:25:25,061 --> 00:25:27,730
‫- هذا دافع مضجر‬
‫- ولكنه لا يزال رائجاً‬

429
00:25:30,150 --> 00:25:32,402
‫- "فر مريض"‬
‫- افتح الباب الآن‬

430
00:25:32,527 --> 00:25:34,446
‫"انتباه إلى الجميع"‬

431
00:25:35,780 --> 00:25:37,866
‫"أكرر، فر مريض"‬

432
00:25:38,241 --> 00:25:39,951
‫"جميع..."‬

433
00:25:40,535 --> 00:25:41,953
‫حذروا حكام الكمية‬

434
00:25:45,834 --> 00:25:47,503
‫اطلبي من شرطة (كينمور)‬
‫تعميم مذكرة بأوصافه‬

435
00:25:47,628 --> 00:25:51,090
‫وأحضري لي كل المعلومات‬
‫المتوفرة عن (أوليفر ماكدانيال)، شكراً‬

436
00:25:51,465 --> 00:25:53,926
‫أنا منبهر، صنع (أوليفر)‬
‫بطاقة المرور الخاصة به‬

437
00:25:54,051 --> 00:25:55,552
‫مستخدماً معلومات‬
‫سرقها من أحد الحراس‬

438
00:25:55,677 --> 00:25:57,221
‫أطلق جهاز الإنذار‬
‫لإحداث عملية إلهاء‬

439
00:25:57,471 --> 00:26:00,057
‫- واختبأ في غرفة خزائن الحراس‬
‫- آخر مكان قد يبحثون فيه‬

440
00:26:00,182 --> 00:26:03,060
‫يبدو أنها ليست المرة الأولى‬
‫لم يتم التصريح عن حالات مشابهة‬

441
00:26:03,185 --> 00:26:06,021
‫- تعود إلى أكثر من شهر‬
‫- ألم يسجل أمن المشفى الأمر؟‬

442
00:26:06,146 --> 00:26:08,982
‫كانت المغادرات باسم حارس الأمن‬
‫لا شيء خارج عن المألوف‬

443
00:26:09,525 --> 00:26:11,318
‫كان بمقدور (أوليفر)‬
‫الدخول والخروج متى أراد‬

444
00:26:11,527 --> 00:26:14,154
‫إليك المفاجأة! تغيب أربع‬
‫ساعات وقت مقتل (نوا)‬

445
00:26:14,279 --> 00:26:16,990
‫- ما يضعه على لائحة المشتبه بهم‬
‫- لا أفهم لماذا خرج الآن؟‬

446
00:26:17,116 --> 00:26:18,826
‫لماذا لم يلتزم بالروتين‬
‫وتسلل إلى الخارج ليلاً؟‬

447
00:26:19,034 --> 00:26:20,786
‫لأنه يبحث عن الجهاز‬

448
00:26:20,953 --> 00:26:25,124
‫ربما عرف مكانه عندما رأى مفتاح‬
‫الخزانة وقد يفعل أي شيء ليحصل عليه‬

449
00:26:25,457 --> 00:26:28,043
‫- هل تحدثت إلى (تولمان بانتينغ)؟‬
‫- ليس لديه فكرة عن مكان (أوليفر)‬

450
00:26:28,460 --> 00:26:30,712
‫إن خلف (أوليفر) أثراً‬
‫فلن يكون أثره‬

451
00:26:30,838 --> 00:26:32,881
‫تحققا من اسم الحارس‬
‫وراقبا بطاقاته الائتمانية‬

452
00:26:33,090 --> 00:26:35,384
‫لن تكون بطاقة مرور الحارس‬
‫الشيء الوحيد الذي نسخه (أوليفر)‬

453
00:26:35,509 --> 00:26:37,094
‫لك ذلك‬

454
00:26:38,991 --> 00:26:40,368
‫- مرحباً (غرايس)‬
‫- مرحباً‬

455
00:26:41,077 --> 00:26:44,664
‫إن أردت التنقل عبر المحيط‬
‫إلى مكان قريب‬

456
00:26:45,164 --> 00:26:47,416
‫إلى منتجع من نوع ما‬

457
00:26:47,625 --> 00:26:51,504
‫- الينابيع المعدنية؟‬
‫- أجل، هذا النوع تحديداً‬

458
00:26:51,671 --> 00:26:53,506
‫أجل، هذا ما أقصده‬

459
00:26:54,715 --> 00:26:57,802
‫- هل يمكنك التوصية بمكان ما؟‬
‫- أنا منشغلة قليلاً يا (جاين)‬

460
00:26:58,386 --> 00:27:00,972
‫ألا يمكنك البحث باستخدام الحاسوب؟‬
‫قد يستغرق الأمر ١٠ ثوان‬

461
00:27:01,138 --> 00:27:02,515
‫لم لا تقوم به بنفسك؟‬

462
00:27:02,640 --> 00:27:05,434
‫سأجلب لك شوكولاتة (نوغت)‬
‫من تلك الآلة‬

463
00:27:08,521 --> 00:27:11,315
‫- امنحني ٥ دقائق‬
‫- أنت ملكة قلبي يا (غرايس)‬

464
00:27:13,067 --> 00:27:14,443
‫سأنتظر هنا‬

465
00:27:28,374 --> 00:27:32,295
‫- أهلاً بك في منتجع (تايدوتر) سيدي‬
‫- شكراً، إنه مكان رائع‬

466
00:27:32,420 --> 00:27:35,214
‫هذا ما نظنه‬
‫أيمكنني مساعدتك في أمر ما؟‬

467
00:27:35,381 --> 00:27:38,467
‫أجل، هناك أمر ما‬
‫كيف حال الموظفين لديك‬

468
00:27:38,634 --> 00:27:41,888
‫- في تأمين الأشياء للضيوف؟‬
‫- ماذا تقصد؟‬

469
00:27:42,096 --> 00:27:43,472
‫كما تعلم، أشياء خاصة‬

470
00:27:43,931 --> 00:27:48,603
‫- إن كنت تبحث عن الرفقة‬
‫- لا، ليس الرفقة ما أبحث عنه‬

471
00:27:49,520 --> 00:27:51,898
‫ولكن شكراً لك‬
‫إن كنت تعرض الرفقة‬

472
00:27:52,773 --> 00:27:54,150
‫(غاري)‬

473
00:27:58,029 --> 00:27:59,488
‫رصدنا بطاقة ائتمان الحارس‬

474
00:27:59,739 --> 00:28:02,658
‫استخدمها أحدهم لشراء تذكرة سفر‬
‫إلى (البرازيل) وستقلع الطائرة بعد ساعة‬

475
00:28:02,825 --> 00:28:04,243
‫أعلم شرطة المطار‬
‫بأننا في الطريق إليهم‬

476
00:28:13,085 --> 00:28:14,754
‫- ماذا يا (جاين)؟‬
‫- كيف حالك يا (ليزبن)؟‬

477
00:28:14,879 --> 00:28:19,216
‫لا بأس، قد أذهب إلى مطار (سان فرانسيسكو)‬
‫للقبض على (أوليفر ماكدانيال)‬

478
00:28:20,343 --> 00:28:22,136
‫قد ترغبين في إعادة النظر بالأمر‬

479
00:28:33,064 --> 00:28:34,440
‫أين هو؟‬

480
00:28:34,565 --> 00:28:38,611
‫مرحباً، أليس هذا رائعاً؟‬
‫رائحة هواء المحيط‬

481
00:28:38,819 --> 00:28:40,279
‫والرمال تحت قدميك‬

482
00:28:41,113 --> 00:28:42,990
‫أتعلمين؟ علينا نقل مكتبنا إلى هنا‬

483
00:28:43,282 --> 00:28:45,034
‫أين (أوليفر) يا (جاين)؟‬

484
00:28:45,618 --> 00:28:48,496
‫ستكونين أكثر سعادة‬
‫علاج رائع لحالات التوتر‬

485
00:28:49,038 --> 00:28:50,539
‫حجز تذكرة سفر إلى (البرازيل)‬

486
00:28:50,665 --> 00:28:52,500
‫(تشو) و(ريغسبي)‬
‫متجهان إلى المطار الآن، لذا...‬

487
00:28:52,625 --> 00:28:56,045
‫بقي (أوليفر) في المصح العقلي‬
‫فترة ٦ أشهر‬

488
00:28:56,629 --> 00:28:58,381
‫طلب منك أن تدلكيه‬

489
00:28:59,799 --> 00:29:01,342
‫يحتاج إلى قليل من الدلال‬

490
00:29:02,259 --> 00:29:04,470
‫- الرحلة مجرد تضليل‬
‫- لماذا أنت متأكد؟‬

491
00:29:05,262 --> 00:29:07,682
‫تم ضبط جهاز الصوت بغرفته‬
‫على صوت المحيط‬

492
00:29:07,974 --> 00:29:11,477
‫هذا وحقيقة أن الغرفة ٦٤٤‬

493
00:29:12,144 --> 00:29:15,314
‫قد طلبت ٦ علب معكرونة‬

494
00:29:15,648 --> 00:29:17,483
‫- لا يمكنك اعتقاله بعد‬
‫- بل أستطيع‬

495
00:29:18,150 --> 00:29:21,612
‫لا يمكنك، لقد هرب‬
‫لأنه يعرف مكان الجهاز‬

496
00:29:21,779 --> 00:29:24,949
‫- وإن تعقبناه سيقودنا إليه مباشرة‬
‫- لا أكترث للجهاز‬

497
00:29:25,241 --> 00:29:29,954
‫ألا تكترثين لجهاز فك الرموز‬
‫بإمكانه اختراق نظامنا الأمني؟‬

498
00:29:30,663 --> 00:29:32,665
‫هذا ليس شعوراً وطنياً من قبلك‬

499
00:29:33,541 --> 00:29:34,917
‫أتريدين (بينيا كولادا)؟‬

500
00:29:41,090 --> 00:29:43,926
‫الرخ إلى المربع (بي ٨)‬

501
00:29:44,176 --> 00:29:45,553
‫أيها المغرور المغفل‬

502
00:29:48,097 --> 00:29:51,308
‫سيستسلم (بانتينغ) قبل الغداء‬
‫من خلال طريقة لعبه‬

503
00:29:51,600 --> 00:29:52,977
‫رائع‬

504
00:29:55,396 --> 00:30:00,067
‫الفيل إلى المربع (سي ٤)‬

505
00:30:02,445 --> 00:30:03,821
‫ها هو‬

506
00:30:04,530 --> 00:30:07,825
‫(تشو)، شاهدنا الهدف‬
‫سنلحق به، ابق مع (ريغسبي) في الخلف‬

507
00:30:25,217 --> 00:30:27,219
‫"(باسيفيك بارك)"‬

508
00:30:28,971 --> 00:30:30,931
‫سيدخل الآن‬
‫لنر إلى أين سيتجه‬

509
00:30:37,354 --> 00:30:38,731
‫هيا‬

510
00:30:40,941 --> 00:30:47,239
‫"(باسيفيك بارك)"‬

511
00:31:13,849 --> 00:31:15,851
‫- من كان ذلك؟‬
‫- لا أعرف‬

512
00:31:16,060 --> 00:31:17,520
‫راقب (أوليفر)، تعال يا (تشو)‬

513
00:31:21,273 --> 00:31:22,650
‫نحتاج إلى مسعف عند الرصيف‬

514
00:31:31,242 --> 00:31:32,785
‫مكتب (كاليفورنيا) للتحقيقات، لا تتحرك‬

515
00:31:58,060 --> 00:31:59,436
‫٤٢‬

516
00:32:38,642 --> 00:32:40,019
‫لا تتحرك!‬

517
00:32:42,980 --> 00:32:44,356
‫سيد (بانتينغ)؟‬

518
00:32:45,274 --> 00:32:47,735
‫أربعة واثنان‬

519
00:32:58,638 --> 00:33:00,014
‫أجل‬

520
00:33:01,303 --> 00:33:03,013
‫أحسنت عملاً بتعقبنا إلى الرصيف‬

521
00:33:03,151 --> 00:33:05,737
‫لكن بالنسبة إلى رجل يطمح‬
‫للاختراق العالمي‬

522
00:33:05,862 --> 00:33:08,198
‫التنصت على أجهزة‬
‫الشرطة ليس بالأمر المهم‬

523
00:33:09,365 --> 00:33:11,910
‫كان يوماً دافئاً جداً‬

524
00:33:12,035 --> 00:33:15,997
‫أردت الانتعاش قرب الماء‬
‫وتواجدي هناك كان محض صدفة‬

525
00:33:16,122 --> 00:33:17,832
‫هذا ليس مضحكاً يا سيد (بانتينغ)‬

526
00:33:19,084 --> 00:33:20,460
‫أنت في ورطة‬

527
00:33:20,710 --> 00:33:23,546
‫سنوجه إليك اتهامات كثيرة‬
‫بسبب ما فعلته عند الرصيف اليوم‬

528
00:33:23,671 --> 00:33:27,008
‫ونحن قريبون جداً‬
‫من النيل منك بتهمة قتل (نوا)‬

529
00:33:27,342 --> 00:33:28,885
‫- حقاً؟‬
‫- حقاً‬

530
00:33:29,761 --> 00:33:34,349
‫زي المهرج، الإعلان‬
‫هذه أعمال شخص يهوى الألعاب‬

531
00:33:35,183 --> 00:33:37,727
‫أيتها الرئيسة، النائب العام‬
‫على الخط، يقول إن الأمر مستعجل‬

532
00:33:38,520 --> 00:33:42,482
‫أسدي لي خدمة‬
‫وبلغي تحياتي للنائب العام‬

533
00:33:43,191 --> 00:33:45,985
‫وأخبري السيد (جاين)‬
‫الملكة إلى المربع (دي ٨)‬

534
00:33:46,402 --> 00:33:49,489
‫الملكة إلى المربع (دي ٨)، شكراً‬

535
00:33:53,785 --> 00:33:56,037
‫كيف عرفت المكان‬
‫الذي خبأ فيه (نوا) الجهاز؟‬

536
00:33:56,955 --> 00:33:59,290
‫في كلية الدراسات العليا‬
‫أنا و(نوا) كنا نذهب إلى الرصيف البحري‬

537
00:33:59,499 --> 00:34:01,876
‫كان (نوا) يحب الألعاب‬
‫وأنا كنت أفضل الشاطئ‬

538
00:34:02,127 --> 00:34:04,295
‫كل النساء المرتديات لباس السباحة‬

539
00:34:05,547 --> 00:34:07,757
‫عرفت بأن (نوا) أخفى الجهاز هناك‬
‫حالما رأيت المفتاح‬

540
00:34:07,882 --> 00:34:09,968
‫فقررت الفرار‬
‫والحصول عليه لنفسك‬

541
00:34:10,552 --> 00:34:13,763
‫أردت النقود، هناك حرب‬
‫بين المجرات قادمة‬

542
00:34:13,888 --> 00:34:15,598
‫أجل، أنا مدرك لذلك‬

543
00:34:15,849 --> 00:34:18,601
‫ولكن إن سلمته إلى (تولمان)‬
‫فأنت تعلم بأننا سنكون بانتظارك‬

544
00:34:19,102 --> 00:34:21,688
‫أردت الجهاز لأرى طريقة عمله‬

545
00:34:22,021 --> 00:34:24,816
‫بعد ذلك، أستطيع صنع جهازي‬
‫وبيعه لأي كان‬

546
00:34:25,108 --> 00:34:26,860
‫وأجني المال لأبني غرفتي المحصنة‬

547
00:34:27,026 --> 00:34:29,696
‫تشير سجلات أمن المشفى‬
‫إلى خروجك صباح مقتل (نوا)‬

548
00:34:30,113 --> 00:34:31,489
‫- هل كنت تستعد للحرب؟‬
‫- لا‬

549
00:34:31,614 --> 00:34:33,199
‫بل تناولت الفطور في ملهاي المفضل‬

550
00:34:33,449 --> 00:34:36,077
‫يقدمون مائدة مفتوحة‬
‫ونأكل قدر ما نشاء‬

551
00:34:36,578 --> 00:34:39,622
‫رسم قاتل (نوا) عملية إلهاء‬
‫للهروب من مسرح الجريمة‬

552
00:34:39,789 --> 00:34:41,332
‫كحيلة التذكرة إلى (البرازيل)‬
‫التي قمت بها‬

553
00:34:42,167 --> 00:34:45,170
‫لم أعلم بأن الذكاء‬
‫يعتبر جريمة أيها العميل (تشو)‬

554
00:34:47,672 --> 00:34:50,758
‫يصر النائب العام على إخلاء‬
‫سبيل (بانتينغ) وإسقاط جميع التهم‬

555
00:34:50,925 --> 00:34:53,386
‫- إنه نافذ جداً‬
‫- حسناً، هذا منطقي‬

556
00:34:53,553 --> 00:34:55,180
‫يعرف الكثير من الأسرار‬

557
00:34:55,805 --> 00:34:58,975
‫لا أعرف ماذا أفعل‬
‫كيف تبني قضية تجاه رجل كهذا؟‬

558
00:34:59,475 --> 00:35:01,895
‫الأمر ليس صعباً‬

559
00:35:03,813 --> 00:35:05,440
‫تحدث إلى الفتيات‬
‫في نادي التعري‬

560
00:35:05,732 --> 00:35:07,525
‫ستتذكر إحداهن حتماً‬
‫وجودي هناك‬

561
00:35:07,775 --> 00:35:09,152
‫إنه يقول الحقيقة يا (تشو)‬

562
00:35:09,694 --> 00:35:12,447
‫يعاني (أوليفر) من مشكلة‬
‫في تحمل جعة خفيفة‬

563
00:35:13,156 --> 00:35:15,867
‫- ولن يقتل (نوا فاليكيت)‬
‫- هذا ليس دقيقاً‬

564
00:35:16,034 --> 00:35:18,828
‫- أستطيع أذيتك إن أردتُ ذلك‬
‫- ولكن لا تريد ذلك‬

565
00:35:20,079 --> 00:35:22,457
‫قبل أن نسمح لك بالخروج‬
‫أريد أن تسدي لي خدمة‬

566
00:35:22,790 --> 00:35:24,542
‫- مستحيل‬
‫- فكر بالأمر‬

567
00:35:24,667 --> 00:35:26,336
‫سيمنحك فرصة العمل على هذا‬

568
00:35:26,794 --> 00:35:29,297
‫وعندما تنتهي‬
‫هدية صغيرة من اتحاد الكواكب‬

569
00:35:37,430 --> 00:35:39,182
‫يقضي الرخ على (أف ٦)‬

570
00:35:39,515 --> 00:35:41,225
‫سمحت لي مساعدتك الودودة بالدخول‬

571
00:35:42,560 --> 00:35:44,562
‫يقضي الرخ على المربع (أف ٦)‬

572
00:35:45,313 --> 00:35:47,065
‫يتحرك الملك إلى المربع (جي ٨)‬

573
00:35:48,107 --> 00:35:49,484
‫ما الذي تفعله هنا؟‬

574
00:35:49,609 --> 00:35:53,988
‫جئت لأتحقق‬
‫من أن جهاز (نوا) يعمل فعلاً‬

575
00:35:54,656 --> 00:35:56,032
‫- أهذا هو؟‬
‫- أجل‬

576
00:35:57,116 --> 00:36:00,244
‫- إذاً، لقد صنعه فعلاً‬
‫- أجل، وقد جئت لأعيده‬

577
00:36:01,120 --> 00:36:02,747
‫مقابل مليوني دولار طبعاً‬

578
00:36:04,332 --> 00:36:06,292
‫أتتوقع مني أن أدفع لك؟‬

579
00:36:06,501 --> 00:36:08,753
‫ليس لي بل إلى مالكيه الشرعيين‬

580
00:36:09,337 --> 00:36:12,423
‫هل التقيت بزوجة (نوا)‬
‫(دافني) وشقيقه (رايف)؟‬

581
00:36:12,674 --> 00:36:16,302
‫من الناحية القانونية، ممتلكات‬
‫(نوا) أصبحت من حق (دافني)‬

582
00:36:16,678 --> 00:36:20,056
‫ومن بينها هذا‬
‫هل رأيتماه من قبل؟‬

583
00:36:20,348 --> 00:36:21,724
‫- لا‬
‫- ما هو؟‬

584
00:36:21,849 --> 00:36:26,020
‫إنه جهاز تفكيك الرموز‬
‫صممه (نوا) للسيد (بانتينغ)‬

585
00:36:26,562 --> 00:36:28,272
‫مقابل مليوني دولار‬

586
00:36:28,398 --> 00:36:30,525
‫- والمبلغ من حقك‬
‫- يا إلهي‬

587
00:36:30,650 --> 00:36:33,027
‫أنا واثق من أن الشيك‬
‫مقبول يا سيد (بانتينغ)‬

588
00:36:33,194 --> 00:36:37,198
‫علينا التأكد من أن الجهاز يعمل‬
‫كان هذا جزءاً من اتفاقنا‬

589
00:36:37,323 --> 00:36:38,700
‫كما تريد‬

590
00:36:49,752 --> 00:36:51,546
‫نحتاج إلى ملف مشفر‬

591
00:36:52,005 --> 00:36:55,383
‫- وملفات العميلة (ليزبن) الشخصية؟‬
‫- لا‬

592
00:36:55,508 --> 00:36:57,427
‫- صدف أنها متوافرة معي على قرص‬
‫- لا‬

593
00:36:57,552 --> 00:36:59,762
‫- يحتوي الملف على صور رائعة‬
‫- حسناً‬

594
00:37:08,813 --> 00:37:10,606
‫يبدو أنه يعمل‬

595
00:37:15,486 --> 00:37:18,990
‫- ما معنى هذا؟‬
‫- يعني أنه لا يعمل‬

596
00:37:20,366 --> 00:37:22,869
‫يبدو أن (نوا)‬
‫لم ينجز المشروع‬

597
00:37:22,994 --> 00:37:24,495
‫آسف يا سيدة (فاليكيت)‬

598
00:37:25,038 --> 00:37:26,414
‫احتاج إلى مزيد من الوقت‬

599
00:37:27,040 --> 00:37:29,000
‫مهلاً، كيف نتأكد من أنه لا يعمل‬

600
00:37:29,125 --> 00:37:32,628
‫ربما يتلاعب بنا‬
‫محاولاً التهرب من دفع المليونين‬

601
00:37:33,129 --> 00:37:35,339
‫لا تكن سخيفاً‬
‫لماذا لن أرغب في نجاح الجهاز؟‬

602
00:37:36,299 --> 00:37:39,302
‫حاول مجدداً، لأن زوجي‬
‫كان عبقرياً، عليه أن يعمل‬

603
00:37:39,469 --> 00:37:42,263
‫أخشى بأن عبقرية زوجك‬
‫كانت محدودة‬

604
00:37:42,555 --> 00:37:43,931
‫جارنا في الأمر‬

605
00:37:47,393 --> 00:37:48,770
‫حسناً، لا بأس‬

606
00:37:50,938 --> 00:37:52,315
‫"متصل"‬

607
00:37:58,738 --> 00:38:00,114
‫ما الذي يحصل؟‬

608
00:38:01,616 --> 00:38:02,992
‫إنه يعمل‬

609
00:38:04,327 --> 00:38:05,703
‫إنه يعمل!‬

610
00:38:06,120 --> 00:38:07,538
‫- "قامت زوجتي بقتلي"‬
‫- ماذا؟‬

611
00:38:08,539 --> 00:38:09,916
‫"قامت زوجتي بقتلي"‬

612
00:38:10,500 --> 00:38:12,502
‫- ما هذا؟‬
‫- أطفئه‬

613
00:38:12,794 --> 00:38:16,047
‫- مهلاً، هذا صحيح، أليس كذلك؟‬
‫- أطفئه، طبعاً لا‬

614
00:38:16,255 --> 00:38:18,257
‫قلت إنك لا تعرفين‬
‫شيئاً عن الجهاز‬

615
00:38:18,883 --> 00:38:21,344
‫- كنت تكذبين‬
‫- لا‬

616
00:38:21,969 --> 00:38:23,971
‫طلبت من (أوليفر) تغيير‬
‫الأعداد كي لا يعمل الجهاز‬

617
00:38:24,097 --> 00:38:27,809
‫ولكن عرفت طريقة إعادتها‬
‫شاهدت (نوا) وهو يعمل‬

618
00:38:28,684 --> 00:38:31,979
‫علمت بأنه لن يسلم الجهاز‬
‫لـ(تولمان) مقابل أي ثمن‬

619
00:38:32,313 --> 00:38:35,149
‫لذا فعلت ما شعرت بضرورة فعله‬
‫وتلاعبت بخوفه‬

620
00:38:35,358 --> 00:38:38,486
‫"أردت أخذ الجهاز‬
‫وتسليمه إلى (تولمان) بنفسك"‬

621
00:38:39,529 --> 00:38:40,988
‫كل ما كان عليك فعله‬
‫هو فتح الخزنة‬

622
00:38:41,572 --> 00:38:42,949
‫"ولكن المشكلة"‬

623
00:38:44,075 --> 00:38:45,451
‫"لم يكن موجوداً في الخزنة"‬

624
00:38:50,873 --> 00:38:55,044
‫الفيلم عن مهووس الرياضيات‬
‫والمرأة التي تحبه‬

625
00:38:56,337 --> 00:38:58,631
‫أجل، ظننت بأنني و(نوا)‬
‫سنكون كذلك‬

626
00:39:02,385 --> 00:39:04,345
‫(لوفز تاندر باشين)‬

627
00:39:05,012 --> 00:39:06,931
‫أجل، يمكنك السخرية‬

628
00:39:08,432 --> 00:39:10,643
‫لم تكن الحياة مع (نوا) هكذا‬

629
00:39:11,102 --> 00:39:13,980
‫كان الصمت يسود طوال أيام‬

630
00:39:14,939 --> 00:39:17,441
‫وكتباً كنت أعجز‬
‫عن فهم العنوان حتى‬

631
00:39:17,567 --> 00:39:21,028
‫لا نمارس الحب عندما يفكر‬
‫وهو ما يفعله دائماً‬

632
00:39:22,572 --> 00:39:26,159
‫أعمل ٥٠ ساعة في الأسبوع وأستجدي‬
‫البقشيش لنتمكن من الحصول على الطعام‬

633
00:39:29,620 --> 00:39:33,332
‫بأي حال، بعدها أخبرني (نوا)‬
‫عن ذلك الرجل‬

634
00:39:33,457 --> 00:39:37,295
‫الذي سيدفع مليوني دولار‬
‫لقاء بناء الجهاز‬

635
00:39:37,962 --> 00:39:43,259
‫رجوته ووافق على صنعه‬
‫وكان أمراً صائباً لأن حان دوره‬

636
00:39:43,801 --> 00:39:45,178
‫ولكنه رفض تسليمه‬

637
00:39:46,762 --> 00:39:48,139
‫ولم يمكنك تقبل الأمر‬

638
00:39:49,265 --> 00:39:51,809
‫أجل، قال إنه مشروع خطير جداً‬

639
00:39:53,728 --> 00:39:56,480
‫حاولت إجباره على تسليمه‬
‫ولكنه قال...‬

640
00:39:57,899 --> 00:40:01,152
‫قال إنني لست قادرة‬
‫على فهم عواقب الجهاز‬

641
00:40:03,404 --> 00:40:05,656
‫قررت أن أريه‬
‫بأنني ذكية أيضاً‬

642
00:40:07,450 --> 00:40:10,953
‫أو أنك أغبى بكثير‬
‫لست واثقا أيهما أنت‬

643
00:40:12,496 --> 00:40:13,873
‫انهضي‬

644
00:40:15,833 --> 00:40:18,085
‫تعالي‬
‫ضعي يديك خلف ظهرك‬

645
00:40:28,596 --> 00:40:30,973
‫- ما الذي جعلك تشك بها؟‬
‫- توصلت إلى الأمر متأخراً‬

646
00:40:31,098 --> 00:40:34,018
‫كنت لركلت نفسي‬
‫بقي المطبخ سليماً من التفتيش‬

647
00:40:34,143 --> 00:40:35,645
‫لأنه ميدانها الخاص‬

648
00:40:35,937 --> 00:40:37,521
‫كانت تعلم بعدم وجود الجهاز هناك‬

649
00:40:40,107 --> 00:40:42,526
‫سيد (جاين)، توقيتك ممتاز‬

650
00:40:43,527 --> 00:40:46,697
‫البيدق إلى المربع (أف ٤)‬

651
00:40:53,246 --> 00:40:54,622
‫خطوة ذكية‬

652
00:40:56,290 --> 00:40:59,418
‫ولكنني أعتقد أن سبب وجودك هنا‬
‫أكثر من مجرد محاصرة ملكتي‬

653
00:40:59,919 --> 00:41:05,216
‫أجل، في الواقع‬
‫أتيت إلى هنا لأخذ ما يخصني‬

654
00:41:06,926 --> 00:41:11,764
‫نظرا إلى وضع (دافني) فإن حقوق‬
‫ملكية الجهاز تذهب لشقيق (نوا)‬

655
00:41:12,848 --> 00:41:15,226
‫وعندما اتصلت بـ(رايف)‬
‫لم يرغب في أن تكون له علاقة بالجهاز‬

656
00:41:15,559 --> 00:41:19,397
‫لذا بحسب أقوال المحامين‬
‫هذا ينقل ملكية الجهاز‬

657
00:41:20,481 --> 00:41:21,857
‫لي أنا‬

658
00:41:23,192 --> 00:41:25,361
‫معي جميع الإثباتات القانونية‬
‫إن كانت لديك أسئلة‬

659
00:41:25,528 --> 00:41:27,655
‫لا داعي لذلك‬
‫إنه لك‬

660
00:41:28,739 --> 00:41:30,116
‫إنه لك‬

661
00:41:30,241 --> 00:41:32,743
‫آمل في أنك لن تمانع‬
‫لعبت بالجهاز قليلاً‬

662
00:41:32,868 --> 00:41:34,370
‫أردت فقط رؤية كيفية عمله‬

663
00:41:39,709 --> 00:41:41,919
‫- سيكون إصلاحه سهلاً؟‬
‫- سهلاً‬

664
00:41:42,128 --> 00:41:46,173
‫ما هذا؟‬
‫قد يكون هذا جزءاً منه‬

665
00:41:52,847 --> 00:41:54,765
‫سيتصل بك محاميّ‬

666
00:41:55,933 --> 00:41:57,310
‫(تولمان) ، أمر أخير‬

667
00:41:58,644 --> 00:42:02,982
‫الفيل إلى المربع (سي ٤)‬

668
00:42:05,318 --> 00:42:08,070
‫سيموت الملك خلال ٣ خطوات‬

669
00:42:10,489 --> 00:42:11,866
‫لقد فزت‬

670
00:42:12,241 --> 00:42:14,952
‫ألق نظرة عن قرب‬
‫سترى ذلك‬

671
00:42:28,090 --> 00:42:29,467
‫علينا معاودة اللعب‬
