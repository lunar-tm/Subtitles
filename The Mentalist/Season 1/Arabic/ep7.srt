1
00:00:02,060 --> 00:00:05,375
‫"المتلاعب الذهني، اسم"‬

2
00:00:05,740 --> 00:00:08,702
‫"شخص يستخدم‬
‫الذكاء العقلي أو التنويم المغناطيسي"‬

3
00:00:08,767 --> 00:00:10,894
‫"والاقتراح"‬

4
00:00:11,621 --> 00:00:14,415
‫"متلاعب خبير بالأفكار والتصرفات"‬

5
00:00:27,053 --> 00:00:30,682
‫"معبد التناغم"‬

6
00:00:31,599 --> 00:00:33,518
‫أرجوكِ ألاّ تذهبي يا (روزماري)‬
‫أحاول المساعدة فقط‬

7
00:00:33,643 --> 00:00:36,437
‫- لن أستمع إليكِ‬
‫- أنتِ بخطر كبير يا (روزماري)‬

8
00:00:36,562 --> 00:00:38,022
‫لن أستمع إليكِ‬

9
00:01:02,880 --> 00:01:04,340
‫لا‬

10
00:01:29,991 --> 00:01:31,451
‫شكراً لمجيئكم بسرعة‬

11
00:01:31,576 --> 00:01:33,703
‫ضحيتكم هي أرملة (ميكون تينانت)‬

12
00:01:34,495 --> 00:01:36,456
‫مؤسس شركة (كالشور) المالية‬

13
00:01:36,789 --> 00:01:38,291
‫صديق مقرب للمحافظ‬

14
00:01:38,416 --> 00:01:39,876
‫أجل، علينا استخدام المروحية‬

15
00:01:40,001 --> 00:01:44,422
‫جيد، لدينا شاهدان شاهدا‬
‫سيارة (سيدان) فضية تلاحقها‬

16
00:01:44,714 --> 00:01:47,967
‫نزيل الطلاء من سلات المهملات الآن‬
‫على أمل أن نحدد طرازها‬

17
00:01:48,134 --> 00:01:51,471
‫- كما أنّه لدينا جزء من أرقام لوحة التسجيل‬
‫- يبدو أنّك مسيطر على الوضع‬

18
00:01:51,637 --> 00:01:53,765
‫بالتأكيد، ولكن لا أمانع الدعم‬

19
00:01:53,973 --> 00:01:55,683
‫لسنا دعماً، نحن القيادة‬

20
00:01:55,933 --> 00:01:57,393
‫أجل يا سيدتي‬

21
00:01:58,353 --> 00:02:02,398
‫قبل أيام، بلغت (روزماري)‬
‫عن ابنها المراهق المفقود، (ترافيس)‬

22
00:02:02,523 --> 00:02:05,234
‫اختفى منذ أسبوع‬
‫ولكنّه سبق أن هرب من المنزل مرتين‬

23
00:02:05,360 --> 00:02:07,737
‫- ودخل إلى سجن الأحداث‬
‫- ماذا كانت تهمته؟‬

24
00:02:07,862 --> 00:02:09,906
‫القيادة تحت التأثير الكحول‬
‫برخصة قيادة المتعلمين‬

25
00:02:10,490 --> 00:02:13,284
‫منزلها يبعد ٨ بنايات‬
‫فتوقعت أنّه كانت تمشي إلى المنزل‬

26
00:02:13,409 --> 00:02:16,037
‫- ولكن من أين؟ لسنا متأكدين‬
‫- كانت معي‬

27
00:02:17,497 --> 00:02:18,956
‫من أنتِ بالضبط؟‬

28
00:02:19,082 --> 00:02:22,585
‫أنا (كريستينا فراي)‬
‫كنت المستشارة الروحية لـ(روزماري)‬

29
00:02:23,336 --> 00:02:25,129
‫أعتذر، أسمعت الكلمات‬
‫بطريقة صحيحة؟‬

30
00:02:25,338 --> 00:02:27,090
‫أين كنتِ معها يا آنسة (فراي)؟‬

31
00:02:27,465 --> 00:02:30,009
‫في منزلي، كنّا قد أنهينا الجلسة‬

32
00:02:30,134 --> 00:02:33,971
‫- كنا قد اتصلنا بزوجها‬
‫- زوجها الميت؟‬

33
00:02:34,806 --> 00:02:36,349
‫كان يعرف أنّ هذا سيحدث لها‬

34
00:02:37,266 --> 00:02:40,019
‫حذرها من أنّها تضع نفسها‬
‫بخطر عظيم‬

35
00:02:40,144 --> 00:02:41,979
‫- مِمن؟‬
‫- لا أعرف‬

36
00:02:42,105 --> 00:02:45,358
‫- أنا مجرد حلقة وصل‬
‫- حلقة وصل لماذا؟‬

37
00:02:46,025 --> 00:02:47,944
‫لطاقة الأرواح التي غادرت‬

38
00:02:49,862 --> 00:02:53,366
‫حسناً، إذن، كنتِ تعلمين‬
‫أنّ هذه الجريمة ستقع؟‬

39
00:02:53,950 --> 00:02:57,453
‫لم أعرف، زوجها عرف ذلك‬
‫وأوصلت التحذير لها‬

40
00:02:57,912 --> 00:03:00,415
‫حسناً فهمت، باعترافها‬

41
00:03:00,540 --> 00:03:05,920
‫إمّا أنّها حلقة وصل للأرواح الراحلة‬
‫أو أنّها متورطة بهذه الجريمة‬

42
00:03:06,796 --> 00:03:10,466
‫لديكم خيار، يمكننا الاتصال بمطاردي الأرواح‬
‫أو يمكننا أخذها للمكتب‬

43
00:03:10,758 --> 00:03:12,760
‫آنسة (فراي)، هلاّ تأتين إلى مكتبنا‬

44
00:03:12,885 --> 00:03:15,471
‫في الصباح للإجابة على بعض الأسئلة‬
‫بتفصيل أكثر‬

45
00:03:15,763 --> 00:03:17,765
‫يسعدني أن أقدم المساعدة‬

46
00:03:18,224 --> 00:03:19,684
‫أرجوكِ أن تدعيني بـ(كريستينا)‬

47
00:03:22,687 --> 00:03:24,897
‫ما هو مصدر كل ذلك الغضب‬
‫الذي أحس به؟‬

48
00:03:25,022 --> 00:03:26,524
‫ليس منّي‬
‫ربما تسقطين مشاعركِ عليّ‬

49
00:03:27,024 --> 00:03:28,568
‫(روزماري) كانت صديقتي‬

50
00:03:28,734 --> 00:03:30,486
‫هل أنا حزينة؟ بالطبع‬

51
00:03:31,320 --> 00:03:34,615
‫هل أنا غاضبة؟ فقط لأنّ أحدهم‬
‫فعل أمراً بهذه الفظاعة بها‬

52
00:03:35,491 --> 00:03:39,996
‫لا تفهمني بشكل خطأ، ولكنّك أسأت‬
‫قراءة هذا الوضع تماماً‬

53
00:03:40,621 --> 00:03:42,081
‫حقاً؟‬

54
00:03:42,540 --> 00:03:44,083
‫سيكون هذا ممتعاً‬

55
00:03:54,523 --> 00:03:56,317
‫منذ متى تعرفين (روزماري تينانت)؟‬

56
00:03:57,264 --> 00:03:59,307
‫- لثلاث سنوات تقريباً‬
‫- أتطلبين ثمناً مقابل خدماتك؟‬

57
00:03:59,695 --> 00:04:03,657
‫أجل، المقدار يعتمد‬
‫على وضع الزبون المادي‬

58
00:04:03,783 --> 00:04:06,368
‫- ولكن لا أرفض أيّ أحد‬
‫- كم طلبتِ من (روزماري)؟‬

59
00:04:06,447 --> 00:04:07,907
‫٥٠٠ دولار بالساعة‬

60
00:04:08,079 --> 00:04:09,705
{\an8}‫- كم ساعة بالأسبوع؟‬
‫- خمسة إلى ستة‬

61
00:04:11,415 --> 00:04:12,875
{\an8}‫٣ آلاف دولار بالأسبوع‬

62
00:04:13,377 --> 00:04:15,837
{\an8}‫- هذا جيد‬
‫- (روزماري) كانت روحاً مضطربة‬

63
00:04:16,378 --> 00:04:18,005
{\an8}‫احتاجت إلى الكثير من المساعدة‬

64
00:04:18,422 --> 00:04:19,882
{\an8}‫ما هو سبب اضطرابها؟‬

65
00:04:21,133 --> 00:04:23,302
{\an8}‫زوجها كان دعامةً قويةً في حياتها‬

66
00:04:23,427 --> 00:04:25,971
{\an8}‫وأعتقد أنّها شعرت بالضياع وبأنها ضعيفة‬
‫بعد موته‬

67
00:04:26,097 --> 00:04:29,683
{\an8}‫والذين لم يكن يجب أن تثق بهم‬
‫لاحظوا ضعفها‬

68
00:04:29,809 --> 00:04:31,602
‫- وحاولوا استغلاله‬
‫- حقاً؟‬

69
00:04:31,647 --> 00:04:35,109
{\an8}‫- أهناك أشخاص محددون؟‬
‫- إنّهم أكثر من أن أذكرهم‬

70
00:04:35,856 --> 00:04:38,984
{\an8}‫وكنتيجة، أعتقد أنّ علاقتها بأبنائها‬
‫عانت كثيراً‬

71
00:04:39,056 --> 00:04:40,516
‫(كلارا) و(ترافيس)، صحيح؟‬

72
00:04:41,445 --> 00:04:42,905
{\an8}‫كيف عانت؟‬

73
00:04:44,573 --> 00:04:47,493
{\an8}‫أعتذر، لا أشعر بالراحة‬
‫لأشارك المزيد من التفاصيل معكم‬

74
00:04:48,244 --> 00:04:50,496
{\an8}‫(ترافيس) مفقود منذ عدة أيام‬

75
00:04:51,122 --> 00:04:53,833
{\an8}‫- ما كان رأيها بذلك؟‬
‫- أود مساعدتكم حقاً‬

76
00:04:53,958 --> 00:04:58,838
{\an8}‫ولكنّ مهنتي بها قواعد خصوصية‬
‫كجميع الأطباء‬

77
00:04:58,963 --> 00:05:01,173
{\an8}‫ألديكِ رخصة معالج نفسي مهنية‬
‫في الولاية؟‬

78
00:05:01,298 --> 00:05:03,384
‫- أجل‬
‫- زبونتك ميتة‬

79
00:05:03,530 --> 00:05:04,990
‫حاويتها الأرضية ماتت‬

80
00:05:05,082 --> 00:05:08,169
‫حتى تكمل روحها الرحلة‬
‫يمكنني أن أسألها‬

81
00:05:08,320 --> 00:05:10,823
{\an8}‫إن كان يمكنني مشاركتكم مشاكلها‬
‫بتفصيل أكبر‬

82
00:05:11,767 --> 00:05:13,644
‫سجلت جميع جلساتنا على قرص‬

83
00:05:13,769 --> 00:05:16,105
‫إن وافقت، سأعطيكم إياه‬

84
00:05:16,613 --> 00:05:18,907
{\an8}‫لمَ نتعب نفسنا بذلك؟‬
‫لمَ لا تسألينها من قتلها وحسب؟‬

85
00:05:19,441 --> 00:05:21,944
‫بالطبع سأفعل، ولكنّها قد لا تعرف‬

86
00:05:22,862 --> 00:05:24,613
{\an8}‫الموت لا يمنح العلم بكل شيء‬

87
00:05:25,322 --> 00:05:27,575
‫- أنتِ بارعة‬
‫- أود اعتقاد ذلك‬

88
00:05:27,700 --> 00:05:30,327
‫- أجل، تودين ذلك‬
‫- أعتقد أنّ حب النفس مهم‬

89
00:05:30,452 --> 00:05:31,912
‫كيف تشعر تجاه نفسك؟‬

90
00:05:33,164 --> 00:05:37,042
{\an8}‫أخبريني أنتِ، وانسي الـ٥٠٠ دولار‬
‫بالساعة، الخدمة المدنية تدفع لي‬

91
00:05:37,368 --> 00:05:39,253
{\an8}‫حسناً، سيكون هذا مجانياً إذن‬

92
00:05:41,547 --> 00:05:45,092
‫أعتقد أنّك تتظاهر بالثقة والتكبر‬
‫ولكن بداخلك‬

93
00:05:45,217 --> 00:05:48,220
‫يتسبب الذنب وكره النفس العميق‬
‫باضطرابك‬

94
00:05:48,470 --> 00:05:51,140
‫صدمة حديثة في ماضيك على الأغلب؟‬

95
00:05:52,349 --> 00:05:54,393
‫ولكنّه أكثر من مجرد‬
‫اضطراب بسيط‬

96
00:05:55,436 --> 00:05:59,398
{\an8}‫- أمامك مهمة شاقة‬
‫- أنتِ بارعة‬

97
00:05:59,607 --> 00:06:03,736
{\an8}‫أرجوكن، لا أود الاعتداد بنفسي‬
‫ولكن مأساتي الفظيعة معروفة‬

98
00:06:05,070 --> 00:06:07,948
‫بمجرد نصف ساعة على الإنترنت‬
‫ستعرفين أنّ الذنب يرهقني‬

99
00:06:08,073 --> 00:06:10,659
‫- وأحتقر نفسي‬
‫- نظرة واحدة بعينيك أخبرتني بذلك‬

100
00:06:11,493 --> 00:06:14,872
‫وما الذي يجعلك تعتقد أنّي سأقضي‬
‫الوقت بالبحث عنك على الإنترنت؟‬

101
00:06:15,664 --> 00:06:17,249
‫أنت معتد بنفسك كثيراً ربما؟‬

102
00:06:19,285 --> 00:06:21,003
‫- أيمكنني الذهاب؟‬
‫- أجل‬

103
00:06:21,212 --> 00:06:23,923
{\an8}‫- شكراً لوقتك‬
‫- اتصلوا بي حين تشاؤون‬

104
00:06:24,882 --> 00:06:26,342
{\an8}‫سنفعل‬

105
00:06:31,513 --> 00:06:32,973
‫ماذا؟‬

106
00:06:39,939 --> 00:06:41,815
‫- منزل من هذا؟‬
‫- حتى قبل يومين‬

107
00:06:41,941 --> 00:06:44,235
‫المقيمون كانوا (ترافيس تينانت)‬
‫(روزماري تينانت)‬

108
00:06:44,902 --> 00:06:47,780
‫والضيف شبه الدائم‬
‫الذي يدعى بـ(جيريمي هيل)‬

109
00:06:48,280 --> 00:06:51,242
‫مصور الصور الشخصية‬
‫وحبيب السيدة (تينانت)‬

110
00:06:51,867 --> 00:06:53,327
‫وفقاً لما قاله عامل الحدائق‬
‫وعامل المسبح‬

111
00:06:55,829 --> 00:06:57,331
‫(دولي)، (دولي)، تعال إلى هنا‬

112
00:06:58,415 --> 00:07:00,125
‫- هل لي أن أساعدكم؟‬
‫- السيد (هيل)؟‬

113
00:07:00,251 --> 00:07:02,336
‫- أجل‬
‫- مكتب (كاليفورنيا) للتحقيق‬

114
00:07:02,711 --> 00:07:04,171
‫هل لنا أن ندخل؟‬

115
00:07:04,797 --> 00:07:06,257
‫بالطبع‬

116
00:07:12,179 --> 00:07:14,390
‫أعتذر بشأن الفوضى‬

117
00:07:14,682 --> 00:07:16,558
‫يبدو أنّك لم تكن لوحدك البارحة‬

118
00:07:16,684 --> 00:07:19,853
‫كنت في افتتاح معرض‬
‫ولكن يوجد أحد هنا دائماً‬

119
00:07:20,813 --> 00:07:22,815
‫تحب (روزي) وجود الناس و...‬

120
00:07:23,732 --> 00:07:26,902
‫وتعرفون الشخصيات الخلاقة أمثالنا‬
‫نتوق لتأجيل العمل‬

121
00:07:28,028 --> 00:07:29,488
‫منذ متى تعيش هنا؟‬

122
00:07:31,865 --> 00:07:33,575
‫هذا شهري السادس‬

123
00:07:34,660 --> 00:07:37,204
‫أنا مصور‬

124
00:07:37,579 --> 00:07:39,790
‫والتقيت بـ(روزماري) بأحد العروض‬

125
00:07:40,666 --> 00:07:44,712
‫ذهبت لأصور صورةً شخصيةً‬
‫وأعتقد أنّنا انسجمنا‬

126
00:07:44,878 --> 00:07:47,548
‫- ولم أغادر قط‬
‫- كنت أنّت والسيدة (تينانت) عشيقين؟‬

127
00:07:48,549 --> 00:07:50,009
‫هذا ما يقوله الجميع‬

128
00:07:50,884 --> 00:07:52,720
‫هل أحببتها وأحبتني؟ أجل‬

129
00:07:52,845 --> 00:07:55,431
‫ولكن عشيقان؟ كنا مقربين‬

130
00:07:55,597 --> 00:07:57,099
‫فهمتني أفضل من أيّ أحد‬

131
00:07:57,766 --> 00:08:00,477
‫لا بد أنّك تعرفت على أبنائها‬
‫جيداً لأنّك تعيش هنا‬

132
00:08:01,353 --> 00:08:03,397
‫(كلارا) كبرت ولم تعد‬
‫تأتي لهنا كثيراً‬

133
00:08:04,273 --> 00:08:06,317
‫و(ترافيس) واجه بعض المشاكل‬

134
00:08:06,608 --> 00:08:08,819
‫- كيف؟‬
‫- أعتقد أنّه بعد وفاة والده‬

135
00:08:08,944 --> 00:08:10,571
‫فقد صوابه وحسب‬

136
00:08:11,071 --> 00:08:14,408
‫تعاطي المخدرات، السرقة‬
‫التصرف بطريقة جنونية‬

137
00:08:15,075 --> 00:08:16,660
‫متى رأيته لآخر مرة؟‬

138
00:08:16,994 --> 00:08:20,164
‫قبل أكثر من أسبوع‬
‫وجدت (روزي) مخدرات في غرفة نومه‬

139
00:08:20,289 --> 00:08:22,041
‫تشاجرا، وترك البيت‬
‫لا أعرف إلى أين‬

140
00:08:22,166 --> 00:08:24,001
‫لديه مئات الأصدقاء المجانين‬
‫للاختباء معهم‬

141
00:08:24,126 --> 00:08:26,128
‫المعذرة، أتمانع إن ألقيت‬
‫نظرةً بالأرجاء؟‬

142
00:08:26,628 --> 00:08:28,130
‫لا، تفضل‬

143
00:08:28,422 --> 00:08:29,882
‫شكراً‬

144
00:08:30,632 --> 00:08:33,510
‫وضعتك (روزماري) بوصيتها‬
‫قبل عدة أشهر، صحيح؟‬

145
00:08:33,761 --> 00:08:36,388
‫أجل، وشعرت بالسوء تجاه ذلك‬
‫كان ذلك أكثر من اللازم‬

146
00:08:36,889 --> 00:08:38,724
‫(روزماري) كانت شخصاً كريماً‬

147
00:08:38,849 --> 00:08:41,727
‫ورفض كرمها سيكون...‬

148
00:08:41,852 --> 00:08:43,562
‫رفض جوهرها‬

149
00:08:43,687 --> 00:08:46,190
‫باليوم الذي سبق وفاتها‬
‫رتبت اجتماعاً مع محامي عقاراتها‬

150
00:08:46,357 --> 00:08:48,734
‫وقالت له إنّها أرادت‬
‫إدخال تعديلات إضافية بالوصية‬

151
00:08:49,318 --> 00:08:51,528
‫حقاً؟ لم أعرف بذلك‬

152
00:08:51,653 --> 00:08:55,074
‫- ما هو سبب ذلك برأيك؟‬
‫- أعتقد أنّه يتعلق بـ(ترافيس)‬

153
00:08:55,532 --> 00:08:57,701
‫إخراجه من الوصية‬
‫على أمل أن يعدل نفسه‬

154
00:08:57,993 --> 00:08:59,453
‫(ليزبون)‬

155
00:09:05,334 --> 00:09:06,794
‫وجدت أستديو عملي‬

156
00:09:07,669 --> 00:09:09,463
‫كانت جميلةً جداً، صحيح؟‬

157
00:09:09,838 --> 00:09:11,632
‫وضحت جمال أعينها‬

158
00:09:11,799 --> 00:09:14,676
‫- وكأنّها تتحدث إلينا‬
‫- تصوير (روزماري) كان سهلاً‬

159
00:09:14,802 --> 00:09:16,470
‫وهذه الصور مقصرة بحقها‬

160
00:09:16,720 --> 00:09:18,430
‫يا له من أستديو‬

161
00:09:18,764 --> 00:09:21,100
‫غرفة مظلمة، معدات حديثة‬

162
00:09:21,266 --> 00:09:23,977
‫- من الجميل أن تحظى بالمساعدة‬
‫- أنا محظوظ‬

163
00:09:24,186 --> 00:09:25,646
‫أو ذكي‬

164
00:09:26,438 --> 00:09:28,982
‫قلت إنّ (ترافيس) غادر‬
‫لأنّه تشاجر مع أمه‬

165
00:09:29,108 --> 00:09:31,276
‫- هل أنت متأكد من ذلك؟‬
‫- بالطبع، كنت موجوداً‬

166
00:09:31,610 --> 00:09:35,030
‫أعتقد أنّ السيدة (تينانت)‬
‫تتجاهل مشاكل ابنها‬

167
00:09:35,155 --> 00:09:36,657
‫لأنّه خسر والده‬

168
00:09:36,782 --> 00:09:39,159
‫لم يغادر بسببها بل بسببك‬

169
00:09:39,410 --> 00:09:42,579
‫- عمّ تتحدث؟‬
‫- أعتقد أنّ هذه غرفة (ترافيس)‬

170
00:09:43,747 --> 00:09:45,791
‫هناك لاصق لتعليق الملصقات‬
‫على الجدران‬

171
00:09:46,625 --> 00:09:48,669
‫هناك ملصقات خلف هذا الباب‬

172
00:09:49,503 --> 00:09:53,257
‫وعلامات هنا بالأعلى‬

173
00:09:53,715 --> 00:09:57,219
‫بمكان اصطدام كرة الـ(لاكروس)‬
‫لعب (ترافيس) الـ(لاكروس)، صحيح؟‬

174
00:09:57,344 --> 00:09:59,179
‫كان يلعب، قبل تورطه‬
‫بتعاطي المخدرات‬

175
00:09:59,388 --> 00:10:02,099
‫وهنا يوجد شق بالزجاج‬

176
00:10:02,224 --> 00:10:04,268
‫ضربة كوع أو قبضة يد‬

177
00:10:05,310 --> 00:10:07,438
‫لا بد أنّه كان شجاراً محتداً بينكما‬

178
00:10:07,563 --> 00:10:09,690
‫- حسناً، هذا يكفي‬
‫- السؤال الوحيد هو‬

179
00:10:09,815 --> 00:10:11,483
‫هل أخذت غرفته بمجرد أن غادر؟‬

180
00:10:11,900 --> 00:10:13,694
‫أم هل غادر لأنّك أخذت غرفته؟‬

181
00:10:14,236 --> 00:10:15,863
‫أنت بحيزي الشخصي‬

182
00:10:16,238 --> 00:10:17,698
‫تراجع رجاءً‬

183
00:10:18,825 --> 00:10:20,284
‫اعذرني‬

184
00:10:20,534 --> 00:10:23,245
‫إن طردته من هنا‬
‫عليه إيجاد مكان آمن‬

185
00:10:23,996 --> 00:10:26,790
‫مكان يختبئ به‬
‫حيث لا يجده التغيير‬

186
00:10:27,416 --> 00:10:28,876
‫أين ذهب؟‬

187
00:10:50,022 --> 00:10:51,565
{\an8}‫أجل، إنّه هنا على اليمين‬

188
00:10:52,024 --> 00:10:53,734
‫كان أسعد في غرفة أصغر‬

189
00:10:53,901 --> 00:10:55,360
‫أجل، أراهن على ذلك‬

190
00:10:55,486 --> 00:10:58,530
‫المعذرة، هناك لهجة عنف بكلامك‬
‫لا داعي لها‬

191
00:10:58,655 --> 00:11:00,532
‫- ما سبب ذلك؟‬
‫- يحاول القيام بعمله وحسب‬

192
00:11:02,389 --> 00:11:04,892
‫أعرف أنّ (ترافيس تينانت)‬
‫هو المتهم الأول‬

193
00:11:05,017 --> 00:11:07,811
‫ولكن (جيريمي) ليس حزيناً حالياً‬

194
00:11:08,479 --> 00:11:10,647
‫سأبحث بأمر (هيل)‬
‫لأرى ما يمكنني إيجاده‬

195
00:11:10,939 --> 00:11:13,817
‫كيف نعرف أنّ الابن ليس ميتاً؟‬
‫ربما قتل كلاهما‬

196
00:11:14,109 --> 00:11:15,778
‫المزيد من النقود له في الوصية‬

197
00:11:16,487 --> 00:11:17,946
‫أهناك أخبار من جهة العمل؟‬

198
00:11:18,071 --> 00:11:20,574
‫المنجمة كانت محقة‬
‫كل فنان خداع من الطراز الرفيع‬

199
00:11:20,699 --> 00:11:23,160
‫وجميع الطفيليات الاجتماعية‬
‫حاولوا استغلال (روزماري)‬

200
00:11:23,744 --> 00:11:25,954
‫جميعهم رجال أعمال، ليسوا مجرمين‬

201
00:11:26,705 --> 00:11:28,791
‫- تبدو هذه هي‬
‫- الابنة‬

202
00:11:29,291 --> 00:11:31,960
‫الآنسة (تينانت)، أنا العميلة‬
‫(ليزبون)، شكراً لمجيئك‬

203
00:11:32,252 --> 00:11:33,921
‫جئت بأسرع وقت ممكن‬

204
00:11:34,922 --> 00:11:36,507
‫هل وجدتم أخي؟‬

205
00:11:37,049 --> 00:11:38,509
‫تفضلي بالجلوس رجاءً‬

206
00:11:40,844 --> 00:11:42,513
‫نحن آسفون جداً لخسارتك‬

207
00:11:43,055 --> 00:11:46,099
‫للإجابة على سؤالك، لا‬
‫ما زال (ترافيس) مفقوداً‬

208
00:11:46,725 --> 00:11:48,852
‫نفعل ما بوسعنا لإيجاده‬

209
00:11:50,729 --> 00:11:54,399
‫هلاّ تحدثينا عن أمك‬
‫أيّ معلومة قد تساعدنا‬

210
00:11:55,067 --> 00:11:56,735
‫لا أصدق أنّها رحلت‬

211
00:11:59,071 --> 00:12:01,156
‫كانت شخصاً صالحاً‬

212
00:12:02,324 --> 00:12:03,951
‫أحبها الجميع و...‬

213
00:12:05,202 --> 00:12:07,371
‫موتها بتلك الطريقة...‬

214
00:12:09,456 --> 00:12:11,708
‫عند النفايات، هذا فظيع‬

215
00:12:11,875 --> 00:12:14,086
‫يقول الناس إنّها تغيرت‬
‫بعد وفاة والدك‬

216
00:12:15,045 --> 00:12:16,505
‫إنّها...‬

217
00:12:17,089 --> 00:12:18,590
‫فقدت السيطرة نوعاً ما‬

218
00:12:20,425 --> 00:12:21,885
‫أبي كان...‬

219
00:12:22,761 --> 00:12:24,429
‫يحافظ على نظام كل شيء‬

220
00:12:25,138 --> 00:12:26,598
‫وهي فقط...‬

221
00:12:27,224 --> 00:12:29,726
‫- لم تكن ذلك الشخص‬
‫- هلاّ تعطينا مثالاً‬

222
00:12:33,230 --> 00:12:34,773
‫حين كنت بالجامعة...‬

223
00:12:36,275 --> 00:12:38,193
‫اتصل أخي ليقول لي إنّ...‬

224
00:12:38,902 --> 00:12:40,612
‫هناك من يسرقنا‬

225
00:12:41,029 --> 00:12:45,075
‫وأمي ستستثمر بخطط سيئة متتالية‬

226
00:12:45,450 --> 00:12:47,494
‫حاولت تحذيرها‬
‫ولكنّها رفضت الاستماع لي‬

227
00:12:48,453 --> 00:12:50,581
‫متأكد أنّها ظنت‬
‫أنّها كانت تقوم بالأمر الصحيح‬

228
00:12:51,707 --> 00:12:53,542
‫هل لهذا بدأ أخوكِ يفقد صوابه؟‬

229
00:12:54,585 --> 00:12:56,169
‫اشتاق لأبي كثيراً‬

230
00:12:58,171 --> 00:12:59,965
‫وفجأة...‬

231
00:13:01,174 --> 00:13:02,801
‫أصبح الرجل المسؤول عن البيت‬

232
00:13:03,594 --> 00:13:05,387
‫وأعتقد أنّه لم يكن معتاداً‬
‫على الأمر‬

233
00:13:08,473 --> 00:13:10,142
‫وحينها انتقل (جيريمي) للعيش معنا‬

234
00:13:11,977 --> 00:13:16,440
‫- وهو مخيف، إنّه خطير جداً‬
‫- كيف هو خطير؟‬

235
00:13:16,565 --> 00:13:19,192
‫يود الحصول علامَ يريده‬
‫وهو عصبي جداً‬

236
00:13:20,402 --> 00:13:21,945
‫كنت قلقةً على أمي‬

237
00:13:24,156 --> 00:13:26,700
‫(كلارا)، أين يختبئ (ترافيس)‬
‫بحسب اعتقادك؟‬

238
00:13:27,117 --> 00:13:29,244
‫لو كنت أعرف لكنت معه الآن‬

239
00:13:31,496 --> 00:13:32,998
‫إنّه أخي، إنّه...‬

240
00:13:34,374 --> 00:13:35,876
‫إنّه كل ما تبقى لي‬

241
00:13:37,794 --> 00:13:39,838
‫هلا تسجلين رقمه هنا رجاءً‬

242
00:13:40,380 --> 00:13:43,508
‫- لن يعاود الاتصال بك‬
‫- أجل، سجليه وحسب‬

243
00:13:47,763 --> 00:13:49,222
‫شكراً‬

244
00:13:57,522 --> 00:14:03,028
‫مرحباً يا (ترافيس)، لا تعرفني‬
‫ولكنّ اسمي (باتريك جين)، أنا صديق‬

245
00:14:03,153 --> 00:14:06,448
‫أعرف أنّك واقع بمشكلة الآن‬
‫وأود أن أعرض عليك راحة البال‬

246
00:14:07,074 --> 00:14:09,201
‫ولكن لا أعرف ما تعنيه‬
‫راحة البال بالنسبة لك‬

247
00:14:09,826 --> 00:14:12,704
‫الأمر مختلف للجميع‬
‫أحب امتطاء الخيول مثلاً‬

248
00:14:13,330 --> 00:14:15,624
‫لا أعرف إن كانت الخيول ستسعدك‬

249
00:14:15,958 --> 00:14:17,709
‫لمَ قد لا تسعدك الخيول؟‬

250
00:14:18,085 --> 00:14:21,546
‫فكر مراراً وتكراراً حتى تتأكد‬

251
00:14:21,880 --> 00:14:24,341
‫واذهب لذلك المكان‬
‫حيث تعرف أنّك سعيد‬

252
00:14:25,050 --> 00:14:27,219
‫واتصل بي، لديك رقمي‬

253
00:14:29,137 --> 00:14:30,806
‫ما كان ذلك؟‬

254
00:14:31,723 --> 00:14:33,308
‫بسرعة، أيّ صور خطرت ببالك؟‬

255
00:14:34,810 --> 00:14:38,689
‫أقول فقط إنّه لا يمكنك إنكار‬
‫وجود المنجمين لعدم التقائك بأحدهم قط‬

256
00:14:39,064 --> 00:14:41,692
‫أجل، لم يسبق أن رأيت حماراً وحشياً‬
‫ولكن ذلك لا يعني أنّها غير موجودة‬

257
00:14:41,817 --> 00:14:43,235
‫- لم ترَ حماراً وحشياً؟‬
‫- لا‬

258
00:14:43,360 --> 00:14:44,736
‫ألم تذهب إلى حديقة حيوانات؟‬

259
00:14:44,861 --> 00:14:47,364
‫لا أفهم حدائق الحيوانات‬
‫تدفع النقود للنظر إلى الحيوانات، لماذا؟‬

260
00:14:50,993 --> 00:14:54,037
‫- أيّها الرفاق‬
‫- هذا هو‬

261
00:14:54,788 --> 00:14:58,291
‫- (جين)، لن أشك بقدراتك أبداً‬
‫- أسبق أن شككت بقدراتي؟‬

262
00:15:33,660 --> 00:15:37,581
‫انتظر يا (ترافيس)‬
‫انتظر وحسب‬

263
00:15:46,435 --> 00:15:49,229
‫(ترافيس)، نعلم لمَ هربت‬

264
00:15:49,563 --> 00:15:51,648
‫نعرف بأمر مشاجرتك مع (جيريمي)‬

265
00:15:51,857 --> 00:15:54,109
‫لمَ لم تتصل بأحد؟‬
‫لمَ هربت وحسب؟‬

266
00:15:54,276 --> 00:15:56,069
‫لأنّه لم يكن بإمكانهم‬
‫فعل أيّ شيء‬

267
00:15:57,487 --> 00:16:00,115
‫- لا أريد التسبب بمشاكل أخرى‬
‫- تتسبب بمشاكل أخرى؟‬

268
00:16:00,240 --> 00:16:01,908
‫لمن؟ إنّهم أسرتك‬

269
00:16:02,075 --> 00:16:03,994
‫أنتم لا تفهمون حقاً‬

270
00:16:05,954 --> 00:16:10,208
‫انظروا، أحب أمي كثيراً‬

271
00:16:10,959 --> 00:16:13,670
‫"ولكن بعد المشاجرة مع (جيريمي)‬
‫لم أتمكن من العودة"‬

272
00:16:13,879 --> 00:16:15,338
‫"كان ذلك مستحيلاً"‬

273
00:16:16,465 --> 00:16:19,509
‫- متى يمكنني رؤيته؟‬
‫- قريباً‬

274
00:16:19,801 --> 00:16:22,387
‫- "أين ذهبت إذن؟"‬
‫- "إلى بيوت أصدقائي غالباً"‬

275
00:16:23,013 --> 00:16:24,514
‫نحتاج إلى أسماء وعناوين‬

276
00:16:26,767 --> 00:16:29,352
‫ربما لو كنت في المنزل في تلك الليلة‬

277
00:16:29,936 --> 00:16:31,605
‫لكانت ما زالت حية...‬

278
00:16:32,481 --> 00:16:34,733
‫- ربما...‬
‫- إليك الحقيقة يا (ترافيس)‬

279
00:16:34,983 --> 00:16:37,986
‫بعد أن مات والدك‬
‫تخلت أمك عن الكثير من نقودكم‬

280
00:16:38,403 --> 00:16:41,323
‫ثم أحضرت (جيريمي) إلى المنزل‬
‫وجعلت حياتك تعيسة‬

281
00:16:41,531 --> 00:16:44,117
‫مع أنّك هربت‬
‫علمت أين ستكون في تلك الليلة‬

282
00:16:44,409 --> 00:16:47,579
‫- علمت أنّها ستعود إلى المنزل مشياً‬
‫- أتقولان إنّي فعلت هذا؟‬

283
00:16:51,750 --> 00:16:53,877
‫حين مات أبي‬
‫كانت أمي هي كل ما تبقى لي‬

284
00:16:54,920 --> 00:16:57,005
‫ألا تظنان أنّي أردت‬
‫أن أدعمها؟‬

285
00:16:58,048 --> 00:17:02,385
‫انتقل (جيريمي) الحقير إلى منزلنا‬
‫وبدأ بإصدار الأوامر‬

286
00:17:03,595 --> 00:17:05,055
‫كانت أمي‬

287
00:17:05,680 --> 00:17:07,140
‫لم أقتلها‬

288
00:17:08,767 --> 00:17:10,227
‫أصدقه‬

289
00:17:13,146 --> 00:17:14,523
‫تعالي‬

290
00:17:21,905 --> 00:17:23,365
‫سنكون بخير‬

291
00:17:23,949 --> 00:17:25,408
‫ستكون الأمور على ما يرام‬

292
00:17:35,710 --> 00:17:37,712
‫- (ترافيس) يتألم‬
‫- أو أنّه يكذب‬

293
00:17:37,838 --> 00:17:41,091
‫دعونا لا ننسى أنّ (جيريمي هايل)‬
‫كان سيرث عدة ملايين لنفسه‬

294
00:17:41,216 --> 00:17:43,135
‫وربما أراد تسريع العملية‬

295
00:17:43,677 --> 00:17:46,847
‫ليمول جلسة تصوير مطولة‬
‫في (أمريكا الجنوبية)‬

296
00:17:47,222 --> 00:17:50,725
‫- ويختبئ لبعض الوقت‬
‫- سمعت من محامي (روزماري)‬

297
00:17:50,851 --> 00:17:52,477
‫احزروا من أضافت مؤخراً إلى وصيتها‬

298
00:17:52,644 --> 00:17:54,104
‫(كرستينا فراي)؟‬

299
00:17:54,271 --> 00:17:55,730
‫لم يجف الحبر بعد‬

300
00:17:55,981 --> 00:17:58,733
‫قالت (كرستينا) إنّها علمت مسبقاً‬
‫أنّ (روزماري) بخطر‬

301
00:17:59,067 --> 00:18:00,735
‫لمَ قد تخبرنا بذلك‬
‫إن كانت مذنبة؟‬

302
00:18:00,861 --> 00:18:02,612
‫كم ذلك عبقري‬

303
00:18:03,196 --> 00:18:05,198
‫لتجعلنا نستبعدها كمشتبه بها‬

304
00:18:05,657 --> 00:18:07,409
‫لأنّها جعلت نفسها تبدو‬
‫كالمشتبه بها‬

305
00:18:07,534 --> 00:18:09,661
‫أو ربما، ربما فقط...‬

306
00:18:09,911 --> 00:18:12,247
‫لديها موهبة نادرة وثمينة‬
‫وتحاول مساعدتنا‬

307
00:18:12,706 --> 00:18:14,332
‫موهبتها النادرة والثمينة‬

308
00:18:15,083 --> 00:18:16,543
‫أخبريني‬

309
00:18:17,294 --> 00:18:18,753
‫من يحصل على هذه الموهبة‬
‫بأيّة حال؟‬

310
00:18:19,212 --> 00:18:22,299
‫ولمَ لا يملك أحد موهبة‬
‫معرفة نتائج سباق الخيول؟‬

311
00:18:22,424 --> 00:18:25,010
‫ولمَ لا يقول الأموات‬
‫سوى الهراء الممل؟‬

312
00:18:25,135 --> 00:18:27,429
‫كن لطيفاً، من حق (فان بيلت)‬
‫أن يكون لها رأيها الخاص‬

313
00:18:27,596 --> 00:18:29,639
‫ليس إن كان خاطئاً‬
‫هذا كالإيمان بأرنب عيد الفصح‬

314
00:18:29,764 --> 00:18:31,224
‫من قال إنّه غير حقيقي؟‬

315
00:18:33,852 --> 00:18:35,312
‫(فان بيلت)‬

316
00:18:35,854 --> 00:18:37,314
‫مرحباً‬

317
00:18:38,273 --> 00:18:41,234
‫شكراً، فهمت، سآتي فوراً‬

318
00:18:42,444 --> 00:18:44,988
‫إنّها (كرستينا)‬
‫قالت إنّها تلتقط شيئاً ما‬

319
00:18:46,406 --> 00:18:47,866
‫شيء قد يساعدنا‬

320
00:18:48,617 --> 00:18:51,786
‫- لمَ لا تذهبين للتحدث إليها؟‬
‫- سآتي معك‬

321
00:18:52,287 --> 00:18:54,664
‫- أعليه المجيء؟‬
‫- علينا معرفة إن كانت تخدعنا‬

322
00:18:54,789 --> 00:18:56,249
‫لا تخدعنا، يمكنني معرفة ذلك‬

323
00:18:57,417 --> 00:18:58,877
‫أحسن التصرف‬

324
00:19:01,963 --> 00:19:04,841
‫- السيدة (فراي)؟‬
‫- "سآتي فوراً، تفضلوا بالجلوس"‬

325
00:19:05,258 --> 00:19:06,801
‫السيدة (زولتار) ترحب بك‬

326
00:19:16,186 --> 00:19:17,646
‫أشم رائحة الموتى‬

327
00:19:18,480 --> 00:19:19,940
‫(جين)‬

328
00:19:32,494 --> 00:19:34,537
‫انظري، يمكنك التسوق للإجازات هنا‬

329
00:19:34,663 --> 00:19:36,790
‫ألست مهتماً ولو قليلاً‬
‫بما ستقوله؟‬

330
00:19:36,915 --> 00:19:38,625
‫لا، أحب المرآة‬

331
00:19:39,084 --> 00:19:40,835
‫موقعها مناسب جداً، أليس كذلك؟‬

332
00:19:41,086 --> 00:19:42,545
‫ماذا تعني؟‬

333
00:19:42,671 --> 00:19:44,130
‫إنّه زجاج من جهة واحدة‬

334
00:19:44,256 --> 00:19:45,715
‫خدعة كتب الاستبصار‬

335
00:19:45,840 --> 00:19:48,343
‫تدرس لغة جسد زبائنها‬
‫قبل أن يدخلوا‬

336
00:19:55,058 --> 00:19:56,851
‫هيّا، إنّها تشاهدنا الآن‬
‫على الأغلب‬

337
00:19:57,143 --> 00:19:59,437
‫- لا يمكنك الدخول‬
‫- بالطبع يمكنني ذلك‬

338
00:20:00,313 --> 00:20:01,773
‫(جين)‬

339
00:20:04,567 --> 00:20:06,444
‫أرأيت؟ ليس زجاجاً‬
‫من جهة واحدة‬

340
00:20:06,653 --> 00:20:09,614
‫ربما بهذه اللحظة‬
‫ولكن ليس كملاحظة عامة‬

341
00:20:09,823 --> 00:20:11,283
‫هلاّ نجلس‬

342
00:20:16,121 --> 00:20:17,497
‫بالطبع‬

343
00:20:18,915 --> 00:20:22,085
‫- أتعرفين ما لا أفهمه؟‬
‫- أعلمني‬

344
00:20:22,627 --> 00:20:26,840
‫تتحدثين عن عمل رفيع الطراز‬
‫ولكنّ معبدك...‬

345
00:20:27,048 --> 00:20:29,759
‫يبدو كمتجر تذكارات بتخفيضات‬
‫في (شانغري لا)‬

346
00:20:31,136 --> 00:20:33,638
‫هناك صورة معينة‬
‫تصاحب هذا العمل، تعرف ذلك‬

347
00:20:34,723 --> 00:20:36,599
‫يتوقع الناس هذه الأجواء‬

348
00:20:37,142 --> 00:20:39,269
‫كالبدلة اللامعة التي كنت ترتديها‬

349
00:20:40,103 --> 00:20:45,400
‫يتأسف لكل الألم الذي سببته‬
‫لكِ ولأمك‬

350
00:20:46,192 --> 00:20:47,694
‫إنّها دموع الفرحة‬

351
00:20:48,320 --> 00:20:50,864
‫- إذن بحثتِ بأمري‬
‫- أجل، الآن‬

352
00:20:51,156 --> 00:20:53,700
‫قتل (ريد جون) أسرتك‬
‫آسفة جداً لخسارتك‬

353
00:20:54,743 --> 00:20:56,703
‫- ألهذا تخليت عن وحيك؟‬
‫- وحيي؟‬

354
00:20:57,746 --> 00:21:00,498
‫- أهذا هو ما في الأمر؟‬
‫- أجل، وحي، موهبة‬

355
00:21:00,623 --> 00:21:02,751
‫كما تريد، لا شك بأنّك تملكها‬
‫لمَ تخليت عنها؟‬

356
00:21:02,876 --> 00:21:04,961
‫بسبب البدلات، مؤلمة وفظيعة‬

357
00:21:05,920 --> 00:21:08,882
‫- تتفادى المواضيع دائماً، لماذا؟‬
‫- لا تحاولي قراءتي‬

358
00:21:09,090 --> 00:21:11,468
‫- لا أعرف كيف‬
‫- كلانا يعرف أنّ تلك كذبة‬

359
00:21:12,052 --> 00:21:14,346
‫أيمكننا التحدث عن القضية؟‬

360
00:21:16,056 --> 00:21:17,515
‫- أجل‬
‫- أجل‬

361
00:21:18,516 --> 00:21:20,810
‫إذن، هل تواصلت معكِ (روزماري)؟‬

362
00:21:21,269 --> 00:21:22,896
‫لا، ليس بعد‬

363
00:21:23,980 --> 00:21:27,025
‫يتطلب الأمر وقتاً بالعادة‬
‫لتنتقل الأرواح تماماً‬

364
00:21:27,192 --> 00:21:29,277
‫أجل، الحافلة السماوية تأخرت‬

365
00:21:30,445 --> 00:21:33,114
‫اتصلت لأعرض عليكم مساعدتي‬
‫من الواضح أنّكم غير مهتمين‬

366
00:21:33,281 --> 00:21:36,493
‫لحظة‬
‫أنا العميلة هنا‬

367
00:21:36,659 --> 00:21:38,119
‫نحن مهتمون‬

368
00:21:38,995 --> 00:21:41,581
‫شاهدت رؤيا حول السيارة‬
‫التي استخدمت لقتل (روزماري)‬

369
00:21:45,377 --> 00:21:48,088
‫الماء يندفق باتجاه النوافذ‬
‫والأعجال تحت الماء‬

370
00:21:48,380 --> 00:21:50,590
‫- ثابتة على الخرسانة‬
‫- الخرسانة؟‬

371
00:21:51,383 --> 00:21:53,968
‫- كالمسبح؟‬
‫- أكبر‬

372
00:21:55,136 --> 00:21:56,596
‫خزان ربما‬

373
00:21:56,805 --> 00:21:58,640
‫هناك بحيرة خارج المدينة‬

374
00:21:59,099 --> 00:22:01,393
‫أجل، خزان‬

375
00:22:28,628 --> 00:22:30,088
‫شكراً‬

376
00:22:31,965 --> 00:22:34,926
‫شكل الحطام الأمامي‬
‫يطابق ضربة سيارة بأحد المشاة‬

377
00:22:35,051 --> 00:22:38,096
‫وإليكِ هذا، رقم السيارة‬
‫يطابق رقم سيارة (روزماري)‬

378
00:22:38,263 --> 00:22:40,557
‫- هذه سيارتها؟‬
‫- أجل، هناك مخالفتان‬

379
00:22:40,682 --> 00:22:42,350
‫مما يدل على أنّ (ترافيس)‬
‫استخدم السيارة طيلة الوقت‬

380
00:22:42,600 --> 00:22:44,602
‫ربما (جيريمي) أيضاً‬
‫كان يمكنه استخدامها‬

381
00:22:44,853 --> 00:22:46,729
‫لنر إذا كان أحدهما في السيارة تلك الليلة‬

382
00:22:47,063 --> 00:22:49,274
‫كاميرات المرور، شهود في محطات الوقود‬

383
00:22:49,399 --> 00:22:51,109
‫- أود أن أعلم إن وجدت‬
‫- سأعمل على الأمر‬

384
00:22:53,403 --> 00:22:56,406
‫أستعتقلون (ترافيس تينانت)‬
‫أم تودون أن نفعل ذلك؟‬

385
00:22:56,573 --> 00:22:59,534
‫أعتذر أيّها المحقق‬
‫ولكن كل ما لدينا الآن عرضي‬

386
00:22:59,659 --> 00:23:02,287
‫أتبع حدسي ٩٠ بالمائة من الوقت‬

387
00:23:02,412 --> 00:23:04,289
‫أشعر أنّه صحيح ومقدر‬

388
00:23:04,706 --> 00:23:06,291
‫ماذا عن الـ١٠ بالمائة الباقية؟‬

389
00:23:11,045 --> 00:23:13,047
‫إن كان يجب اعتقال أحد‬
‫فهي (كرستينا فراي)‬

390
00:23:13,673 --> 00:23:15,383
‫كانت تعرف أنّ (روزماري) بخطر‬

391
00:23:15,675 --> 00:23:18,344
‫عرفت مكان السيارة‬
‫والتي هي سلاح الجريمة‬

392
00:23:18,887 --> 00:23:21,764
‫مما يعني إنّه إما لديها‬
‫قدرات خارقة للطبيعة‬

393
00:23:21,890 --> 00:23:23,391
‫أو أنّها متورطة بالجريمة‬

394
00:23:23,516 --> 00:23:26,811
‫هيّا، قامت ببساطة بما تبرع به‬

395
00:23:26,936 --> 00:23:29,105
‫خمنت تخميناً مدروساً‬
‫ببعض الثقة‬

396
00:23:29,314 --> 00:23:31,024
‫أين سترمي بسيارة في المنطقة‬
‫غير هنا؟‬

397
00:23:31,441 --> 00:23:32,901
‫إنّها مخمنة بارعة‬

398
00:23:33,568 --> 00:23:36,446
‫أعتقد أنّ هذا احتمال أيضاً‬

399
00:23:37,572 --> 00:23:39,824
‫أجل، وهذا هو ما تعترض عليه‬
‫أليس كذلك؟‬

400
00:23:40,116 --> 00:23:42,911
‫ليس أنّها مخادعة‬
‫بل أنّها بارعة بذلك‬

401
00:23:43,536 --> 00:23:45,455
‫- ربما أفضل منك حتى‬
‫- لا، مطلقاً‬

402
00:23:45,872 --> 00:23:47,999
‫حسناً، أجل‬

403
00:23:49,918 --> 00:23:51,753
‫ليست أفضل منّي بالطبع‬
‫ولكنّها بارعة‬

404
00:23:53,004 --> 00:23:55,131
‫والبارعون هم الأشد خطراً‬

405
00:23:56,925 --> 00:24:02,972
‫المعذرة، ربما تعتبر احتمال كونها‬
‫حقاً متصلةً بشيء يفوق فهمك‬

406
00:24:03,223 --> 00:24:06,809
‫سيكون ذلك الغولف والمسرح الموسيقي‬
‫للثلاثينيات والأربعينيات‬

407
00:24:07,393 --> 00:24:08,937
‫السيارة فارغة باستثناء هذا‬
‫في صندوق السيارة‬

408
00:24:10,522 --> 00:24:13,858
‫- نايلون مغلف بجودة عالية‬
‫- كالذي يستخدمونه بمختبرات الصور‬

409
00:24:17,820 --> 00:24:20,323
‫رحل (جيريمي)، تحدثنا...‬

410
00:24:20,490 --> 00:24:23,701
‫وقلت له ألاّ يعود‬
‫وبعض مجوهرات أمي مفقودة‬

411
00:24:24,118 --> 00:24:26,454
‫- أتعتقدون حقاً أنّه الفاعل؟‬
‫- سرق أحدهم سيارة أمكما‬

412
00:24:26,579 --> 00:24:28,039
‫واستخدمها ليقتلها‬

413
00:24:28,164 --> 00:24:29,832
‫ولكن لم تفتح الأقفال بالقوة‬
‫كان لدى الشخص المفاتيح‬

414
00:24:30,083 --> 00:24:32,877
‫وتعتقد أنّي الفاعل، انظر‬
‫أخبرتك أين كنت‬

415
00:24:33,086 --> 00:24:34,879
‫اذهبوا وتحدثوا لأصدقائي‬

416
00:24:35,171 --> 00:24:37,966
‫فعلنا ذلك، قالوا إنّه كان‬
‫هناك الكثيرون في الحفلة تلك الليلة‬

417
00:24:38,091 --> 00:24:40,218
‫- كان يمكنك المغادرة والعودة‬
‫- هذا غير عادل‬

418
00:24:41,219 --> 00:24:45,557
‫أخي محق، (جيريمي) غادر لتوه‬
‫لا بد أنّه يخفي شيئاً ما‬

419
00:24:45,974 --> 00:24:47,433
‫(ليزبون)‬

420
00:24:49,894 --> 00:24:51,354
‫ابقوا هنا‬

421
00:24:53,231 --> 00:24:56,192
‫(ريغسبي)، هذه أنا‬
‫أريد تتبع (جيريمي هيل)‬

422
00:24:56,317 --> 00:24:58,403
‫تحققوا من المطارات‬
‫سبقنا بساعتين على الأغلب‬

423
00:24:58,528 --> 00:25:00,488
‫لم يصل لذلك البعد‬
‫ليس على متن طائرة‬

424
00:25:01,698 --> 00:25:03,741
‫- كيف تعرف ذلك؟‬
‫- ترك الكثير وراءه‬

425
00:25:04,993 --> 00:25:07,203
‫غرفة مليئة بالصور‬
‫خمسة منها لـ(روزماري)‬

426
00:25:07,328 --> 00:25:08,913
‫والبقية يعود تاريخها‬
‫لقبل سنة على الأقل‬

427
00:25:09,038 --> 00:25:10,498
‫باستثناء...‬

428
00:25:13,626 --> 00:25:15,086
‫هذه‬

429
00:25:15,712 --> 00:25:17,463
‫أخذت هذه قبل عدة أسابيع‬

430
00:25:17,755 --> 00:25:21,009
‫جديدة، محطمة قليلاً‬
‫ولكنّها حميمية قليلاً‬

431
00:25:23,761 --> 00:25:25,805
‫كعب امرأة سيتسبب بثقب كهذا‬

432
00:25:26,306 --> 00:25:28,516
‫- أجل؟‬
‫- بما أنّنا بمنزل (روزماري)‬

433
00:25:28,641 --> 00:25:30,143
‫يمكننا افتراض أنّه يعود لها‬

434
00:25:30,768 --> 00:25:32,228
‫أكمل الشرح‬

435
00:25:32,437 --> 00:25:35,898
‫لمَ قد تود (روزماري) وضع‬
‫كعبها بصورة الشابة الجميلة هذه‬

436
00:25:36,190 --> 00:25:38,610
‫والتي التقطها حبيبها‬
‫زير النساء (جيريمي)؟‬

437
00:25:47,994 --> 00:25:50,288
‫- أتعرفانها؟‬
‫- أجل، إنّها...‬

438
00:25:50,413 --> 00:25:53,458
‫(كوني أدامز)، ابنة شريك أمي‬
‫بلعبة الورق‬

439
00:25:53,666 --> 00:25:55,126
‫(كوني)‬

440
00:26:21,486 --> 00:26:23,446
‫- (كوني)؟‬
‫- أيمكنني مساعدتكما؟‬

441
00:26:23,863 --> 00:26:25,323
‫عقد جميل‬

442
00:26:25,448 --> 00:26:29,369
‫نحن الشرطة، نبحث عن (جيريمي هيل)‬
‫هل هو هنا؟‬

443
00:26:30,244 --> 00:26:31,704
‫عزيزي‬

444
00:26:33,373 --> 00:26:34,832
‫مرحباً يا (جيريمي)‬

445
00:26:34,957 --> 00:26:36,626
‫- مرحباً‬
‫- فلنذهب للتحدث‬

446
00:26:37,251 --> 00:26:39,629
‫- قد تود بعض الملابس‬
‫- أو المزيد من الكريمة المخفوقة‬

447
00:26:40,282 --> 00:26:41,742
‫اختر ما تشاء‬

448
00:26:46,912 --> 00:26:50,165
‫قتل (روزماري) شخص كان يقود‬
‫إحدى سياراتها‬

449
00:26:51,959 --> 00:26:53,418
‫حسناً‬

450
00:26:56,380 --> 00:26:58,757
‫سيارة (كرايزلر) فضية‬
‫أسبق أن قدت هذه السيارة؟‬

451
00:26:59,091 --> 00:27:01,718
‫لا، هذه هي السيارة‬
‫التي كان (ترافيس) يقودها‬

452
00:27:03,762 --> 00:27:05,639
‫- ليست ما أفضله‬
‫- إليك الأمر‬

453
00:27:05,764 --> 00:27:08,100
‫وجدنا قفازاً بالسيارة من مختبرك‬

454
00:27:08,225 --> 00:27:10,185
‫ما احتمال أن نجد‬
‫حمضك النووي عليه؟‬

455
00:27:10,310 --> 00:27:12,688
‫- كان يمكن أن يأخذه (ترافيس)‬
‫- (ترافيس) لديه حجة غياب‬

456
00:27:12,813 --> 00:27:14,898
‫ربما اخترت هذه السيارة‬
‫لتجعله محط الشك‬

457
00:27:15,023 --> 00:27:16,525
‫أجل، أعتقد ذلك‬

458
00:27:16,650 --> 00:27:19,403
‫- ولكنّي لم أفعل‬
‫- غادرت منزل (تينانت) بسرعة‬

459
00:27:19,653 --> 00:27:21,280
‫وكأنّك كنت تهرب‬

460
00:27:21,697 --> 00:27:24,032
‫- لمَ فعلت ذلك؟‬
‫- تشاجرت مع الولدين‬

461
00:27:24,408 --> 00:27:27,160
‫(كلارا) مجنونة‬
‫ظننتها ستهجم عليّ‬

462
00:27:27,286 --> 00:27:29,913
‫- يعتقدان أنّك قتلت أمهما‬
‫- لا يعرفان أيّ شيء عنّي‬

463
00:27:30,873 --> 00:27:33,250
‫- كنت أحبها‬
‫- بالطبع فعلت‬

464
00:27:33,750 --> 00:27:36,795
‫لذلك أعطيت قلادة (روزماري)‬
‫لصديقتك المثيرة الجديدة‬

465
00:27:36,962 --> 00:27:38,755
‫لم تعد تفيد (روزماري)‬
‫أليس كذلك؟‬

466
00:27:39,131 --> 00:27:41,049
‫أطلقوا النار عليّ‬
‫أنا براغماتي‬

467
00:27:41,216 --> 00:27:42,676
‫هذه كلمة جيدة‬

468
00:27:44,219 --> 00:27:46,805
‫(ميامي)، (نيويورك)، (شيكاغو)‬

469
00:27:47,264 --> 00:27:50,100
‫جميعهن أرامل وساعدنك بمهنتك‬

470
00:27:50,350 --> 00:27:53,687
‫وكل منهن حية وبخير‬
‫وما زلن صديقاتي إن أردتِ التحدث إليهن‬

471
00:27:54,104 --> 00:27:58,108
‫قد تكون (فيبي) مترددةً قليلاً‬
‫بشأني ولكن...‬

472
00:27:59,151 --> 00:28:00,611
‫الأخريات...‬

473
00:28:02,070 --> 00:28:03,530
‫أتعرف (كرستينا فراي)؟‬

474
00:28:05,240 --> 00:28:06,783
‫هذا الاسم مألوف ولكن لا‬

475
00:28:07,409 --> 00:28:09,745
‫- لا أعتقد ذلك‬
‫- إنّها منجمة (روزماري)‬

476
00:28:10,704 --> 00:28:13,415
‫وأعتقد أنّك التقيت بها‬
‫التقطت صورةً لها‬

477
00:28:13,540 --> 00:28:15,876
‫قالت (جين) إنّ أحد صورك‬
‫معلقة في ردهتها‬

478
00:28:16,126 --> 00:28:17,711
‫آخذ الكثير من الصور‬

479
00:28:19,296 --> 00:28:22,925
‫شخصان مستفيدان في نفس الوصية‬
‫وكلاهما مقربين من (روزماري)‬

480
00:28:23,050 --> 00:28:24,968
‫ولكنكما لم تلتقيا من قبل‬

481
00:28:25,594 --> 00:28:27,054
‫ما احتمال ذلك؟‬

482
00:28:30,641 --> 00:28:32,100
‫أريد محامياً‬

483
00:28:39,232 --> 00:28:40,776
‫تحققي من هذا أيتها الرئيسة‬

484
00:28:44,112 --> 00:28:45,572
‫معلومات حول (كرستينا فراي)‬

485
00:28:46,239 --> 00:28:48,825
‫في آخر ١٠ سنوات‬
‫كل هؤلاء تركوا اسمها في وصياتهم‬

486
00:28:49,284 --> 00:28:51,578
‫تتراوح الأرقام‬
‫بين ١٠ و٢٠٠ ألف دولار‬

487
00:28:51,703 --> 00:28:54,873
‫ربما كان هناك علاقة عمل‬
‫بين المنجمة و(جيريمي)‬

488
00:28:55,457 --> 00:28:57,793
‫- يستغلان النساء الضعيفات‬
‫- ربما كان (جين) محقاً إذن‬

489
00:28:57,918 --> 00:28:59,378
‫هذا لا يثبت أيّ شيء‬

490
00:28:59,795 --> 00:29:02,130
‫ولكنّها نقطة جيدةً‬
‫لبدء حوار مع (فراي)‬

491
00:29:06,885 --> 00:29:08,470
‫كيف هي معرفتك بـ(جيريمي هيل)‬
‫يا (كرستينا)؟‬

492
00:29:09,680 --> 00:29:11,139
‫كان حبيب (روزماري)‬

493
00:29:12,307 --> 00:29:15,268
‫شخص مستغل برأيي‬
‫ولكنّه أعجب بها حقاً باعتقادي‬

494
00:29:15,435 --> 00:29:17,562
‫مصور جيد، أخذ لي صورة‬

495
00:29:18,146 --> 00:29:20,107
‫أتعرفين أنّه كان مذكوراً‬
‫في وصية الضحية أيضاً؟‬

496
00:29:20,315 --> 00:29:23,527
‫إن كان ذلك قرار (روزماري)‬
‫فلا بأس، ولكن ما قصدك؟‬

497
00:29:23,652 --> 00:29:26,321
‫خلال العقد الماضي، ٥ أشخاص‬
‫مختلفون ذكروكِ في وصياتهم‬

498
00:29:26,989 --> 00:29:28,782
‫ضد رغباتي الواضحة‬

499
00:29:29,199 --> 00:29:34,079
‫انظرا، ساعدت مئات الزبائن المرضى‬
‫بمواجهة خوفهم من الموت‬

500
00:29:34,371 --> 00:29:37,290
‫وأكدت لهم جميعاً أنّي سأحاول‬
‫التحدث إليهم بعد رحيلهم‬

501
00:29:37,416 --> 00:29:40,419
‫ولكنّي لم أطلب أيّ شيء‬
‫من أيّ منهم أبداً‬

502
00:29:40,627 --> 00:29:42,546
‫ولمَ توتر (جيريمي)‬
‫حين ذكر اسمك؟‬

503
00:29:43,296 --> 00:29:45,841
‫لأنّنا مارسنا الجنس عدة مرات‬
‫على الأغلب‬

504
00:29:46,967 --> 00:29:49,678
‫استمتعنا، رفقته ممتعة‬

505
00:29:53,140 --> 00:29:54,599
‫أتحدثتِ لـ(روزماري) بعد؟‬

506
00:29:55,350 --> 00:29:57,728
‫- أجل‬
‫- حقاً؟ ماذا قالت؟‬

507
00:29:57,894 --> 00:29:59,938
‫إنّها معجبة بك كثيراً‬

508
00:30:00,897 --> 00:30:07,029
‫قالت إنّك رجل صالح‬
‫"رجل ضال ومحطم جداً"‬

509
00:30:07,654 --> 00:30:09,114
‫ولكنّه صالح‬

510
00:30:09,239 --> 00:30:11,700
‫أشعر بالإطراء، أذكرت من قتلها؟‬

511
00:30:11,867 --> 00:30:13,744
‫لا، لم تعرف‬

512
00:30:14,369 --> 00:30:17,289
‫ولكنّها تود أن أستمر بمساعدتك‬
‫بقدر ما أستطيع‬

513
00:30:17,497 --> 00:30:21,293
‫بما أنّكِ ذكرتِ ذلك‬
‫أود سماع تسجيلات جلساتكما‬

514
00:30:21,543 --> 00:30:23,003
‫بالتأكيد‬

515
00:30:23,170 --> 00:30:26,131
‫أيمكنكِ جعل (روزماري)‬
‫تظهر عند قراءة الوصية؟‬

516
00:30:26,673 --> 00:30:29,801
‫إنّها روح راحلة، وليست مغنية‬
‫أعراس، لا يمكنك حجزها مسبقاً‬

517
00:30:30,343 --> 00:30:33,263
‫أعتقد أنّ الوقت لا يعني شيئاً‬
‫حين تكون ميتاً للأبد‬

518
00:30:33,472 --> 00:30:35,307
‫- لا جدول للمحافظة عليه‬
‫- لمَ العجلة؟‬

519
00:30:35,766 --> 00:30:37,225
‫أجل‬

520
00:30:52,240 --> 00:30:54,284
‫- مضرب جميل‬
‫- تلعب الـ(لاكروس)؟‬

521
00:30:55,035 --> 00:30:56,495
‫لا‬

522
00:30:56,620 --> 00:30:58,080
‫العصي التي تتحرك بسرعة تخيفني‬

523
00:30:58,455 --> 00:31:00,207
‫- هل اكتشفتم الفاعل؟‬
‫- ليس بعد‬

524
00:31:03,710 --> 00:31:06,004
‫- مرحباً، أوجدتم أيّ شيء؟‬
‫- مرحباً‬

525
00:31:08,715 --> 00:31:11,343
‫أعتقد أنّ (كرستينا فراي)‬
‫هي المسؤولة عن موت أمكما‬

526
00:31:12,928 --> 00:31:15,138
‫وأريدكما أن تطلبا منها‬
‫إجراء استحضار أرواح‬

527
00:31:15,305 --> 00:31:17,057
‫للتواصل مع أمكما‬
‫خلال قراءة الوصية‬

528
00:31:17,224 --> 00:31:18,683
‫لا أفهم‬

529
00:31:19,559 --> 00:31:22,437
‫كيف سيساعدك التواصل مع أمي‬
‫بالإمساك بـ(كرستينا)؟‬

530
00:31:22,562 --> 00:31:25,148
‫بالطبع لن تتواصل مع أمكِ حقاً‬

531
00:31:25,273 --> 00:31:27,484
‫إنّها مخادعة، وسأفضحها‬

532
00:31:28,318 --> 00:31:30,028
‫كيف تعرف أنّها لن تنفذ‬
‫الأمر حقاً؟‬

533
00:31:30,153 --> 00:31:31,613
‫لأنّه لا يمكنها ذلك‬

534
00:31:38,036 --> 00:31:39,621
‫- لا يعجبني الأمر‬
‫- ولا أنا‬

535
00:31:39,871 --> 00:31:41,957
‫- ما الخيار البديل؟‬
‫- هذا لا أخلاقي‬

536
00:31:42,082 --> 00:31:45,168
‫لا أعرف، يقولون إنّ الدماغ‬
‫ينصهر إن استخدمتها كثيراً‬

537
00:31:45,961 --> 00:31:47,462
‫ويجعلك عقيماً أيضاً‬

538
00:31:48,130 --> 00:31:49,589
‫عمّ تتحدث؟‬

539
00:31:50,132 --> 00:31:53,343
‫- المايكرويف، وأنتِ؟‬
‫- استحضار الأرواح مساء اليوم‬

540
00:31:53,677 --> 00:31:56,179
‫كنّا ننظر إلى المايكرويف‬
‫لا علاقة للاستحضار بالأمر‬

541
00:31:56,721 --> 00:31:58,348
‫من الخاطئ التلاعب بتلك الأمور‬

542
00:31:58,765 --> 00:32:01,268
‫- إيقاظ الأموات‬
‫- لن نفعل ذلك حقاً‬

543
00:32:01,810 --> 00:32:03,270
‫إيقاظ الموتى‬

544
00:32:03,854 --> 00:32:05,522
‫تقول ذلك، ولكن...‬

545
00:32:05,647 --> 00:32:07,107
‫لا تعرف‬

546
00:32:07,649 --> 00:32:10,819
‫تسخر من الغيبيات‬
‫ولا تؤمن بالحياة بعد الموت‬

547
00:32:11,319 --> 00:32:12,779
‫لا تعرف بما تورط نفسك‬

548
00:32:13,029 --> 00:32:18,326
‫أعرف أنّ استحضار الأرواح أداة‬
‫تستخدمها (كرستينا) للتلاعب بالناس‬

549
00:32:24,374 --> 00:32:25,917
‫اضحك، هيّا‬

550
00:32:27,586 --> 00:32:29,629
‫من المهم جداً لك أن تكون‬
‫(كرستينا) مخادعة، صحيح؟‬

551
00:32:30,130 --> 00:32:32,841
‫لأنّها إن لم تكن كذلك‬
‫وكان لديها موهبة‬

552
00:32:33,383 --> 00:32:36,136
‫كل ما تسخر منه‬
‫وكل ما تشكك به‬

553
00:32:36,261 --> 00:32:38,763
‫وكل ما تمثله‬
‫سيقلب رأساً على عقب‬

554
00:32:40,432 --> 00:32:41,892
‫أجل، هذا صحيح‬

555
00:32:42,017 --> 00:32:43,602
‫غير محتمل، ولكن صحيح‬

556
00:32:44,019 --> 00:32:46,563
‫ماذا لو نظرت إليك أسرتك‬
‫الليلة عند استحضار الأرواح‬

557
00:32:47,189 --> 00:32:48,857
‫وحاولوا التحدث إليك‬
‫ولكن لم يتمكنوا من ذلك‬

558
00:32:49,024 --> 00:32:50,609
‫لأنّك ترفض أن تؤمن؟‬

559
00:32:52,444 --> 00:32:53,945
‫سيكون ذلك حزيناً جداً‬

560
00:33:01,986 --> 00:33:04,197
‫- أنا آسفة‬
‫- لا بأس‬

561
00:33:21,110 --> 00:33:22,653
‫حقاً، الأمر غير اعتيادي‬

562
00:33:23,285 --> 00:33:24,745
‫هذا ما أرادته أمي‬

563
00:33:25,879 --> 00:33:27,339
‫حسناً‬

564
00:33:27,532 --> 00:33:29,158
‫هلاّ تجلسون جميعكم‬

565
00:33:33,162 --> 00:33:35,665
‫بطلب من (روزماري)‬

566
00:33:35,790 --> 00:33:37,709
‫وابنتها (كلارا)‬

567
00:33:38,334 --> 00:33:42,505
‫قراءة الوصية يجب أن تستهل‬
‫بـ... ماذا تسمون ذلك؟‬

568
00:33:43,131 --> 00:33:44,674
‫طقس اتصال‬

569
00:33:45,049 --> 00:33:46,509
‫يدعوه البعض باستحضار الأرواح‬

570
00:33:47,594 --> 00:33:49,053
‫استحضار الأرواح‬

571
00:33:49,804 --> 00:33:51,764
‫مساء الخير للجميع‬
‫وأهلاً بكم‬

572
00:33:53,391 --> 00:33:57,270
‫بمساعدتكم الليلة‬
‫سأحاول التواصل مع (روزماري)‬

573
00:33:58,980 --> 00:34:02,442
‫أمسكوا يدي مَن بجواركم‬
‫من الجهتين‬

574
00:34:03,026 --> 00:34:04,485
‫الجميع‬

575
00:34:06,362 --> 00:34:08,114
‫جيد، شكراً‬

576
00:34:09,407 --> 00:34:12,327
‫شكراً، هلاّ تخفض الإضاءة‬
‫لو سمحت‬

577
00:34:17,373 --> 00:34:20,460
‫سينكشف الحجاب‬
‫وتأتي (روزماري) إلينا‬

578
00:34:21,169 --> 00:34:22,795
‫طالما أننا نؤمن‬

579
00:34:23,880 --> 00:34:26,549
‫طالما أننا نؤمن‬

580
00:34:31,471 --> 00:34:34,557
‫فليركز الجميع على الشمعة‬
‫على منتصف الطاولة‬

581
00:34:36,559 --> 00:34:38,019
‫انظروا إليها‬

582
00:34:38,144 --> 00:34:40,980
‫وركزوا على (روزماري)‬

583
00:34:41,856 --> 00:34:43,650
‫تعالي إلينا يا (روزماري)‬

584
00:34:45,568 --> 00:34:47,028
‫تعالي إلينا‬

585
00:34:49,489 --> 00:34:50,949
‫تحدثي‬

586
00:34:59,082 --> 00:35:00,541
‫"(كرستينا)"‬

587
00:35:01,376 --> 00:35:02,835
‫"(كرستينا)"‬

588
00:35:03,169 --> 00:35:04,629
‫هذه أنا يا (روزماري)‬

589
00:35:05,088 --> 00:35:07,173
‫أنا هنا كما وعدتك‬

590
00:35:09,592 --> 00:35:12,762
‫جميع أصدقائك وأفراد عائلتكِ‬
‫هنا أيضاً يا (روزماري)‬

591
00:35:13,638 --> 00:35:15,473
‫أتودين قول أيّ شيء؟‬

592
00:35:17,809 --> 00:35:19,268
‫أو طرح أيّ سؤال؟‬

593
00:35:21,854 --> 00:35:23,314
‫(روزماري)؟‬

594
00:35:24,941 --> 00:35:26,401
‫"(كلارا)؟"‬

595
00:35:28,111 --> 00:35:29,570
‫"(كلارا)"‬

596
00:35:31,322 --> 00:35:32,782
‫أمي؟‬

597
00:35:35,326 --> 00:35:36,786
‫"لماذا يا (كلارا)؟"‬

598
00:35:38,246 --> 00:35:39,706
‫"لمَ فعلتها؟"‬

599
00:36:04,355 --> 00:36:06,357
‫أعرف ماذا تفعلين‬
‫ولن ينجح ذلك‬

600
00:36:08,484 --> 00:36:10,528
‫- ماذا تعني؟‬
‫- هذا كله مخطط‬

601
00:36:10,653 --> 00:36:12,488
‫أعددته مع (كرستينا)‬
‫أليس كذلك؟‬

602
00:36:13,406 --> 00:36:15,658
‫إنّه فعال جداً‬
‫ولكنّي لم أصدقه‬

603
00:36:16,367 --> 00:36:18,953
‫لن أصدقه، لا أصدقه‬
‫لا يمكنني ذلك‬

604
00:36:20,455 --> 00:36:21,914
‫لا يمكنني‬

605
00:36:23,875 --> 00:36:25,334
‫لا، أنا...‬

606
00:36:27,587 --> 00:36:29,046
‫"أنا..."‬

607
00:36:31,007 --> 00:36:33,134
‫- حان وقت المقطع الثاني‬
‫- "لا يحدث هذا"‬

608
00:36:33,468 --> 00:36:34,927
‫حسناً‬

609
00:36:39,682 --> 00:36:42,185
‫"لماذا يا (كلارا)، لماذا؟"‬

610
00:36:42,435 --> 00:36:43,895
‫من يفعل هذا؟‬

611
00:36:47,190 --> 00:36:48,733
‫أنا آسفة يا أمي‬

612
00:36:52,236 --> 00:36:54,197
‫أنا آسفة جداً‬

613
00:36:55,198 --> 00:36:56,657
‫هل أنتِ الفاعلة يا (كلارا)؟‬

614
00:36:57,867 --> 00:36:59,327
‫هل كنتِ في السيارة؟‬

615
00:37:00,953 --> 00:37:02,413
‫ألهذا هي هنا؟‬

616
00:37:03,706 --> 00:37:05,166
‫أذلك هو ما تسبب بكل هذا؟‬

617
00:37:15,802 --> 00:37:17,261
‫أجل‬

618
00:37:23,017 --> 00:37:24,477
‫أجل‬

619
00:37:28,356 --> 00:37:31,776
‫أصبت بالجنون‬
‫أصبت بالجنون وحسب‬

620
00:37:32,401 --> 00:37:33,861
‫لماذا؟‬

621
00:37:33,986 --> 00:37:39,075
‫قالت لي إنّها ستغير الوصية مجدداً‬

622
00:37:40,368 --> 00:37:42,119
‫وتزيل اسم (ترافيس) منها‬

623
00:37:43,955 --> 00:37:45,957
‫قالت إنّ ذلك لمصلحته‬

624
00:37:48,376 --> 00:37:49,961
‫ورفضت الاستماع لي‬

625
00:37:51,712 --> 00:37:55,675
‫قلنا أمور جارحةً لبعضنا‬
‫لذلك...‬

626
00:37:55,800 --> 00:37:58,135
‫جئت بالقطار من (كلير ليك)‬

627
00:37:58,719 --> 00:38:00,513
‫لأتحدث إليها شخصياً‬

628
00:38:01,764 --> 00:38:05,351
‫لأجعلها ترى الأمور‬
‫بطريقة منطقية‬

629
00:38:06,644 --> 00:38:12,024
‫كنت أعرف أنّها ستذهب‬
‫لرؤية منجمتها اللعينة‬

630
00:38:13,609 --> 00:38:15,862
‫ولم أرد الالتقاء‬
‫بذلك الغريب (جيريمي) لذلك...‬

631
00:38:16,445 --> 00:38:17,905
‫ذهبت إلى المنزل‬

632
00:38:18,823 --> 00:38:20,741
‫لآخذ واحدةً من السيارات‬
‫لألتقي بها‬

633
00:38:22,034 --> 00:38:25,663
‫"شاهدتها بعد أن غادرت‬
‫منزل (كرستينا)"‬

634
00:38:26,873 --> 00:38:28,332
‫"واتصلت بها"‬

635
00:38:28,791 --> 00:38:33,045
‫"حتى لا تفزع‬
‫بظهوري في منتصف الليل"‬

636
00:38:34,380 --> 00:38:36,591
‫"ولم ترد على الهاتف"‬

637
00:38:37,383 --> 00:38:39,385
‫من أجل ابنتها و...‬

638
00:38:42,013 --> 00:38:43,472
‫أصابني الجنون‬

639
00:38:49,353 --> 00:38:50,813
‫لا‬

640
00:38:57,320 --> 00:38:58,946
‫شكراً على صراحتكِ يا (كلارا)‬

641
00:39:00,781 --> 00:39:04,535
‫- كيف عرفت أنّي كنت الفاعلة؟‬
‫- حسناً...‬

642
00:39:05,494 --> 00:39:09,373
‫لم يخطر الأمر لي حتى‬
‫بدأتِ بإلقاء اللوم على (جيريمي)‬

643
00:39:10,207 --> 00:39:11,918
‫ولكن حين دخلتِ هنا‬
‫لأول مرة‬

644
00:39:12,043 --> 00:39:14,795
‫تكلمت عن شناعة‬
‫موت أمكِ في مزراب‬

645
00:39:14,921 --> 00:39:16,839
‫"ليس على الطريق‬
‫وليس على رصيف المشاة"‬

646
00:39:17,048 --> 00:39:19,342
‫- "ولكن المزراب"‬
‫- أن تموت في مزراب هكذا‬

647
00:39:21,886 --> 00:39:24,180
‫كالقمامة، ذلك فظيع‬

648
00:39:24,722 --> 00:39:29,143
‫كيف كنتِ ستعرفين ذلك‬
‫إن لم تكوني هناك؟‬

649
00:39:33,940 --> 00:39:37,234
‫- فعلت هذا من أجل (ترافيس)‬
‫- ومن أجل نفسك‬

650
00:39:37,818 --> 00:39:40,488
‫قالت إنّها ستحميننا‬

651
00:39:44,659 --> 00:39:48,204
‫وعدت أبي بذلك‬

652
00:39:50,289 --> 00:39:53,709
‫يجب أن يحمي الآباء أبناءهم‬

653
00:39:55,503 --> 00:39:56,963
‫أجل‬

654
00:39:59,966 --> 00:40:03,636
‫- أيمكنني أن أرى أخي الآن؟‬
‫- بالتأكيد‬

655
00:40:12,103 --> 00:40:15,982
‫أعرف أنّ تفكيرك كان مشوشاً‬
‫حين فعلتِ ما فعلته‬

656
00:40:17,358 --> 00:40:18,818
‫أحسن التصرف مع العمة (جو)‬

657
00:40:20,152 --> 00:40:22,238
‫ولا تترك ملابسك في كل مكان و...‬

658
00:40:23,739 --> 00:40:25,199
‫احترم الآخرين، حسناً؟‬

659
00:40:26,492 --> 00:40:27,952
‫سأفعل‬

660
00:40:31,580 --> 00:40:33,040
‫أحبك‬

661
00:40:37,378 --> 00:40:38,838
‫أحبك أيضاً‬

662
00:40:49,306 --> 00:40:52,852
‫- شكراً لسماحكم لي بالتحدث إليها‬
‫- بالطبع‬

663
00:41:09,243 --> 00:41:10,703
‫هل تنام هنا؟‬

664
00:41:12,580 --> 00:41:14,165
‫أجل، أحياناً‬

665
00:41:14,874 --> 00:41:16,709
‫تساعدني الضجة على الاسترخاء‬

666
00:41:16,834 --> 00:41:18,335
‫إنّها كالبحر‬

667
00:41:22,882 --> 00:41:25,718
‫- أيمكنني مساعدتك؟‬
‫- أجل، جئت لأخذ تسجيلاتي‬

668
00:41:25,843 --> 00:41:27,303
‫تفضلي‬

669
00:41:27,970 --> 00:41:29,430
‫شكراً‬

670
00:41:31,682 --> 00:41:35,519
‫- عليّ التحدث إليك، لوحدنا‬
‫- تفضلي‬

671
00:41:36,771 --> 00:41:38,981
‫- المكان هنا خاص‬
‫- مكان خاص أكثر‬

672
00:41:43,569 --> 00:41:45,029
‫حسناً‬

673
00:41:56,332 --> 00:41:58,918
‫- إذن...‬
‫- عدني بألاّ تقاطعني‬

674
00:41:59,418 --> 00:42:01,420
‫- اسمعني‬
‫- حسناً، أعدكِ بذلك‬

675
00:42:03,380 --> 00:42:04,840
‫- تحدثت إلى زوجتك...‬
‫- لحظة...‬

676
00:42:10,971 --> 00:42:12,598
‫منذ أن قتلت زوجتك وابنتك‬

677
00:42:12,723 --> 00:42:16,018
‫هناك سؤال يعذبك‬
‫حول أحداث تلك الليلة، صحيح؟‬

678
00:42:18,687 --> 00:42:20,189
‫- صحيح؟‬
‫- أجل‬

679
00:42:23,651 --> 00:42:26,403
‫تريد زوجتك أن أخبرك‬
‫أنّ ابنتك لم تستيقظ قط‬

680
00:42:27,530 --> 00:42:29,115
‫لم تعرف ماذا حدث‬

681
00:42:29,865 --> 00:42:32,535
‫لم تكن خائفةً ولو للحظة واحدة‬

682
00:42:36,738 --> 00:42:39,834
‫هل انتهيتِ من نقل الرسالة؟‬
‫هل هذا كل شيء؟‬

683
00:42:40,209 --> 00:42:41,794
‫- هذا كل شيء‬
‫- شكراً‬

684
00:42:52,364 --> 00:42:53,824
‫إلى اللقاء يا سيد (جين)‬

