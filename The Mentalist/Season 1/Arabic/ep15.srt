1
00:00:02,040 --> 00:00:05,127
‫"المتلاعب الذهني، اسم"‬

2
00:00:05,680 --> 00:00:11,019
‫"شخص يستخدم الذكاء العقلي‬
‫التنويم المغناطيسي و/أو الاقتراح"‬

3
00:00:11,425 --> 00:00:14,303
‫"متلاعب بارع بالأفكار والتصرّفات"‬

4
00:00:17,222 --> 00:00:19,391
{\an8}‫"منزل (ماركيزا)‬
‫(ساكرامنتو)، (كاليفورنيا)"‬

5
00:00:25,063 --> 00:00:28,400
‫- تقيم (سكارليت) أفضل الحفلات‬
‫- سأبحث عن (آزرا)‬

6
00:00:28,771 --> 00:00:30,481
‫ثم سأرى من يمكنني إيجاده‬

7
00:00:31,445 --> 00:00:32,821
‫هذا (فيكتور)‬

8
00:00:33,801 --> 00:00:36,512
‫(فيكتور)، حفلة رائعة‬

9
00:00:54,767 --> 00:00:56,477
‫- (سكارليت)‬
‫- (سكارليت)‬

10
00:00:57,533 --> 00:00:58,910
‫(سكارليت)‬

11
00:00:59,535 --> 00:01:00,912
‫اتصلوا بالطوارئ‬

12
00:01:01,329 --> 00:01:02,705
‫أمي‬

13
00:01:04,040 --> 00:01:05,541
‫لا (أوسكار)، ابق مكانك‬

14
00:01:07,877 --> 00:01:09,253
‫(سكارليت)‬

15
00:01:09,420 --> 00:01:10,796
‫انظر إليها يا (جورج)‬

16
00:01:11,631 --> 00:01:13,007
‫جميلة، أليست كذلك؟‬

17
00:01:14,258 --> 00:01:16,010
‫والآن استرخ‬

18
00:01:18,888 --> 00:01:20,973
‫ألا تشعر بالسعادة والاسترخاء؟‬

19
00:01:21,807 --> 00:01:24,185
‫- أجل‬
‫- قل ذلك‬

20
00:01:24,602 --> 00:01:27,980
‫- أخبرني بما تشعر‬
‫- سعيد ومسترخٍ‬

21
00:01:29,065 --> 00:01:30,441
‫جيّد‬

22
00:01:31,025 --> 00:01:32,944
‫"جيّد جداً"‬

23
00:01:35,112 --> 00:01:38,824
‫إذاً أخبرني يا (جورج)‬
‫ما هو تاريخ ميلادك؟‬

24
00:01:39,700 --> 00:01:43,538
‫ولدت في ١ مارس ١٩٨٠‬

25
00:01:44,288 --> 00:01:45,665
‫وما اسم والدتك؟‬

26
00:01:46,457 --> 00:01:49,544
‫- (ميلودي)‬
‫- أجل، هذا اسم جميل جداً‬

27
00:01:50,670 --> 00:01:52,129
‫كانت امرأة طيّبة‬

28
00:01:53,214 --> 00:01:55,383
‫أرادت منك قول الحقيقة‬
‫أليس كذلك يا (جورج)؟‬

29
00:01:55,925 --> 00:01:58,261
‫- أجل‬
‫- أخبرني‬

30
00:01:59,470 --> 00:02:02,139
‫- كيف قتلت (دونوفان)...‬
‫- (جاين)، أعتذر عن المقاطعة‬

31
00:02:02,265 --> 00:02:05,017
‫ولكن وردتنا قضية جريمة قتل‬
‫هل ستطيل البقاء مع هذا الرجل؟‬

32
00:02:08,062 --> 00:02:10,106
‫تباً يا (جاين)‬
‫إنّه بغيبوبة، أليس كذلك؟‬

33
00:02:10,856 --> 00:02:14,193
‫أعتبرها مرحلة استرخاء عميق‬

34
00:02:14,527 --> 00:02:16,153
‫- لقد نومته مغناطيسياً‬
‫- حسناً‬

35
00:02:16,279 --> 00:02:17,947
‫كنت أقدم معروفاً‬
‫لوحدة الجرائم المنظمة‬

36
00:02:18,197 --> 00:02:19,574
‫لأولئك الرعاة؟‬

37
00:02:20,157 --> 00:02:23,369
‫- "حان وقت الانصراف"‬
‫- أتعلمين؟ كنت سأنتزع منه الحقيقة‬

38
00:02:23,786 --> 00:02:26,372
‫قتل شخصين، لو خرجتِ بهدوء...‬

39
00:02:26,497 --> 00:02:29,542
‫كم من مرة أخبرتك‬
‫بأنه لا يمكنك استخدام التنويم المغناطيسي؟‬

40
00:02:29,750 --> 00:02:33,004
‫إنّه مخالف للقانون وغير أخلاقي‬
‫ولا يمكنك الاستمرار في فعل ذلك‬

41
00:02:33,129 --> 00:02:35,047
‫اهدأي يا امرأة‬
‫ليست مشكلة كبيرة‬

42
00:02:35,172 --> 00:02:40,303
‫حقاً؟ سيأتي محامي هذا الرجل‬
‫خلال لحظات بوجه شرير‬

43
00:02:40,428 --> 00:02:43,514
‫وأشعر بأنّه سيتجادل معك‬
‫بهذا الأمر، دعنا نذهب‬

44
00:02:43,639 --> 00:02:46,392
‫- حسناً، دعيني أعيده لوعيه‬
‫- أسرع‬

45
00:02:46,809 --> 00:02:48,185
‫حاضر سيّدتي‬

46
00:02:51,522 --> 00:02:53,399
‫أود التحدث إلى موكلي على انفراد‬

47
00:02:53,774 --> 00:02:55,276
‫- بالتأكيد‬
‫- حالاً‬

48
00:02:55,818 --> 00:02:57,778
‫(جورج)، سررت بالتحدث إليك‬

49
00:02:58,237 --> 00:03:00,114
‫أتمنى لك التوفيق‬
‫بمساعيك المستقبلية‬

50
00:03:04,035 --> 00:03:05,411
‫هذه لي‬

51
00:03:07,788 --> 00:03:09,165
‫حسناً (جورج)‬

52
00:03:09,874 --> 00:03:11,584
‫هل أنت بخير يا (جورج)؟‬

53
00:03:12,793 --> 00:03:14,754
‫- ليس الأمر مضحكاً‬
‫- هو مضحك قليلاً‬

54
00:03:15,338 --> 00:03:17,757
‫- ماذا لديكِ؟‬
‫- نادي مدينة غير مسجل‬

55
00:03:17,882 --> 00:03:21,260
‫يقع خارج البلدة وتديره (سكارليت ماركيزا)‬
‫أنثى بعمر الـ٣٣‬

56
00:03:21,802 --> 00:03:24,096
‫مضيفة الحفل‬
‫متزوجة ولديها طفل واحد‬

57
00:03:24,221 --> 00:03:26,682
‫في الساعة الـ١٠:٢٠ هذا المساء‬
‫كانت الحفلة في ذروتها‬

58
00:03:27,183 --> 00:03:30,102
‫ركضت (سكارليت) نحو الشرفة‬
‫تمسك بحنجرتها وتصرخ‬

59
00:03:30,227 --> 00:03:32,980
‫- سقطت وماتت‬
‫- أين الزوج والابن؟‬

60
00:03:33,272 --> 00:03:35,066
‫إنّهما برفقة الجيران‬
‫مصدومان مما حدث‬

61
00:03:35,316 --> 00:03:37,234
‫سننتظر ونتحدث إليهما‬
‫في صباح الغد‬

62
00:03:37,568 --> 00:03:39,153
‫- حالة تسمم، أليس كذلك؟‬
‫- لا بدّ من ذلك‬

63
00:03:39,945 --> 00:03:43,199
‫رغوة في الفم وتغيّر اللون‬
‫هكذا يعتقد الطبيب الشرعي أيضاً‬

64
00:03:43,407 --> 00:03:46,786
‫ولكنّنا لم نجد السم بعد‬
‫ولا نعرف أين تناولت السم‬

65
00:03:47,203 --> 00:03:50,498
‫سقطت من الأعلى ولكن ربما‬
‫تسممت في أيّ مكان، المنزل كبير‬

66
00:03:52,792 --> 00:03:54,168
‫مهلاً‬

67
00:03:55,294 --> 00:03:56,671
‫المعذرة‬

68
00:03:59,423 --> 00:04:00,800
‫هذا مثير للاهتمام‬

69
00:04:01,634 --> 00:04:04,053
‫- انظر، انظر إلى عينيها‬
‫- ماذا؟‬

70
00:04:09,141 --> 00:04:11,310
‫مرحباً؟ عبّر عمّا لديك‬

71
00:04:17,566 --> 00:04:19,860
‫وضعت مستحضر رموش‬
‫على العين اليمنى أكثر من اليسار‬

72
00:04:19,985 --> 00:04:24,156
‫ما يعني أنّها كانت تعيد تبرّجها‬
‫عندما تم تسميمها‬

73
00:04:24,573 --> 00:04:28,494
‫لذا كانت داخل...‬

74
00:04:29,203 --> 00:04:30,621
‫الحمام‬

75
00:04:39,630 --> 00:04:43,050
‫لا شكّ أنّ هذا مصدر السم‬

76
00:04:50,766 --> 00:04:52,143
‫ماذا لدينا هنا؟‬

77
00:04:55,813 --> 00:04:57,565
‫"نحن متعادلان الآن"‬

78
00:04:59,525 --> 00:05:00,901
‫الدافع‬

79
00:05:12,462 --> 00:05:16,216
{\an8}‫"فيلا (مارسانتي إيستيتس)‬
‫(ساكرامنتو) ولاية (كاليفورنيا)"‬

80
00:05:55,755 --> 00:05:58,091
‫سيّد (ماركيزا)، أنا العميلة (ليزبن)‬
‫من مكتب تحقيقات (كاليفورنيا)‬

81
00:05:58,216 --> 00:05:59,592
{\an8}‫أجل، شكراً لمجيئكما‬

82
00:06:00,468 --> 00:06:03,138
{\an8}‫هاتان صديقتان عزيزتان‬
‫(آزرا هدامي) و(ماندي ريلجيك)‬

83
00:06:03,847 --> 00:06:05,223
{\an8}‫كانتا تعتنيان بنا أنا و(أوسكار)‬

84
00:06:05,932 --> 00:06:07,308
‫سنفعل ما بوسعنا‬

85
00:06:07,767 --> 00:06:10,520
{\an8}‫(فيك)، سأحرص على أن يزورك (جيم)‬
‫فور عودته إلى المدينة‬

86
00:06:10,854 --> 00:06:13,314
‫- شكراً (ماندي)‬
‫- اعتن بذاتك (فيكتور)‬

87
00:06:20,780 --> 00:06:22,198
{\an8}‫تفضلا بالدخول‬

88
00:06:32,542 --> 00:06:35,754
{\an8}‫احتفظت (سكارليت) بكل شيء هنا‬
‫إنّها منظمة جداً‬

89
00:06:36,212 --> 00:06:38,506
{\an8}‫- شكراً‬
‫- سنعيدها إليك بأقرب وقت ممكن‬

90
00:06:38,923 --> 00:06:40,300
{\an8}‫شكراً لكِ‬

91
00:06:44,095 --> 00:06:47,724
{\an8}‫أظهر فحص السم أنّ شراب زوجتك‬
‫كان ممزوجاً بسم فئران‬

92
00:06:49,560 --> 00:06:50,936
{\an8}‫سم فئران‬

93
00:06:51,519 --> 00:06:53,605
‫(أوسكار)، (أوسكار)‬

94
00:06:55,774 --> 00:06:58,568
‫- من يفعل شيء كهذا؟‬
‫- شخص يريد الانتقام؟‬

95
00:06:58,985 --> 00:07:01,488
‫من تخمّن؟‬
‫من خطر على بالك الآن؟‬

96
00:07:01,696 --> 00:07:03,239
‫لم يكن لـ(سكارليت) أعداء‬

97
00:07:03,782 --> 00:07:05,658
‫- كان الجميع يحبون (سكارليت)‬
‫- حتى (آزرا)؟‬

98
00:07:05,825 --> 00:07:09,120
‫(آزرا)؟ أجل، كانت علاقتهما جيّدة‬
‫لماذا تسأل عنها؟‬

99
00:07:09,788 --> 00:07:12,290
‫- أنت على علاقة بـ(آزرا)، صحيح؟‬
‫- ماذا؟‬

100
00:07:13,082 --> 00:07:15,084
‫- لا‬
‫- لا؟ حقاً؟‬

101
00:07:15,251 --> 00:07:18,922
‫لا فعلاً وأيّ نوع من رجال الشرطة أنت‬
‫لتطرح علي سؤالاً كهذا؟‬

102
00:07:19,047 --> 00:07:20,423
‫أعتذر، هذا خطأي‬

103
00:07:21,341 --> 00:07:24,052
‫- هل أنتما شريكان في العمل؟‬
‫- إنّها مديرة حساباتي‬

104
00:07:24,344 --> 00:07:26,471
‫- حسناً، فهمت الآن‬
‫- فهمت ماذا؟‬

105
00:07:26,805 --> 00:07:28,640
‫لا يهم، أتعرف أين المفاتيح؟‬

106
00:07:29,140 --> 00:07:30,642
‫لم أجدها، ليست هنا‬

107
00:07:30,975 --> 00:07:34,813
‫- لم أجدها، أردت نقل سيارتها‬
‫- لا تقلق، أنا متأكد من أنّنا سنجدها‬

108
00:07:35,980 --> 00:07:39,776
‫- ما طبيعة عملك تحديداً؟‬
‫- أعمل في تطوير العقارات‬

109
00:07:40,443 --> 00:07:42,570
‫- هذا سوق صعب‬
‫- بالفعل‬

110
00:07:42,695 --> 00:07:44,781
‫ولكنني واثق من أنّه سيتحسن قريباً‬

111
00:07:44,989 --> 00:07:48,493
‫- هل عملت (سكارليت) معك؟‬
‫- لا، كانت تفضّل الفن‬

112
00:07:49,118 --> 00:07:50,912
‫كانت تصمم المجوهرات‬
‫كانت هذه موهبتها‬

113
00:07:51,287 --> 00:07:53,248
‫وقد أنشأت عملاً جيّداً من ذلك‬

114
00:07:54,207 --> 00:07:55,750
‫تبيع للأصدقاء والجيران‬

115
00:07:56,292 --> 00:07:57,836
‫أيّ نوع من المجوهرات‬
‫كانت تصمم؟‬

116
00:07:58,211 --> 00:08:00,964
‫- أكانت مجوهرات ثمينة؟‬
‫- لا، حُلي رخيصة‬

117
00:08:01,798 --> 00:08:04,092
‫- الأقراط والأساور‬
‫- أيمكنني رؤية بعضاً منها؟‬

118
00:08:05,885 --> 00:08:07,262
‫بالتأكيد‬

119
00:08:22,193 --> 00:08:23,570
‫إنها جميلة للغاية‬

120
00:08:23,903 --> 00:08:27,782
‫- أهناك سبب معيّن لحفلة الأمس؟‬
‫- كانت فكرة (سكارليت)‬

121
00:08:28,825 --> 00:08:32,453
‫ظنّت أنّ الحفلة ضرورية‬
‫ليعرف الناس أنّنا بخير‬

122
00:08:33,204 --> 00:08:35,290
‫ونحن بالفعل بخير‬

123
00:08:35,415 --> 00:08:37,792
‫هل تصرف أحد بطريقة‬
‫غير اعتيادية في الحفلة؟‬

124
00:08:38,293 --> 00:08:40,128
‫- هل حدثت أمور غريبة؟‬
‫- لا‬

125
00:08:40,628 --> 00:08:42,505
‫وهل كنت تعرف كل المدعوين شخصياً؟‬

126
00:08:42,922 --> 00:08:45,633
‫- أجل، كانوا أصدقاء مقرّبين‬
‫- نحن بحاجة لقائمة بأسمائهم‬

127
00:08:46,009 --> 00:08:48,928
‫أجل، معظمهم من نادي المدينة‬

128
00:08:49,637 --> 00:08:53,141
‫انتخبت (سكارليت) كرئيسة‬
‫للجنة النسائية في النادي‬

129
00:08:53,600 --> 00:08:55,935
‫وهو أمر مهم في هذا المجتمع‬
‫ومرموق للغاية‬

130
00:08:56,853 --> 00:08:58,229
‫كنت فخوراً جداً بها‬

131
00:08:58,563 --> 00:09:02,442
‫ولكن كان يعني أنّها ستقضي‬
‫وقتاً أطول في النادي‬

132
00:09:04,819 --> 00:09:07,572
‫(أوسكار)، توقف من فضلك‬

133
00:09:08,990 --> 00:09:11,075
‫المعذرة، هل انتهينا؟‬

134
00:09:11,409 --> 00:09:14,913
‫هذا كل شيء للوقت الراهن‬
‫سنتصل بك إن احتجنا إلى المزيد‬

135
00:09:16,414 --> 00:09:17,790
‫جميلة للغاية‬

136
00:09:26,899 --> 00:09:28,576
‫ما مشكلتك مع (آزرا هدامي)؟‬

137
00:09:28,910 --> 00:09:31,746
‫حسناً، رأيتِ الطريقة الدرامية‬
‫التي عانقت بها (فيكتور)‬

138
00:09:31,871 --> 00:09:33,247
‫إنّها تخدعه‬

139
00:09:33,664 --> 00:09:36,459
‫ظننت أنّها علاقة غرامية منحرفة‬
‫ولكنّها شيء مختلف‬

140
00:09:37,043 --> 00:09:38,836
‫على الأرجح أنّها تسرق منه‬

141
00:09:39,587 --> 00:09:42,840
‫سأكلف (فان بيلت) بتدقيق حساباتها‬
‫بالفترة التي تسحب أموال لعائلة (ماركيز)‬

142
00:09:43,299 --> 00:09:45,176
‫علينا الذهاب إلى نادي المدينة‬

143
00:09:45,551 --> 00:09:48,763
‫أجل، تحدّث إلى اللجنة النسائية‬
‫التي ترأستها وخذ (ريغزبي) معك‬

144
00:09:57,229 --> 00:09:58,773
‫إحدى النساء هنا تعرف الحقيقة‬

145
00:09:59,565 --> 00:10:01,609
‫وكيف ذلك؟‬

146
00:10:02,234 --> 00:10:05,780
‫حسناً، السم والرسالة وأحمر الشفاه‬
‫يشير إلى أنّ الجريمة نفذتها امرأة‬

147
00:10:06,530 --> 00:10:08,574
‫والنساء لا يخفين الأسرار عن بعضهن‬

148
00:10:08,991 --> 00:10:11,285
‫حسناً، ما لم يكن الفاعل‬
‫رجلاً ماكراً يتظاهر بأنّه امرأة‬

149
00:10:11,994 --> 00:10:14,330
‫- ما رأيك؟‬
‫- لا‬

150
00:10:22,672 --> 00:10:24,048
‫"اللاعبتان المتأهلتان إلى نصف النهائي"‬

151
00:10:24,173 --> 00:10:26,175
‫- ٢٣ و٤٥ إلى الملعب ١ رجاءً‬
‫- "(هيذر)"‬

152
00:10:26,300 --> 00:10:28,094
‫اللاعبتان ٢٣ و٤٥ إلى الملعب ١‬

153
00:10:28,302 --> 00:10:30,346
‫صباح الخير سيّدتي‬
‫نحن من مكتب (كاليفورنيا) للتحقيقات‬

154
00:10:30,721 --> 00:10:32,848
‫- أنا المحقق (ريغزبي) وهذا (جاين)‬
‫- مرحباً (هيذر)‬

155
00:10:33,474 --> 00:10:34,850
‫سررت بلقائك‬

156
00:10:35,101 --> 00:10:37,520
‫كان الجميع ينتظر وصلوكما‬
‫المسكينة (سكارليت)‬

157
00:10:37,687 --> 00:10:41,649
‫- حادث مروّع، كيف أساعدكما؟‬
‫- نود التحدث إلى عضوات اللجنة النسائية‬

158
00:10:41,774 --> 00:10:44,819
‫- بالتأكيد‬
‫- أيمكننا استدعاءهن بسريّة أكبر؟‬

159
00:10:45,611 --> 00:10:47,279
‫سيعرف الجميع خلال لحظات‬
‫على أيّ حال‬

160
00:10:47,405 --> 00:10:51,659
‫(جاكي)، (بيشنس) و(ماندي)، هناك شرطيان‬
‫يريدان التحدث إلينا بشأن مقتل (سكارليت)‬

161
00:10:51,784 --> 00:10:55,621
‫تعالين إلى ساحة (روز)‬
‫وللجميع، سيغلق المزاد الصامت قريباً‬

162
00:10:55,746 --> 00:10:57,623
‫لذا احصلوا على تلك العروض‬

163
00:10:59,166 --> 00:11:00,543
‫دعوني أرشدكما‬

164
00:11:01,377 --> 00:11:02,753
‫أحب المزادات الصامتة‬

165
00:11:03,796 --> 00:11:07,216
‫حسناً فلنبدأ بالأسماء‬

166
00:11:07,717 --> 00:11:09,135
‫(بيشنس برودبينت)‬

167
00:11:09,385 --> 00:11:11,429
‫- (ماندي ريلجيك) التي قابلتها‬
‫- مرحباً‬

168
00:11:11,554 --> 00:11:13,389
‫- (جاكي شيبر)‬
‫- مرحباً‬

169
00:11:13,764 --> 00:11:17,268
‫أحمد الرب على قدومكما‬
‫ستجدان ذلك المجنون، صحيح؟‬

170
00:11:17,601 --> 00:11:20,187
‫سنحاول ذلك، هل كنتن مدعوات‬
‫جميعكن إلى حفلة (سكارليت)؟‬

171
00:11:20,604 --> 00:11:23,315
‫- أجل‬
‫- أجل حضور حفلات رئيسة اللجنة واجب‬

172
00:11:23,441 --> 00:11:26,444
‫- هذه قاعدة‬
‫- رئيسة اللجنة مركز مرموق، صحيح؟‬

173
00:11:26,861 --> 00:11:31,490
‫- أجل، صحيح‬
‫- وأتوقع أنّ هذا يعرضها لأعداء كُثر‬

174
00:11:32,658 --> 00:11:34,035
‫يمكنك قول ذلك‬

175
00:11:34,994 --> 00:11:36,620
‫إن كان لديكِ ما تقولينه فافعلي‬

176
00:11:36,996 --> 00:11:38,664
‫تكلمي بصراحة يا عاهرة‬

177
00:11:39,165 --> 00:11:41,042
‫حسناً، أتريدين أن أقول ما لديّ؟‬

178
00:11:41,625 --> 00:11:44,045
‫لقد سأل عن أعدائها وكنتِ عدوّة لها‬

179
00:11:44,837 --> 00:11:47,965
‫كانت تكره (سكارليت)‬
‫لأنّها أرادت رئاسة اللجنة‬

180
00:11:48,090 --> 00:11:49,842
‫و(سكارليت) هزمتها في الانتخابات‬

181
00:11:50,384 --> 00:11:53,262
‫- لقنتها درساً، صحيح (ماندي)؟‬
‫- لن أتدخل بهذا الموضوع‬

182
00:11:53,721 --> 00:11:56,849
‫صحيح، لقد أخفقت في الحصول‬
‫على مكتب خاص‬

183
00:11:56,974 --> 00:11:59,894
‫وأدوات مكتبية جميلة‬
‫مكتوب عليها اسمي‬

184
00:12:00,061 --> 00:12:01,437
‫لذا قتلتها‬

185
00:12:02,021 --> 00:12:05,524
‫- أتدركين كم تبدين غبية؟‬
‫- أنتِ الغبية‬

186
00:12:05,649 --> 00:12:08,152
‫اسمعن، الأفضل إجراء المقابلات‬
‫لكل واحدة على انفراد‬

187
00:12:08,277 --> 00:12:09,862
‫أنتِ تغارين من الجميع‬

188
00:12:12,740 --> 00:12:15,534
‫أتذكرين حدوث شيء غريب‬
‫في ليلة الاحتفال؟‬

189
00:12:16,285 --> 00:12:20,247
‫لا أعرف، كنّا نتناول شراب الـ(موهيتو)‬
‫وندردش كالعادة ولكن...‬

190
00:12:21,415 --> 00:12:24,460
‫- ولكن ماذا؟‬
‫- لا أعرف إن كان عليّ إخباركما بهذا‬

191
00:12:24,794 --> 00:12:27,296
‫ولكنني رأيت (سكارليت)‬
‫تتشاجر مع (آزرا هدامي)‬

192
00:12:27,671 --> 00:12:29,048
‫وبدت غاضبة‬

193
00:12:29,465 --> 00:12:33,803
‫يتحدث البعض عن وجود علاقة غير علاقة‬
‫العمل بين (آزرا هدامي) و(فيكتور ماركيزا)‬

194
00:12:33,928 --> 00:12:37,181
‫لا أعرف مدى صحة الأمر‬
‫فأنا لا أهتم بالإشاعات‬

195
00:12:38,474 --> 00:12:39,850
‫ومن يفعل ذلك؟‬

196
00:12:40,142 --> 00:12:42,436
‫سمعنا أنّكِ ملكة الإشاعات هنا‬

197
00:12:42,812 --> 00:12:44,230
‫يخبرني الناس ببعض الأمور‬

198
00:12:47,149 --> 00:12:51,487
‫حسناً، من على علاقة غرامية‬
‫بـ(فيكتور ماركيزا)؟‬

199
00:12:51,987 --> 00:12:54,240
‫لا أعرف، من؟ أخبرني أنت‬

200
00:12:54,698 --> 00:12:56,075
‫(آزرا هدامي)؟‬

201
00:12:58,786 --> 00:13:01,413
‫- أهذه فكرة مضحكة؟‬
‫- لا، ولكن...‬

202
00:13:02,248 --> 00:13:05,918
‫لا، (فيكتور) و(آزرا) صديقان مقربان‬
‫لا شيء أكثر من ذلك‬

203
00:13:06,585 --> 00:13:08,379
‫- لا علاقة لـ(آزرا) بهذا الأمر‬
‫- حقاً؟‬

204
00:13:09,505 --> 00:13:11,340
‫ماذا يقول الرأي العام؟‬
‫من القاتل؟‬

205
00:13:12,550 --> 00:13:13,926
‫- أتريد رأيي؟‬
‫- أجل‬

206
00:13:14,135 --> 00:13:16,262
‫- (فيكتور)‬
‫- ماذا يجعلكِ تقولين ذلك؟‬

207
00:13:17,221 --> 00:13:22,393
‫لا شيء، (فيكتور) رجل طيّب ولكنهم هم‬
‫الذين يقتلون النساء، صحيح؟ الأزواج‬

208
00:13:22,810 --> 00:13:25,354
‫- ٩٠٪ من الجرائم ينفذها الأزواج‬
‫- أعتقد أنّ النسبة ٧٠٪‬

209
00:13:27,106 --> 00:13:28,482
‫إنّه محق‬

210
00:13:43,706 --> 00:13:45,082
‫أظهرتِ مهارات رائعة‬

211
00:13:45,749 --> 00:13:49,336
‫يمكنكِ ضرب الكرة ولفها عند عودتك‬
‫ولكن مهاراتك رائعة‬

212
00:13:49,753 --> 00:13:53,048
‫الجواب هو نعم، لم تكن تعجبني‬
‫ولكن لا لم أقتلها‬

213
00:13:53,507 --> 00:13:55,759
‫- أنتِ تكرهين الخسارة، صحيح؟‬
‫- أجل‬

214
00:13:56,093 --> 00:13:58,888
‫خلافاً لأناس كُثر يحبون الخسارة‬

215
00:13:59,972 --> 00:14:02,558
‫- بحقك، أنا في النصف النهائي‬
‫- أجل، بالطبع‬

216
00:14:02,892 --> 00:14:05,436
‫- حظاً موفقاً‬
‫- عليّ الذهاب‬

217
00:14:05,978 --> 00:14:09,565
‫لديّ مباراة أخرى بعد نصف ساعة‬
‫و(ماندي ريلجيك) القزمة السامة‬

218
00:14:09,690 --> 00:14:11,400
‫تحاول التفوق عليّ في المزاد الصامت‬

219
00:14:11,734 --> 00:14:15,404
‫لماذا تحتاج لقضاء ليلتين غراميتين‬
‫في (كليف سايد)؟ لا أعرف‬

220
00:14:17,656 --> 00:14:21,368
‫لذا سأوفر الوقت للجميع‬
‫وأخبرك بمن قتلها إن أردت‬

221
00:14:21,619 --> 00:14:22,995
‫أود ذلك للغاية‬

222
00:14:23,996 --> 00:14:25,372
‫(آزرا هدامي)‬

223
00:14:26,332 --> 00:14:29,001
‫- حقاً؟ لماذا؟‬
‫- إنّها على علاقة بـ(فيكتور)‬

224
00:14:30,711 --> 00:14:33,380
‫- كيف تعرفين ذلك؟‬
‫- أستطيع تمييز هذه الأمور‬

225
00:14:33,839 --> 00:14:37,051
‫لا بدّ أنّ (آزرا) قتلت (سكارليت)‬
‫لتحظى بـ(فيكتور)‬

226
00:14:37,635 --> 00:14:40,387
‫لا أعرف السبب‬
‫إن طلبت رأيي فهو فاشل‬

227
00:14:40,971 --> 00:14:44,808
‫حسناً، شكراً لكِ، بالمناسبة‬
‫إن كنتِ تبغضين (سكارليت ماركيزا)‬

228
00:14:44,934 --> 00:14:48,354
‫- لمَ ترتدين أقراطاً من تصميمها؟‬
‫- إنّها تصنع أقراطاً جميلة‬

229
00:14:49,396 --> 00:14:50,814
‫سررت بلقائك‬

230
00:14:55,736 --> 00:14:57,112
‫سررت بلقائكِ أيضاً‬

231
00:14:59,949 --> 00:15:02,618
‫- "كنتما مقربتين، صحيح؟"‬
‫- "كنّا مقربتين للغاية"‬

232
00:15:03,077 --> 00:15:05,829
‫كنّا نتحدث كل يوم‬
‫لأنّني نائبتها في اللجنة النسائية‬

233
00:15:05,996 --> 00:15:07,414
‫هلا لاحظتِ اختلافاً في حديثكما؟‬

234
00:15:07,706 --> 00:15:09,792
‫تحدثت كثيراً عن الانتقال‬

235
00:15:10,084 --> 00:15:14,338
‫كانت متعبة جداً من المواكبة‬
‫مهما كلف الأمر‬

236
00:15:14,546 --> 00:15:15,923
‫مهما كلف الأمر؟‬

237
00:15:16,507 --> 00:15:18,676
‫- كانت تعمل بجد‬
‫- أتملكين مفتاحاً لهذه؟‬

238
00:15:19,510 --> 00:15:21,887
‫لا، المفتاح بحوزة (سكارليت) فحسب‬

239
00:15:22,221 --> 00:15:25,516
‫هذه غرفة رئيسة اللجنة‬
‫وهذه خزنتها‬

240
00:15:26,517 --> 00:15:27,893
‫هذا منطقي‬

241
00:15:28,477 --> 00:15:31,605
‫- لا أعرف شيئاً عن ذلك‬
‫- مفاتيح (سكارليت) مفقودة‬

242
00:15:31,772 --> 00:15:33,148
‫هذا مثير للاهتمام‬

243
00:15:36,235 --> 00:15:39,154
‫- "علينا فتح الخزنة"‬
‫- إذاً نحتاج إلى مذكرة تفتيش‬

244
00:15:39,280 --> 00:15:42,157
‫- سأتولى أمرها‬
‫- هل استفدت من صديقات (سكارليت)؟‬

245
00:15:42,283 --> 00:15:46,704
‫لكل واحدة منهن نظرية مختلفة‬
‫وكلهن يخفين أمراً لا أعرفه‬

246
00:15:47,162 --> 00:15:49,540
‫هل استلمت شيئاً من الأدلة الجنائية‬
‫عن أحمر الشفاه على المنديل؟‬

247
00:15:49,665 --> 00:15:51,959
‫ليس بعد، إنّهم مضغوطون كالعادة‬
‫بسبب تخفيض الميزانية‬

248
00:15:52,251 --> 00:15:55,629
‫أيّتها المديرة، دخلت إلى البيانات‬
‫المالية لـ(آزرا هدامي)‬

249
00:15:55,879 --> 00:15:57,298
‫أفرغت حساباتها المصرفية‬
‫هذا الصباح‬

250
00:15:57,631 --> 00:16:00,551
‫الشيكات والمدخرات‬
‫سحبت حوالى ١٢٥ ألف دولار نقداً‬

251
00:16:00,926 --> 00:16:02,303
‫هل تخطط للهرب؟‬

252
00:16:02,720 --> 00:16:05,180
‫لم يصدف أنّها اشترت‬
‫سم فئران مؤخراً، أليس كذلك؟‬

253
00:16:05,514 --> 00:16:08,017
‫سيكون ذلك رائعاً ولكن لا‬
‫ليس هناك ما يشير إلى ذلك‬

254
00:16:08,267 --> 00:16:09,935
‫اتصلت الدورية الأمنية‬
‫للجنة (مارسانتي)‬

255
00:16:10,185 --> 00:16:12,104
‫اكتشفوا للتو أنّ منزل (هدامي) فارغ‬
‫لقد هربت‬

256
00:16:12,229 --> 00:16:13,605
‫رائع، لدينا هاربة‬

257
00:16:14,648 --> 00:16:16,025
‫أعرف أين ذهبت‬

258
00:16:18,444 --> 00:16:20,446
{\an8}‫"فندق (كليف سايد)"‬

259
00:16:27,369 --> 00:16:29,371
‫مكتب تحقيقات (كاليفورنيا)، مرحباً‬

260
00:16:39,883 --> 00:16:43,636
‫أيّتها المديرة، أنا أعمل هنا منذ ٦ أشهر‬
‫نصف سنة‬

261
00:16:44,053 --> 00:16:45,555
‫وماذا تريدين؟ نصف كعكة؟‬

262
00:16:45,930 --> 00:16:47,432
‫أريد أن أترأس هذا الاستجواب‬

263
00:16:51,853 --> 00:16:53,229
‫حسناً‬

264
00:16:53,771 --> 00:16:55,815
‫- موافقة؟‬
‫- أجل، بالطبع‬

265
00:16:56,774 --> 00:16:58,151
‫شكراً أيّتها المديرة‬

266
00:17:02,739 --> 00:17:04,115
‫لماذا كنتِ تهربين سيّدة (هدامي)؟‬

267
00:17:04,991 --> 00:17:07,785
‫من دون سبب‬
‫احتجت إلى الخلوة بسبب الضغط‬

268
00:17:08,369 --> 00:17:11,247
‫ألهذا علاقة بالشجار الذي وقع بينكِ‬
‫وبين (سكارليت ماركيزا) ليلة مقتلها؟‬

269
00:17:11,539 --> 00:17:14,042
‫- لم أتشاجر معها‬
‫- سمعنا غير ذلك‬

270
00:17:14,918 --> 00:17:16,294
‫لم نتشاجر‬

271
00:17:16,794 --> 00:17:19,297
‫أقسم لكما أنني لم أقتلها‬
‫هذا سخيف‬

272
00:17:19,672 --> 00:17:23,176
‫ليس أكثر سخافة من إفراغكِ‬
‫لحساباتك وتركك لمنزلكِ بلا سبب‬

273
00:17:23,718 --> 00:17:25,094
‫قد أكون بحاجة إلى محام‬

274
00:17:29,557 --> 00:17:33,102
‫اطلبي ذلك‬
‫سيخبركِ إن كنتِ غير متورطة بالجريمة‬

275
00:17:36,022 --> 00:17:37,398
‫فالأفضل لكِ أن تتكلمي‬

276
00:17:38,316 --> 00:17:42,695
‫هربت لأنّ الجريمة ستكشف مسائل‬
‫أود المحافظة على سريتها‬

277
00:17:42,820 --> 00:17:45,782
‫- كعلاقتكِ بـ(ماندي ريلجيك)؟‬
‫- تماماً‬

278
00:17:45,907 --> 00:17:47,533
‫خبر كهذا قد يدمّرنا‬

279
00:17:47,742 --> 00:17:50,620
‫صحيح، ولكن لا يستحق‬
‫أن تتركي منزلكِ لأجله‬

280
00:17:51,829 --> 00:17:54,582
‫قلتِ "مسائل"‬
‫ما هي المسائل الأخرى؟‬

281
00:17:56,376 --> 00:18:02,340
‫لم أشأ مواجهة (فيكتور) وإخباره بأنني‬
‫ساهمت بتدمير ما عمل بجدٍ لتحقيقه‬

282
00:18:02,465 --> 00:18:03,841
‫كيف ساعدتِ بذلك؟‬

283
00:18:04,384 --> 00:18:06,678
‫اقترضت مالاً من الخزينة‬
‫الاحتياطية للشركة‬

284
00:18:07,011 --> 00:18:09,806
‫- كم اقترضتِ؟‬
‫- أكثر من نصف مليون بقليل‬

285
00:18:10,723 --> 00:18:12,100
‫وأين ذهبتِ بالمال؟‬

286
00:18:13,059 --> 00:18:16,270
‫اتخذت قرارات استثمارية سيئة‬
‫وكان علي التستر عليها بسرعة‬

287
00:18:16,396 --> 00:18:18,982
‫- إذن سرقتِ...‬
‫- اقترضت من الميزانية الاحتياطية‬

288
00:18:19,399 --> 00:18:24,445
‫أخذت مالاً من كل صفقة تطوير‬
‫كانت مخصصة للميزانية الاحتياطية للشركة‬

289
00:18:25,029 --> 00:18:28,533
‫كنّا نأخذ صفقات كثيرة وعرفت‬
‫أنني سأعيد المبلغ قبل أن تصبح قضية‬

290
00:18:29,158 --> 00:18:33,830
‫ولكن قلّت الصفقات والتمويل وفجأةً‬
‫أصبحت الخزينة الاحتياطية مهمة جداً‬

291
00:18:35,331 --> 00:18:38,710
‫بعت كل شيء في متناولي‬
‫لأعوض المبلغ‬

292
00:18:50,179 --> 00:18:52,557
‫- اجلسي‬
‫- لمَ أنا هنا؟‬

293
00:18:52,807 --> 00:18:56,853
‫- لم أقترف ذنباً‬
‫- سأكون معكِ بعد دقيقة‬

294
00:19:00,523 --> 00:19:01,899
‫تفضلي‬

295
00:19:06,070 --> 00:19:09,782
‫حسناً، لقد وجدتِ بوضع مخل‬
‫مع مشتبه بها في جريمة قتل‬

296
00:19:10,783 --> 00:19:13,703
‫بالمناسبة، كيف عثرتما علينا؟‬
‫هل كنتما تراقبانني؟‬

297
00:19:13,828 --> 00:19:16,039
‫حسناً، تغلبت على (بيشنس)‬
‫في مزايدة على قضاء ليلتين غراميتين‬

298
00:19:16,164 --> 00:19:17,540
‫خلال فترة سفر زوجكِ (جيم)‬

299
00:19:17,999 --> 00:19:20,668
‫وضحكتِ على فكرة‬
‫كون (فيكتور) و(آزرا) عشيقين‬

300
00:19:22,211 --> 00:19:25,673
‫لا أحد يعرف بوجودي هنا، صحيح؟‬
‫إن انتشر الخبر ستكون فضيحة كبرى‬

301
00:19:25,798 --> 00:19:27,842
‫لا أحد يعرف بوجودك هنا‬
‫وقعي هذه‬

302
00:19:28,843 --> 00:19:30,219
‫ويمكنك الانصراف‬

303
00:19:34,766 --> 00:19:37,852
‫لن يمنحنا القاضي (كليرك) مذكرة تفتيش‬
‫لخزنة (سكارليت) حتى صباح الغد‬

304
00:19:38,144 --> 00:19:39,812
‫سنذهب ونفتش المكان حتى تدميره‬

305
00:19:41,147 --> 00:19:42,523
‫آسف‬

306
00:19:43,775 --> 00:19:47,695
‫- لم تسمعي ذلك، هذه معلومات سريّة‬
‫- معلومات سريّة؟ بالتأكيد‬

307
00:19:47,820 --> 00:19:50,198
‫لا، أنا جدي‬
‫لا تخبري أحداً، اتفقنا؟‬

308
00:19:50,406 --> 00:19:53,367
‫- أفهم ذلك، أيمكنني الذهاب الآن؟‬
‫- أجل، تفضلي‬

309
00:19:58,956 --> 00:20:01,084
‫ليس سيئاً‬
‫كان كلامك بليداً‬

310
00:20:01,501 --> 00:20:04,712
‫بليداً؟ أنا؟‬
‫أجل، وأنت (مارلون براندو)‬

311
00:20:08,091 --> 00:20:12,303
‫لا أصدّق ذلك، تعمل (آزرا) معي‬
‫منذ أكثر من ٥ سنين‬

312
00:20:13,054 --> 00:20:14,889
‫أعني، لقد كانت معي في المصاعب‬

313
00:20:15,890 --> 00:20:17,266
‫لا يسعني تصديق ذلك‬

314
00:20:17,683 --> 00:20:20,061
‫لدينا بعض الأسئلة‬
‫بعد اطلاعنا على حساباتك‬

315
00:20:20,603 --> 00:20:23,731
‫- بالتأكيد‬
‫- ذكرت أزمات مالية في عملك‬

316
00:20:24,065 --> 00:20:26,818
‫ولكن تم إيداع مبالغ منتظمة‬
‫في حساباتك الشخصية‬

317
00:20:27,068 --> 00:20:29,862
‫- مبالغ تزيد عن ٥ آلاف دولار‬
‫- هذه إيداعات (سكارليت)‬

318
00:20:30,279 --> 00:20:31,906
‫(أوسكار)، تعال وتناول غداءك‬

319
00:20:32,281 --> 00:20:35,118
‫هذه إيداعات ضخمة‬
‫بالنسبة إلى شخص من دون عمل‬

320
00:20:35,243 --> 00:20:36,619
‫ما مصدر المال؟‬

321
00:20:37,745 --> 00:20:40,957
‫- من عملها في تصميم المجوهرات‬
‫- ظننت أنك قلت إنّه عمل صغير‬

322
00:20:41,332 --> 00:20:44,919
‫كان كذلك، ولكن بدأ يجذب‬
‫اهتماماً كبيراً في الآونة الأخيرة‬

323
00:20:45,044 --> 00:20:48,923
‫ويبدو أنّها عقدت صفقات‬
‫مع عدد من المحلات‬

324
00:20:49,048 --> 00:20:51,217
‫- أتعرف أسماء المحلات؟‬
‫- لم أسألها‬

325
00:20:51,592 --> 00:20:53,678
‫كنت ستفلس قبل أشهر‬
‫من دون أموالها‬

326
00:20:54,595 --> 00:20:58,057
‫أعرف جيّداً أنّ زوجتي أنقذتنا مؤخراً‬

327
00:20:58,349 --> 00:21:00,268
‫- أبي‬
‫- ما الأمر؟‬

328
00:21:01,394 --> 00:21:02,770
‫لقد أخطأت في إعداد الشطيرة‬

329
00:21:03,396 --> 00:21:05,439
‫لم تضع أمي كل هذه المكونات‬

330
00:21:05,940 --> 00:21:08,985
‫- تعرف أنني أحبها بسيطة‬
‫- أيمكننا التنازل يا صديقي؟‬

331
00:21:09,318 --> 00:21:11,445
‫أود التحدث إلى هاتين الشرطيتين اللطيفتين‬

332
00:21:11,904 --> 00:21:17,326
‫أعدك بأن أعدّها لك أفضل في المرة المقبلة‬
‫والآن هلاّ تتناول الشطيرة من فضلك‬

333
00:21:19,120 --> 00:21:20,997
‫- أعتذر عن هذا‬
‫- لا بأس‬

334
00:21:21,455 --> 00:21:24,709
‫وفقاً للسجلات الهاتفية لزوجتك‬
‫فقد تداولت اتصالات عديدة‬

335
00:21:24,834 --> 00:21:26,294
‫باستخدام عدة هواتف‬
‫ذات الاستعمال لمرة واحدة‬

336
00:21:26,711 --> 00:21:28,337
‫لا أعرف مع من كانت تتحدث‬

337
00:21:28,504 --> 00:21:33,217
‫وكتبت في دفتر مواعيدها اليومي‬
‫موعد أسبوعي مع عنوان في (ماريسفيل)‬

338
00:21:33,593 --> 00:21:35,970
‫كان لديها موعد محدد اليوم‬
‫أتعرف شيئاُ عن ذلك؟‬

339
00:21:36,137 --> 00:21:41,475
‫لا أعرف ذلك ولكنها كانت تذهب‬
‫إلى (ماريسفيل) لأسواق المجوهرات القديمة‬

340
00:21:42,643 --> 00:21:44,020
‫عذراً‬

341
00:21:47,732 --> 00:21:49,817
‫- (ليزبن) معك‬
‫- "وردت نتائج أحمر الشفاه"‬

342
00:21:50,359 --> 00:21:53,613
‫لم نجد آثار للحمض النووي‬
‫ولكن اللون يدعى باسم "السخرية"‬

343
00:21:53,821 --> 00:21:56,240
‫وهو نسخة محدودة‬
‫ويباع في محلات قليلة فاخرة‬

344
00:21:56,574 --> 00:21:58,159
‫"السخرية" اسم ظريف‬

345
00:21:58,492 --> 00:22:02,163
‫اسمع، أمّن الوصول لسجلات الإيصالات‬
‫لكل المحلات حتى نبحث فيها‬

346
00:22:02,538 --> 00:22:07,543
‫وأريد منك أن تقابلنا في العنوان‬
‫٦٥٤٣٤ شرق (بوليفارد)‬

347
00:22:07,835 --> 00:22:09,587
‫- "في (ماريسفيل)"‬
‫- سأتجه إلى هناك‬

348
00:22:19,555 --> 00:22:21,891
‫- سألحق بك‬
‫- حسناً‬

349
00:22:23,392 --> 00:22:25,102
‫- مرحباً، من الفائز؟‬
‫- مرحباً‬

350
00:22:26,562 --> 00:22:28,689
‫لا أعرف، بصراحة لا أتابع المباراة‬

351
00:22:29,148 --> 00:22:30,816
‫أجل، إنّها تافهة بعض الشيء‬
‫أليس كذلك؟‬

352
00:22:31,359 --> 00:22:33,194
‫فالجميع جدي للغاية لأجل لعبة‬

353
00:22:33,402 --> 00:22:35,988
‫تماماً، وكأنّ الفوز بكأس تافهة‬
‫أمر مهم‬

354
00:22:36,197 --> 00:22:37,907
‫أعتقد أنّ الناس بحاجة‬
‫إلى الشعور بوجود هدف‬

355
00:22:38,783 --> 00:22:41,994
‫أجل، حسناً‬
‫هدفي مات هذا العام بعمر الـ١٦‬

356
00:22:42,328 --> 00:22:43,704
‫يؤسفني ذلك‬

357
00:22:44,205 --> 00:22:45,581
‫- صبي أم فتاة؟‬
‫- فتاة‬

358
00:22:46,290 --> 00:22:48,918
‫كانت ثملة جداً مع صديقتها‬
‫فصدمت سيارتها بشجرة‬

359
00:22:49,919 --> 00:22:51,754
‫وصديقتها لم تصب بأيّ أذى‬
‫حمداً للرب‬

360
00:22:52,255 --> 00:22:54,840
‫- ما كان اسمها؟‬
‫- (ريتشيل)‬

361
00:22:56,550 --> 00:23:00,429
‫بعد أن تفقد ولدك ترى كل المساعي‬
‫تافهة، أتفهم ما أعنيه؟‬

362
00:23:00,554 --> 00:23:02,431
‫أجل، للأسف أفهم ذلك‬

363
00:23:04,725 --> 00:23:06,686
‫لماذا لا تنسين كل ما حدث وتبتعدي؟‬

364
00:23:08,187 --> 00:23:11,691
‫لا يمكنني تحمل تكلفة الانتقال‬
‫لديّ ديون معلقة على المنزل‬

365
00:23:13,276 --> 00:23:14,652
‫أحسنتِ اللعب (كارين)‬

366
00:23:16,487 --> 00:23:20,241
‫بالإضافة إلى ذلك، هؤلاء أصدقائي‬
‫هذا كل ما أملك‬

367
00:23:22,326 --> 00:23:24,161
{\an8}‫"(ماريسفيل)، (كاليفورنيا)"‬

368
00:23:35,881 --> 00:23:39,343
‫- "يا له من سوق مجوهرات"‬
‫- وفقاً لدفتر (سكارليت) فاللقاء هنا‬

369
00:23:39,677 --> 00:23:43,139
‫لنرَ إن استطعنا إيجاد الشخص‬
‫ربما يحالفنا الحظ‬

370
00:23:57,778 --> 00:23:59,363
‫مرحباً، ماذا تفعلان؟‬

371
00:23:59,989 --> 00:24:01,741
‫- لا شيء‬
‫- أنت‬

372
00:24:06,329 --> 00:24:09,040
‫- ماذا تفعل؟‬
‫- ضع يديك خلف ظهرك‬

373
00:24:13,127 --> 00:24:14,837
‫انهض، هيا بنا‬

374
00:24:15,963 --> 00:24:17,965
‫- من هنا‬
‫- حسناً، حسناً‬

375
00:24:26,932 --> 00:24:29,602
‫وجب عليّ إحضار وجبات خفيفة‬
‫لا أعتقد أنّنا سننتهي بسرعة‬

376
00:24:30,311 --> 00:24:31,896
‫لن تجوع لفترة طويلة‬

377
00:24:32,271 --> 00:24:34,231
‫ستنشر (ماندي) الخبر بسرعة‬

378
00:24:35,191 --> 00:24:39,487
‫وسيعرف الجميع‬
‫أنّ الخزنة ستفتح غداً‬

379
00:24:40,488 --> 00:24:43,491
‫إمّا نعرف الآن من سرق مفاتيح‬
‫(سكارليت) أو لن نعرف أبداً‬

380
00:24:49,914 --> 00:24:53,167
‫على مهلك‬
‫هذه فضة مكسيكية أثرية‬

381
00:24:53,376 --> 00:24:57,004
‫ربما تفكر في المرة المقبلة‬
‫قبل أن تهرب من شرطي‬

382
00:24:57,421 --> 00:24:59,256
‫أفترض أنّ هذه ليست حلوى‬

383
00:25:00,633 --> 00:25:02,718
‫لمَ كنت ستقابل (سكارليت ماركيزا)؟‬

384
00:25:03,135 --> 00:25:05,054
‫حتى نتبادل أسرار الجمال‬

385
00:25:05,429 --> 00:25:07,431
‫- أتمانعين إن دخنت؟‬
‫- أجل، أمانع‬

386
00:25:08,391 --> 00:25:09,767
‫ماذا لديكِ (فان بيلت)؟‬

387
00:25:10,017 --> 00:25:12,228
‫(وارديل ساغز) الملقب بـ"(ديغر)"‬

388
00:25:12,561 --> 00:25:16,482
‫اعتقل مرات عديدة لعمليات سرقة‬
‫واحتيال واعتداء‬

389
00:25:16,732 --> 00:25:19,110
‫- هذا مدهش‬
‫- يُمكن أن يكون أفضل من ذلك‬

390
00:25:19,693 --> 00:25:21,278
‫لمَ كنت ستقابل (سكارليت)؟‬

391
00:25:21,946 --> 00:25:24,865
‫- بمَ أخبرتكِ عنّي؟‬
‫- لا شيء، إنّها ميّتة‬

392
00:25:26,659 --> 00:25:28,452
‫لا علاقة لي بالأمر‬

393
00:25:30,204 --> 00:25:31,872
‫أيّتها المديرة، تعالي وانظري‬

394
00:25:33,874 --> 00:25:36,085
‫هلاّ تنظروا إلى هذا‬
‫إنّه المصدر الرئيسي‬

395
00:25:36,836 --> 00:25:38,212
‫دعنا نتحدث‬

396
00:25:38,671 --> 00:25:42,049
‫تباً، لديّ ما أقوله‬
‫كانت (سكارليت) إحدى أهم زبائني‬

397
00:25:42,633 --> 00:25:47,096
‫كانت تشتري المسكنات‬
‫والمهدئات وحبوب الحمية بالمئات‬

398
00:25:47,721 --> 00:25:49,723
‫هل كانت (سكارليت)‬
‫تشتري العقاقير القانونية؟‬

399
00:25:50,182 --> 00:25:51,559
‫أجل‬

400
00:25:51,934 --> 00:25:53,853
‫- أين كنتما تلتقيان؟‬
‫- لقاءات للمقايضة‬

401
00:25:54,812 --> 00:25:56,647
‫كانت تحاول بيع مجوهراتها المروّعة‬

402
00:25:57,606 --> 00:26:00,234
‫بدت بائسة، لذا أخبرتها‬
‫بأنّ هناك طريقة أسهل لربح المال‬

403
00:26:00,943 --> 00:26:02,862
‫- أكان هناك صفقة الليلة؟‬
‫- يُفترض ذلك‬

404
00:26:03,612 --> 00:26:05,906
‫أخبرتني مؤخراً بأنّها تنوي‬
‫ترك العمل‬

405
00:26:06,699 --> 00:26:09,577
‫ثم تشتري حقيبة‬
‫وتقول إنّ هذه المرة الأخيرة‬

406
00:26:09,910 --> 00:26:12,329
‫- وبالطبع كانت تعود دائماً‬
‫- أكانت ستترك العمل؟‬

407
00:26:12,913 --> 00:26:15,166
‫أجل، في الحقيقة...‬

408
00:26:15,624 --> 00:26:17,751
‫في الأسبوعين الماضيين‬
‫تلقيت اتصالات من فتاة أخرى‬

409
00:26:17,877 --> 00:26:21,255
‫تقول إنّ (سكارليت) أعطتها معلوماتي‬
‫لها نفس الصوت المتحفظ‬

410
00:26:22,506 --> 00:26:25,926
‫قالت الفتاة إنّها تريد العمل معي‬
‫عندما تستقيل (سكارليت)‬

411
00:26:26,719 --> 00:26:28,304
‫ما اسم هذه الفتاة؟‬

412
00:26:28,721 --> 00:26:32,099
‫لا أهتم بالأسماء في البداية‬
‫ولكن لديّ رقمها‬

413
00:26:35,686 --> 00:26:37,062
‫لمَ لا تتصل بها؟‬

414
00:26:57,249 --> 00:26:59,877
‫(ديغر)، لمَ تتصل بي الآن؟‬

415
00:27:17,465 --> 00:27:19,175
‫يمكنكِ فعل ذلك في وقتكِ سيّدتي‬
‫هلاّ تجلسين‬

416
00:27:24,548 --> 00:27:26,216
‫شكراً جزيلاً سيّدتي‬

417
00:27:28,677 --> 00:27:30,887
‫من أين لكِ مفاتيح (سكارليت ماركيز)؟‬

418
00:27:31,388 --> 00:27:34,307
‫أخذت المفاتيح عندما ذهبت‬
‫لأقدّم التعازي لـ(فيكتور)‬

419
00:27:34,891 --> 00:27:36,810
‫أعرف أنّه تصرّف سيئ‬
‫ولكن لم أستطع الانتظار‬

420
00:27:36,977 --> 00:27:38,895
‫ليس تصرفاً سيئاً، بل جريمة‬

421
00:27:39,729 --> 00:27:41,565
‫أردتِ الحصول على الحبوب‬

422
00:27:41,815 --> 00:27:45,819
‫هذا هراء‬
‫فتحت الخزنة بداعي الفضول‬

423
00:27:46,445 --> 00:27:48,113
‫لم أعرف أنّ الخزنة‬
‫تحتوي على حبوب‬

424
00:27:48,697 --> 00:27:50,991
‫ببساطة أردت قياس النوافذ‬
‫لأجل ستائر جديدة‬

425
00:27:51,366 --> 00:27:52,993
‫سأكون الرئيسة الجديدة للجنة‬

426
00:27:53,535 --> 00:27:55,036
‫لمَ لا ننتظر حتى يصبح‬
‫الأمر رسمياً؟‬

427
00:27:55,620 --> 00:27:57,456
‫هل أنا هنا لأنّ المفاتيح بحوزتي؟‬

428
00:27:58,748 --> 00:28:01,501
‫وضّحي طبيعة علاقتكِ‬
‫بـ(وارديل ساغز)‬

429
00:28:02,085 --> 00:28:04,713
‫- من؟‬
‫- (ديغر)‬

430
00:28:06,840 --> 00:28:09,134
‫- أعجبت بمجوهراته‬
‫- حسناً‬

431
00:28:10,051 --> 00:28:12,846
‫أتعرفين أنّ (سكارليت ماركيزا)‬
‫كانت تبيع عقاقير محظورة‬

432
00:28:12,971 --> 00:28:15,307
‫- في فيلا (مارسانتي)؟‬
‫- ومن لم يعرف بذلك؟‬

433
00:28:16,224 --> 00:28:18,810
‫حسناً، باستثنائكم جميعاً‬

434
00:28:20,520 --> 00:28:23,190
‫إن كان الجميع يعرفون‬
‫لمَ لم يخبرنا أحد؟‬

435
00:28:23,732 --> 00:28:27,360
‫ليتعرض للنبذ والكلام السوقي‬
‫وكل ذلك؟‬

436
00:28:28,111 --> 00:28:30,530
‫- هذا احتمال بعيد‬
‫- كان عملها يزدهر‬

437
00:28:30,697 --> 00:28:33,200
‫وأردتِ مشاركتها‬
‫ربما أكثر من اللازم‬

438
00:28:33,658 --> 00:28:35,368
‫لذا قتلتها؟ رجاءً‬

439
00:28:35,911 --> 00:28:37,496
‫اسمع، كانت تاجرة مخدرات‬

440
00:28:38,163 --> 00:28:39,873
‫لا بدّ أنّ قاتلها‬
‫ممن كانت تتعامل معهم‬

441
00:28:40,916 --> 00:28:43,502
‫- أو التجّار الآخرين‬
‫- أو منافسين أقوياء للغاية‬

442
00:28:43,627 --> 00:28:45,086
‫موجودين في داخل مجتمعهم؟‬

443
00:28:45,754 --> 00:28:49,049
‫لم تجدوا المخدرات أو السم‬
‫معي أو في منزلي‬

444
00:28:49,424 --> 00:28:51,718
‫المفاتيح أخذت بعد أن قُتلت‬

445
00:28:52,427 --> 00:28:54,888
‫وفتحت الخزنة من باب الفضول فحسب‬

446
00:28:55,263 --> 00:29:01,019
‫ربطت نظريتك بناءً على محادثات عادية‬
‫أجريتها مع تاجر مخدرات‬

447
00:29:01,561 --> 00:29:02,938
‫أهذا يلخص القضية؟‬

448
00:29:03,605 --> 00:29:05,315
‫تبدو القضية ضعيفة‬
‫عندما تصيغها بهذا الشكل‬

449
00:29:05,690 --> 00:29:08,944
‫- أجل، إنّها رائعة، أليس كذلك؟‬
‫- أجل‬

450
00:29:09,402 --> 00:29:13,823
‫علينا إطلاق سراحها الآن‬
‫ولكن أظنّ المراقبة السريّة قد تساعدنا‬

451
00:29:18,286 --> 00:29:20,789
‫إن كنت تفكر باستخدامه‬
‫لا تفعل، فهو لا يناسبك‬

452
00:29:21,623 --> 00:29:23,166
‫ما رأيك في النساء الأكبر سناً؟‬

453
00:29:24,167 --> 00:29:26,962
‫لمَ هذا السؤال؟ لا أفكر في النساء‬
‫الأكبر سناً، والدتي كبيرة في السن‬

454
00:29:27,170 --> 00:29:30,340
‫لا أقصد الطاعنات في السن‬
‫أكبر سناً منك بقليل، أتفهم؟‬

455
00:29:31,633 --> 00:29:34,344
‫لمَ تسأل؟ لا تحاول تدبير‬
‫موعد لي مع إحداهن، صحيح؟‬

456
00:29:35,470 --> 00:29:38,473
‫اتضح من الأدلة العلمية‬
‫الموجودة على الأنترنت‬

457
00:29:38,598 --> 00:29:41,309
‫أنّهن يعانين من مشكلات عاطفية أقل‬
‫ويحبون أنفسهن أكثر من الشابات‬

458
00:29:41,434 --> 00:29:42,811
‫وهنّ في فترة الذروة الجنسية‬

459
00:29:43,353 --> 00:29:44,854
‫أعني، هذا ما تقوله الأبحاث‬

460
00:29:46,314 --> 00:29:47,941
‫ماذا حدث لك في ذلك النادي؟‬

461
00:29:50,569 --> 00:29:53,113
‫لا شيء، أقصد أنّ...‬
‫لقد كشفتنا‬

462
00:29:57,075 --> 00:30:00,120
‫مساء الخير أيّها الشابين‬
‫كنت أعدّ شطائر الـ(بانيني)‬

463
00:30:00,245 --> 00:30:01,621
‫وفكرت في أن أحضر لكما بعضاً منها‬

464
00:30:02,747 --> 00:30:04,958
‫- شكراً لكِ سيّدتي‬
‫- ولتكونا على علم‬

465
00:30:05,083 --> 00:30:09,004
‫أنا متجهة إلى النادي لجلسة تدليك‬
‫لذا ليس عليكما مراقبتي عن كثب‬

466
00:30:09,379 --> 00:30:11,965
‫استرخيا وكلا قليلاً‬
‫سأراكما هناك‬

467
00:30:12,340 --> 00:30:13,717
‫حاضر سيّدتي‬

468
00:30:17,095 --> 00:30:19,389
‫حاضر سيّدتي، شكراً لكِ سيّدتي‬
‫ما خطبك؟‬

469
00:30:19,889 --> 00:30:21,891
‫- حسناً، لقد فاجأتني‬
‫- ماذا في الشطيرتين؟‬

470
00:30:22,017 --> 00:30:24,227
‫إنّها شطائر الـ(بانيني)‬
‫إن لم تمانع‬

471
00:30:25,312 --> 00:30:28,398
‫- تحتوي على اللحم والجبن‬
‫- ومن يعرف ماذا تحتوي أيضاً؟‬

472
00:30:33,653 --> 00:30:35,030
‫"يا للهول!"‬

473
00:30:37,490 --> 00:30:38,867
‫المخدرات؟‬

474
00:30:39,909 --> 00:30:41,286
‫لا أصدّق هذا‬

475
00:30:42,162 --> 00:30:45,707
‫كانت زوجتك تستخدم المجوهرات‬
‫كغطاء لتبيع العقاقير‬

476
00:30:46,124 --> 00:30:49,210
‫خاصةً المسكنات‬
‫وحبوب الهلوسة والحمية‬

477
00:30:49,711 --> 00:30:53,256
‫كان بعض الحبوب مصدرها (المكسيك)‬
‫والبعض الآخر تتم سرقته من الصيدليات‬

478
00:30:55,467 --> 00:30:57,010
‫تبدو متفاجئاً فعلاً‬

479
00:30:57,385 --> 00:31:00,388
‫- الكثيرون هنا عرفوا بهذا الأمر‬
‫- لم أكن أعرف‬

480
00:31:02,724 --> 00:31:04,601
‫أنت لا تعتقد أنني متورط‬
‫بهذا الأمر‬

481
00:31:04,934 --> 00:31:09,564
‫- كانت لديها كمية كبيرة‬
‫- لم يكن لي علاقة بالأمر‬

482
00:31:09,689 --> 00:31:13,151
‫كيف لا تعرف وهي التي كانت توزع‬
‫على نصف نساء الحي؟‬

483
00:31:13,401 --> 00:31:14,778
‫لقد كذبت عليّ‬

484
00:31:19,366 --> 00:31:21,951
‫ربما كانت تحاول حمايتي من العار‬

485
00:31:22,535 --> 00:31:24,871
‫أو ربما كان من الأسهل‬
‫التغاضي عن الأمر‬

486
00:31:25,413 --> 00:31:27,248
‫- طالما تكسبان المال الوفير‬
‫- لا‬

487
00:31:27,957 --> 00:31:32,128
‫لو عرفت بحقيقة عملها‬
‫لحاولت إيقافها‬

488
00:31:34,756 --> 00:31:37,050
‫- مرحباً، أنا (باتريك)‬
‫- (أوسكار)‬

489
00:31:37,592 --> 00:31:39,135
‫أتود التحدث يا (أوسكار)؟‬

490
00:31:55,902 --> 00:31:58,697
‫- تحدث أمور سيئة، أليس كذلك؟‬
‫- أجل‬

491
00:32:01,282 --> 00:32:04,202
‫- يؤسفني ما حدث لوالدتك‬
‫- وأنا كذلك‬

492
00:32:05,412 --> 00:32:08,415
‫والدي حزين لأنّكم عاجزين‬
‫عن إيجاد القاتل‬

493
00:32:09,916 --> 00:32:11,334
‫ولكن هذا لا يزعجني‬

494
00:32:12,711 --> 00:32:14,170
‫أنا أريد عودتها فحسب‬

495
00:32:16,214 --> 00:32:18,508
‫لا يمكنها أن تعود‬
‫تعرف ذلك، صحيح؟‬

496
00:32:19,175 --> 00:32:21,678
‫أعرف هذا‬
‫أنا في التاسعة من عمري‬

497
00:32:23,304 --> 00:32:25,890
‫لن أراها مجدداً‬
‫حتى أموت أنا أيضاً‬

498
00:32:27,225 --> 00:32:28,935
‫ثم سأبقى معها في السماء‬

499
00:32:29,310 --> 00:32:30,687
‫حسناً، تبدو فكرة جميلة‬

500
00:32:32,355 --> 00:32:35,150
‫ولكن أتعلم ما لاحظت أنّك بارع فيه‬
‫ويمكنه مساعدتك الآن؟‬

501
00:32:36,025 --> 00:32:37,402
‫ما هو؟‬

502
00:32:38,445 --> 00:32:39,821
‫التظاهر والتخيّل‬

503
00:32:41,114 --> 00:32:44,909
‫- أجل، أنا كذلك‬
‫- أنت بارع في ذلك‬

504
00:32:45,869 --> 00:32:49,873
‫إن أراد بارع مثلك التحدث إلى والدته‬
‫فيمكنه تخيّل وجودها وفعل ما يشاء‬

505
00:32:49,998 --> 00:32:52,083
‫- أنا أفعل ذلك دائماً‬
‫- هل تتحدث مع والدتي؟‬

506
00:32:52,208 --> 00:32:54,169
‫لا، ليس مع والدتك‬
‫أتحدث مع زوجتي‬

507
00:32:55,295 --> 00:32:57,547
‫- أهي ميّتة؟‬
‫- أجل، أجل‬

508
00:32:57,922 --> 00:33:00,550
‫ولكنني أتحدث إليها دائماً‬
‫عليك تجربة ذلك، فهو رائع‬

509
00:33:01,676 --> 00:33:04,137
‫- أظنّ ذلك‬
‫- حسناً، لا يهم‬

510
00:33:06,097 --> 00:33:07,474
‫هذا جميل‬

511
00:33:08,725 --> 00:33:10,101
‫أتجيد استخدام هذا السيف؟‬

512
00:33:10,685 --> 00:33:12,061
‫لا بأس بقدراتي‬

513
00:33:13,480 --> 00:33:14,856
‫حقاً؟‬

514
00:33:15,482 --> 00:33:16,858
‫"احذر"‬

515
00:33:18,651 --> 00:33:20,028
‫لقد نلت منك‬

516
00:33:23,281 --> 00:33:24,783
‫أرجوك، الرحمة‬

517
00:33:25,533 --> 00:33:26,910
‫الرحمة‬

518
00:33:28,578 --> 00:33:31,873
‫ها هي المرأة الجميلة‬
‫(دارتانيان)، عليّ الذهاب، إلى اللقاء‬

519
00:33:32,248 --> 00:33:36,711
‫"(مارسانتي)، نادي المدينة"‬

520
00:33:40,298 --> 00:33:43,301
‫- تستغرق المنتجعات وقتاً طويلاً‬
‫- كم يتطلب التدليك وقتاً؟‬

521
00:33:43,760 --> 00:33:47,597
‫هناك أمور أخرى بجانب التدليك‬
‫كالعناية بالوجه وإزالة الشعر وقناع الطين‬

522
00:33:48,139 --> 00:33:50,975
‫- كيف تعرف هذه المعلومات الكثيرة؟‬
‫- اشتريت شهادة لوالدتي‬

523
00:33:53,019 --> 00:33:57,106
‫(واين)، لقد عدت مجدداً‬
‫كم هذا رائع‬

524
00:33:57,482 --> 00:34:01,069
‫- مرحباً سيّدة (شيبر)‬
‫- عليك مناداتي (جاكي)‬

525
00:34:01,194 --> 00:34:03,112
‫وأنا آنسة ولست سيّدة‬

526
00:34:03,530 --> 00:34:06,407
‫- فأنا مطلقة‬
‫- المعذرة (جاكي)‬

527
00:34:07,200 --> 00:34:08,576
‫كان رجلاً طيّباً‬

528
00:34:08,868 --> 00:34:12,038
‫ولكنّه ضعيف‬
‫لم يستطع أن يرى...‬

529
00:34:12,163 --> 00:34:14,165
‫- مهلاً، ماذا تضعين على شفتيكِ؟‬
‫- المعذرة؟‬

530
00:34:14,582 --> 00:34:16,084
‫ما اسم هذا اللون؟‬

531
00:34:16,292 --> 00:34:18,127
‫اسمه "السخرية"‬
‫هل أعجبك؟‬

532
00:34:18,419 --> 00:34:21,464
‫- من أين حصلتِ عليه؟‬
‫- اشتريته من متجر في البلدة‬

533
00:34:21,589 --> 00:34:24,217
‫- منذ متى تستخدمينه؟‬
‫- اشتريته اليوم‬

534
00:34:24,634 --> 00:34:27,011
‫رأيت (بيشنس برودبينت)‬
‫تضعه في حفلة (سكارليت)‬

535
00:34:27,178 --> 00:34:29,889
‫وكان عليّ شراؤه‬
‫سعره مرتفع جداً ولكن لا يهم‬

536
00:34:30,014 --> 00:34:31,724
‫وأنتِ واثقة‬
‫من أنّه أحمر شفاه "السخرية"؟‬

537
00:34:32,225 --> 00:34:34,352
‫- أحمله معي هنا‬
‫- وأنتِ واثقة من أنّكِ رأيتِ (بيشنس)‬

538
00:34:34,477 --> 00:34:37,480
‫- تضعه أولاً بحفلة (سكارليت ماركيزا)؟‬
‫- أهذه جملة مغازلة؟‬

539
00:34:39,023 --> 00:34:40,483
‫المعذرة، ما هذا؟‬

540
00:34:41,693 --> 00:34:43,528
‫"أين؟ يا للهول!"‬

541
00:35:03,588 --> 00:35:05,632
‫"مسرح جريمة، يُمنع العبور"‬

542
00:35:09,458 --> 00:35:10,918
‫لا وجود للبصمات على السكين‬

543
00:35:11,877 --> 00:35:13,754
‫- وكاميرات المراقبة؟‬
‫- لا يستخدمها المنتجع‬

544
00:35:13,879 --> 00:35:15,464
‫اتباعاً لمبدأ (تشي)‬

545
00:35:16,006 --> 00:35:18,509
‫لا أفهم، لمَاذا قُتلت (بيشنس)؟‬
‫ولمَاذا الآن؟‬

546
00:35:18,759 --> 00:35:20,511
‫ربما كان جزءاً من الخطة‬
‫منذ البداية‬

547
00:35:20,719 --> 00:35:23,931
‫لا، هذه جريمة متهورة‬
‫أصبحت (بيشنس) هدفاً جديداً‬

548
00:35:24,264 --> 00:35:25,891
‫أكان انتقاماً لمقتل (سكارليت)؟‬

549
00:35:26,350 --> 00:35:27,893
‫كان (فيكتور) سريع الغضب‬

550
00:35:28,602 --> 00:35:31,438
‫(ريغزبي)، تحقق من أماكن‬
‫تواجد (فيكتور ماركيزا) مؤخراً‬

551
00:35:31,563 --> 00:35:33,273
‫- حاضر أيّتها المديرة‬
‫- ربما قتلها شخص آخر‬

552
00:35:33,399 --> 00:35:36,944
‫المنافسة تقتل تاجرة المخدرات‬
‫وخليفتها، أو...‬

553
00:35:38,779 --> 00:35:40,155
‫أو ماذا؟‬

554
00:35:41,448 --> 00:35:42,950
‫تنطبق التهمة على (فيكتور)‬
‫بشكل مناسب، صحيح؟‬

555
00:35:44,451 --> 00:35:45,828
‫أجل‬

556
00:35:52,167 --> 00:35:53,961
‫أتصدّقين أنّ (بيشنس) تعرضت للطعن؟‬

557
00:35:54,420 --> 00:35:58,674
‫وكأنّها جريمة من المافيا‬
‫لن أدخل المنتجع مجدداً‬

558
00:35:59,466 --> 00:36:02,511
‫سلسلة أحداث مأساوية‬
‫لم أتوقع حدوث ذلك‬

559
00:36:03,846 --> 00:36:06,014
‫ما رأيك؟ أتعتقد أنّ هذه حرب‬
‫بين تجار المخدرات؟‬

560
00:36:06,390 --> 00:36:10,352
‫ربما، ولكن جرائم الطعن‬
‫عادةً تكون جرائم انفعالية‬

561
00:36:10,477 --> 00:36:12,521
‫هذه جريمة شخصية للغاية‬

562
00:36:13,981 --> 00:36:18,026
‫- إذن ما الخطوة التالية؟‬
‫- يجمع مكتب التحقيقات الأدلة‬

563
00:36:18,402 --> 00:36:19,778
‫في الحقيقة...‬

564
00:36:21,488 --> 00:36:23,240
‫- لا عليكما‬
‫- ما الأمر؟‬

565
00:36:23,365 --> 00:36:26,827
‫لا، لا ينبغي أن أتحدث‬
‫عن قضية ما زالت مفتوحة‬

566
00:36:26,952 --> 00:36:31,373
‫- لا يمكنك ترك الموضوع معلقاً هكذا‬
‫- المعذرة، لكنني سأورط نفسي بمشكلة‬

567
00:36:33,876 --> 00:36:35,252
‫بحقكما‬

568
00:36:36,754 --> 00:36:41,216
‫حسناً، اسمعا‬
‫أتعدانني أن يبقى الأمر سراً بيننا؟‬

569
00:36:41,425 --> 00:36:43,051
‫- أجل، بالطبع نعدك‬
‫- أتعدانني؟‬

570
00:36:43,177 --> 00:36:44,970
‫حسناً، نحن نلاحق (فيكتور ماركيزا)‬

571
00:36:45,471 --> 00:36:48,640
‫(فيكتور)؟ لا أصدّق ذلك‬
‫لا يبدو أنّه مجرماً‬

572
00:36:48,891 --> 00:36:51,226
‫- على أيّ أساس؟‬
‫- نعتقد أنّه قتل (بيشنس)‬

573
00:36:51,351 --> 00:36:53,145
‫انتقاماً لمقتل زوجته‬

574
00:36:53,437 --> 00:36:55,564
‫ولكن قلت إن ما من دليل‬
‫يثبت إدانة (بيشنس)‬

575
00:36:55,981 --> 00:36:58,317
‫أعتقد أنّ (فيكتور)‬
‫لم يرد الانتظار ليظهر دليل‬

576
00:36:58,776 --> 00:37:00,152
‫ماذا سيحدث لـ(أوسكار)؟‬

577
00:37:00,569 --> 00:37:02,446
‫والدته قتلت‬
‫والآن والده أصبح قاتلاً‬

578
00:37:03,071 --> 00:37:05,491
‫سيوضع في دار رعاية‬
‫بعد القبض على والده‬

579
00:37:05,616 --> 00:37:06,992
‫كم هذا مروّع‬

580
00:37:07,576 --> 00:37:09,828
‫- الفتى المسكين‬
‫- مسكين فعلاً‬

581
00:37:21,048 --> 00:37:22,424
‫أظنّ أنّهما لم تقدرا على كتم السر‬

582
00:37:23,467 --> 00:37:24,843
‫أظنّ ذلك‬

583
00:37:26,637 --> 00:37:28,013
‫لنفعل ذلك‬

584
00:37:29,848 --> 00:37:31,350
‫- "ستكون الأمور بخير بنيّ"‬
‫- "أبي"‬

585
00:37:31,517 --> 00:37:34,102
‫- أعدك أنّ الأمور ستكون بخير‬
‫- لا‬

586
00:37:34,228 --> 00:37:37,022
‫- أين تذهب؟ لا‬
‫- لا تقلق، سأعود‬

587
00:37:37,606 --> 00:37:40,442
‫- أبي، أبي‬
‫- لا بأس‬

588
00:37:40,859 --> 00:37:42,945
‫ارجع، لا‬

589
00:37:43,362 --> 00:37:44,738
‫أبي‬

590
00:37:45,489 --> 00:37:47,866
‫- أبي، أبي‬
‫- توقف، عليك إيقاف هذا‬

591
00:37:47,991 --> 00:37:51,203
‫- لا يمكننا ذلك، تأخذ العدالة مجراها‬
‫- كيف تقول هذا؟‬

592
00:37:51,328 --> 00:37:54,331
‫- انظر لما يعانيه الفتى‬
‫- لا بأس، سينسى الأمر‬

593
00:37:54,456 --> 00:37:56,250
‫- لا، لن ينسى‬
‫- لا بأس‬

594
00:37:56,375 --> 00:37:59,461
‫- لماذا؟‬
‫- لأنّني الفاعلة، أنا قتلتهما‬

595
00:38:00,963 --> 00:38:02,548
‫أنا قتلتهما‬

596
00:38:03,465 --> 00:38:04,967
‫يا للهول!‬

597
00:38:17,771 --> 00:38:22,526
‫اشتبهت بكِ في البداية لأنّ الجميع‬
‫في النادي يرتدي مجوهرات (سكارليت)‬

598
00:38:23,402 --> 00:38:24,778
‫باستثنائك‬

599
00:38:25,445 --> 00:38:27,990
‫أهذا كل شيء؟ المجوهرات؟‬

600
00:38:28,448 --> 00:38:32,411
‫شعرت بألمكِ وغضبكِ أكثر‬
‫كلما تحدثنا‬

601
00:38:34,580 --> 00:38:38,083
‫- فقدانكِ لابنتكِ جعلكِ مضطربة‬
‫- مضطربة؟‬

602
00:38:40,335 --> 00:38:43,380
‫أجل، أعتقد ذلك‬

603
00:38:47,134 --> 00:38:48,510
‫ابنتي‬

604
00:38:51,597 --> 00:38:52,973
‫(ريتشيل)‬

605
00:38:55,017 --> 00:38:56,393
‫لقد أحبت الرقص‬

606
00:38:57,436 --> 00:39:01,023
‫كانت ترقص على جميع‬
‫أنواع الموسيقى‬

607
00:39:02,858 --> 00:39:05,319
‫كانت مفعمة بالحياة‬

608
00:39:08,447 --> 00:39:12,367
‫تناولت الكحول مع مسكنات عديدة‬
‫قبل أن تقود السيارة‬

609
00:39:14,202 --> 00:39:18,290
‫أخذت صديقتها المسكنات من والدتها‬
‫التي أخذتها بدورها من (سكارليت)‬

610
00:39:19,082 --> 00:39:20,459
‫أنا أتفهّم غضبكِ‬

611
00:39:21,293 --> 00:39:23,045
‫وكأنّهم سلبوا مني روحي‬

612
00:39:24,880 --> 00:39:28,258
‫ولكنّ العالم نسي ما حدث‬

613
00:39:29,885 --> 00:39:32,304
‫وكأنني الوحيدة التي تتذكر ما حدث‬

614
00:39:34,348 --> 00:39:38,268
‫"لذلك عندما رأيتها تتنقل في المدينة"‬

615
00:39:38,852 --> 00:39:41,104
‫"وتبيع الحبوب‬
‫من دون أيّ اهتمام"‬

616
00:39:42,022 --> 00:39:44,191
‫وما زالت تقيم الحفلات في منزلها‬

617
00:39:45,192 --> 00:39:48,570
‫ترقص سعيدةً من دون اهتمام للمعاناة‬
‫التي كنت أتحملها‬

618
00:39:48,862 --> 00:39:50,238
‫"انهرت"‬

619
00:39:53,533 --> 00:39:54,910
‫وقتلتها‬

620
00:40:02,834 --> 00:40:07,089
‫"لم أرد لأيّ شخص أن يمرّ‬
‫بما عانيته"‬

621
00:40:16,348 --> 00:40:17,724
‫"والآن أصبحنا متعادلتين"‬

622
00:40:24,064 --> 00:40:25,440
‫وماذا عن (بيشنس)؟‬

623
00:40:26,191 --> 00:40:28,235
‫قالت لعضوات النادي ألا يقلقن‬

624
00:40:29,152 --> 00:40:32,280
‫إذ كانت تخطط لتولي منصب‬
‫(سكارليت) وتستمر بتجارة الحبوب‬

625
00:40:33,824 --> 00:40:35,200
‫"وكأنّ شيئاً لم يحدث"‬

626
00:40:36,201 --> 00:40:37,995
‫"وكأنّهن لم يأخذن عبرةً مما حدث"‬

627
00:40:40,122 --> 00:40:41,790
‫كان عليّ أن أكمل ما بدأته‬

628
00:40:44,126 --> 00:40:45,502
‫كان عليّ أن أفعل ذلك‬

629
00:40:50,465 --> 00:40:52,551
‫سأنسخ الشريط على ورقة لتوقعيها‬

630
00:41:00,267 --> 00:41:02,144
‫أتشعرين بتحسّن بعد أن انتهى الأمر؟‬

631
00:41:07,107 --> 00:41:08,859
‫لم يتغيّر شيء‬

632
00:41:20,203 --> 00:41:22,330
‫- العميلة (ليزبن)‬
‫- سيّد (ماركيزا)‬

633
00:41:22,706 --> 00:41:26,043
‫- مرحباً‬
‫- أود شكركِ أنتِ وفريقك‬

634
00:41:26,710 --> 00:41:28,754
‫لكن عليّ الاعتراف‬
‫أنّ التمثيلية أمام المنزل...‬

635
00:41:28,879 --> 00:41:31,590
‫- كان تظاهراً يا أبي‬
‫- أعتذر‬

636
00:41:31,882 --> 00:41:36,386
‫كان التظاهر غير تقليدي‬
‫ومزعجاً ولكن...‬

637
00:41:36,803 --> 00:41:39,556
‫- ولكنني واثق من أنّكم تجيدون عملكم‬
‫- معظم الأحيان‬

638
00:41:40,807 --> 00:41:45,562
‫- أعتذر إن قسونا عليك‬
‫- لا، فهذا ما كنت بحاجة إلى سماعه‬

639
00:41:46,438 --> 00:41:50,734
‫سنغادر فيلا (مارسانتي)‬
‫سنعود إلى بلدتي‬

640
00:41:51,693 --> 00:41:54,362
‫أنا وابني لدينا أعمال كثيرة لنفعلها‬

641
00:41:57,282 --> 00:41:59,493
‫- اعتنِ بنفسك‬
‫- شكراً لكِ‬

642
00:42:01,912 --> 00:42:03,288
‫سيّد (جاين)‬

643
00:42:05,749 --> 00:42:08,335
‫- شكراً لك‬
‫- لا داعي لذلك، انسَ الأمر‬

644
00:42:09,336 --> 00:42:12,881
‫اعتنِ بنفسك وحظاً موفقاً‬
‫إلى اللقاء‬

645
00:42:15,467 --> 00:42:18,804
‫لو تأخرت لدقيقة لما قابلتهما‬
‫أكره أن يشكرني الناس‬

646
00:42:18,970 --> 00:42:21,139
‫- لماذا؟‬
‫- يحب لعب دور "الحارس الوحيد"‬

647
00:42:21,431 --> 00:42:24,976
‫"من كان ذلك الرجل المقنّع؟‬
‫لم أتمكّن من شكره"‬

648
00:42:27,604 --> 00:42:28,980
‫بالضبط‬

649
00:42:32,484 --> 00:42:39,491
‫لا أريد أن أخيفك ولكن صديقتك (جاكي)‬
‫دخلت خلفت للتو وتبدو مثيرة‬

650
00:42:39,699 --> 00:42:42,244
‫أعرف هذا‬
‫لقد دعوتها على العشاء‬

651
00:42:45,080 --> 00:42:46,456
‫مرحباً‬

