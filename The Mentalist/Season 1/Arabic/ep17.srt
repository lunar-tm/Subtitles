1
00:00:02,060 --> 00:00:05,320
‫"المتلاعب الذهني، اسم"‬

2
00:00:05,753 --> 00:00:10,925
‫"شخص يستخدم الذكاء العقلي‬
‫أو التنويم المغناطيسي و/أو الاقتراح"‬

3
00:00:11,509 --> 00:00:14,304
‫"متلاعب بارع بالأفكار والتصرّفات"‬

4
00:00:25,330 --> 00:00:27,374
‫إنّه من مكتب المدّعي العام‬
‫سنتولّى أمر قضيّة كبيرة‬

5
00:00:27,479 --> 00:00:32,275
‫- مرحى، كدت أجنّ من الضجر‬
‫- لا تقل مرحى، فقد توفي أحدهم‬

6
00:00:32,628 --> 00:00:35,506
‫حسناً، إن توفي أحدهم‬
‫ففرحتي لا تشكل فارقاً بالنسبة إليّه‬

7
00:00:35,862 --> 00:00:37,489
‫ولن يشكل القبض على القاتل‬
‫فارقاً له أيضاً‬

8
00:00:37,697 --> 00:00:39,950
‫صحيح، لكنّه سيشكّل فارقاً‬
‫بالنسبة إلى القاتل‬

9
00:00:41,117 --> 00:00:43,620
‫وصل هذا البريد الإلكتروني‬
‫إلى مكتب المدّعي العام‬

10
00:00:43,745 --> 00:00:45,497
‫ومكتب الحاكم قبل ٢٠ دقيقة‬

11
00:00:45,789 --> 00:00:49,292
‫"انتباه، عند الساعة ١١:٠٥ صباح اليوم"‬

12
00:00:49,417 --> 00:00:54,589
‫"عند الإحداثيات ٣٥.٠٤ شمالاً‬
‫و١١٦.٤٩ غرباً"‬

13
00:00:54,923 --> 00:00:58,510
‫"سترون شخصاً متعجرفاً وجشعاً‬
‫يُعاقب بالموت"‬

14
00:00:58,802 --> 00:01:00,470
‫"وستعلمون حينها أنّني جادّ"‬

15
00:01:00,637 --> 00:01:02,472
‫"التوقيع، المواطن المثالي الافتراضي"‬

16
00:01:02,806 --> 00:01:04,391
‫- مثير للاهتمام‬
‫- على الأرجح الأمر غير مهم‬

17
00:01:04,516 --> 00:01:06,351
‫إذاً، لماذا لا تتولى الشرطة المحليّة هذا الأمر؟‬

18
00:01:06,476 --> 00:01:08,562
‫قام أحمقّ بجعل الحاكم‬
‫يقوم بقراءة هذه الرسالة المشؤومة‬

19
00:01:08,687 --> 00:01:11,273
‫لذا تحدّث إلى المدّعي العام‬
‫وتحدث المدّعي العام إلى (منيللي)‬

20
00:01:11,398 --> 00:01:13,525
‫وأخبرني (منيللي)‬
‫بأنّ علينا تولّي هذا الأمر شخصياً‬

21
00:01:13,817 --> 00:01:15,318
‫أنتَ السائق الأسرع يا (ريغسبي)‬

22
00:01:15,443 --> 00:01:17,988
‫إن تحرّكنا الآن على الفور‬
‫فسنصل عند الساعة الـ١١:٠٥‬

23
00:01:18,321 --> 00:01:21,032
‫- أين المكان؟‬
‫- صحراء (موهافي)، وسط المجهول‬

24
00:01:21,324 --> 00:01:23,660
‫- يبعد ٤٠٠ متر عن الطريق العام‬
‫- مثير للاهتمام‬

25
00:01:23,952 --> 00:01:25,829
‫بل مضجر‬
‫فهي تبعد ٣ ساعات من هنا‬

26
00:01:25,954 --> 00:01:27,497
‫الصحراء جميلة بهذا الوقت من العام‬

27
00:01:29,833 --> 00:01:31,209
‫لنذهب جميعاً‬

28
00:01:33,253 --> 00:01:34,713
‫يمكننا جلب غداء النزهة معنا‬

29
00:01:40,176 --> 00:01:41,970
‫على أحدكم البقاء هنا للرد على المكالمات‬

30
00:01:52,105 --> 00:01:56,818
{\an8}‫"صحراء (موهافي)، (كاليفورنيا)"‬

31
00:02:00,155 --> 00:02:02,449
‫- كم نبعد عن المكان؟‬
‫- نحو ١٥ متراً‬

32
00:02:04,409 --> 00:02:06,536
‫انظروا إلى هذا، انظروا على ماذا عثرت‬

33
00:02:07,412 --> 00:02:12,125
‫- ماذا وجدت؟‬
‫- إنّها دودة، إنّها دودة متحجّرة‬

34
00:02:12,250 --> 00:02:13,710
‫سُررت من أجلك‬

35
00:02:15,045 --> 00:02:17,213
‫حسناً، ها قد وصلنا‬
‫هذا هو الموقع‬

36
00:02:18,381 --> 00:02:21,968
‫الساعة الـ١١:٠٤ وها هي تتقدم‬
‫وصلنا بالوقت المحدد‬

37
00:02:22,594 --> 00:02:24,763
‫- من أجل ماذا؟‬
‫- بقي ١٥ ثانية على ذلك‬

38
00:02:25,138 --> 00:02:26,514
‫أتعلمون بأنّه حين كانت هذه الدودة‬
‫على قيد الحياة‬

39
00:02:26,640 --> 00:02:29,267
‫كانت هذه الصحراء بأكملها‬
‫أرضاً لبحرٍ كبير‬

40
00:02:29,768 --> 00:02:31,686
‫كان هناك ديناصورات تسبح فوقنا‬

41
00:02:32,103 --> 00:02:33,772
‫- إنّه أمر رائع‬
‫- أجل‬

42
00:02:35,106 --> 00:02:38,234
‫أسماك قرش بحجم الحافلات‬
‫ووحوش بحر ملونة بشكل رائع‬

43
00:02:38,360 --> 00:02:39,861
‫هذه الجبال...‬

44
00:02:40,195 --> 00:02:41,863
‫كانت براكين‬

45
00:02:42,155 --> 00:02:43,948
‫هذا روث ماعز مضى عليه ٦ أشهر‬

46
00:02:46,368 --> 00:02:49,954
‫مع ذلك، يوجد أسماك قرش ضخمة هنا‬

47
00:02:52,040 --> 00:02:55,627
‫حسناً، لقد أدّينا مهمتنا‬
‫أحدهم أزعجنا جيداً، لنعد أدراجنا‬

48
00:02:56,252 --> 00:02:57,712
‫مهلاً، أظن أنّ علينا الانتظار‬

49
00:02:58,755 --> 00:03:00,548
‫لماذا؟ ماذا يمكن أن يحدث؟‬

50
00:03:01,049 --> 00:03:04,636
‫ليس لديّ أدنى فكرة‬
‫لكنّه موقع جميل وبحوزتي شطائر‬

51
00:03:04,761 --> 00:03:06,680
‫سنتناولها في السيارة‬
‫أضعنا ما يكفي من الوقت‬

52
00:03:06,846 --> 00:03:08,598
‫مهلاً، أسمعتم ذلك؟‬

53
00:03:09,766 --> 00:03:11,768
‫- أجل‬
‫- ما هذا الصوت؟‬

54
00:03:30,982 --> 00:03:32,859
‫"أجل، اسم الضحيّة (ديفيد ويتيكر)"‬

55
00:03:32,964 --> 00:03:34,633
‫"واحد من مجموعة مؤلفة‬
‫من ٦ مظليين بالقفز الحر"‬

56
00:03:34,730 --> 00:03:36,315
‫"خرجوا هذا الصباح برفقة مدرّبهم"‬

57
00:03:36,527 --> 00:03:38,737
‫"جميعهم مدراء تنفيذيين‬
‫لدى شركة ائتمان تُسمى (كارنيليان)"‬

58
00:03:38,836 --> 00:03:41,505
‫"وخرجوا من أجل مغامرة‬
‫في الهواء الطلق"‬

59
00:03:41,719 --> 00:03:44,430
‫أجل، لقد كان الضحية‬
‫نائب الرئيس لقسم الموارد البشرية‬

60
00:03:44,590 --> 00:03:47,093
‫(ديفيد ويتيكر)‬
‫شركة (كارنيليان) للائتمانيات‬

61
00:03:47,865 --> 00:03:49,366
‫دوّنت هذا، سأبدأ بالتدقيق عنه‬

62
00:03:51,214 --> 00:03:56,052
{\an8}‫أتريان هذا، هنا؟ هذا هو الحزام الرئيسي‬
‫وتمّ قطعه بشكل حادّ‬

63
00:03:56,472 --> 00:03:58,724
‫ولا بدّ أنّ هذا أمرّ متعمّد‬
‫وهو تصرّف شرير‬

64
00:03:59,051 --> 00:04:03,055
‫لأنّه بلحظة انقطاع هذا‬
‫فإنّ المظلة ستسقط مباشرة‬

65
00:04:03,180 --> 00:04:04,890
‫- من جهز المظلّة؟‬
‫- أنا‬

66
00:04:05,057 --> 00:04:08,144
{\an8}‫أنا جهزتها مساء أمس‬
‫وأعدت التحقق منها جميعها‬

67
00:04:08,269 --> 00:04:10,438
{\an8}‫وكانت بحالة جيّدة‬
‫وأنا متأكد من هذا تماماً‬

68
00:04:11,063 --> 00:04:13,941
‫- حدث هذا بعد ذلك‬
‫- من شخص يعرف بالمظلاّت‬

69
00:04:14,066 --> 00:04:15,443
{\an8}‫أجل‬

70
00:04:15,735 --> 00:04:19,447
{\an8}‫أنا أجهز المظلات منذ ١٥ عاماً‬
‫ولم أواجه أيّ حادثة أبداً‬

71
00:04:19,655 --> 00:04:24,827
‫هناك رقم عليها‬
‫هل من طريقة لتحديد صاحب المظلة؟‬

72
00:04:25,328 --> 00:04:26,829
‫هل هي مخصّصة للأفراد؟‬

73
00:04:27,163 --> 00:04:32,084
{\an8}‫أطلب من القافزين أن يأخذوا أيّ مظلة أمامهم‬
‫هذه الأرقام مخصصة لسجلات الصيانة‬

74
00:04:32,668 --> 00:04:34,629
{\an8}‫حسنا، من يمكنه الوصول إلى المظلات‬
‫بعد تجهزيهم؟‬

75
00:04:34,754 --> 00:04:37,798
{\an8}‫تكون بخزينة الطائرات طوال الليل‬
‫وهي ليست مقفلة أو ما شابه‬

76
00:04:37,965 --> 00:04:40,635
‫إذاً، جميع من لديه إذاً‬
‫بالدخول إلى المطار يمكنهم ذلك‬

77
00:04:41,135 --> 00:04:42,511
‫العميلة (ليزبن)، أليس كذلك؟‬

78
00:04:43,012 --> 00:04:44,889
‫سنغادر، أبقي مكتبي على إطلاع‬
‫بما يحدث‬

79
00:04:45,181 --> 00:04:48,309
‫وأنت، سيتصل بك محاميّ‬
‫أجل، قم بذلك الآن‬

80
00:04:48,559 --> 00:04:52,063
{\an8}‫- هل ستدعينه يفلت هكذا؟‬
‫- اصمت، سيّد (فولك)‬

81
00:04:53,898 --> 00:04:58,527
‫هذا تحقيق بجريمة قتل‬
‫لا يمكنكَ الرحيل حتى نسمح لكَ بذلك‬

82
00:05:00,363 --> 00:05:03,366
{\an8}‫معذرةً، ظننت أنّنا أجبنا‬
‫عن جميع أسئلتكما‬

83
00:05:06,533 --> 00:05:08,718
{\an8}‫هلاّ تمنحينا الإذن بالمغادرة‬
‫أيتها العميلة (ليزبن)؟‬

84
00:05:08,996 --> 00:05:11,499
{\an8}‫أجل، يمكنكَ ذلك‬
‫لكنّنا سنطرح العديد من الأسئلة لاحقاً‬

85
00:05:11,666 --> 00:05:13,084
{\an8}‫تعرفون أين تجدوننا‬

86
00:05:14,029 --> 00:05:17,032
{\an8}‫أجل نعرف‬
‫سنبقى على اتصال يا سيد (فولك)‬

87
00:05:26,785 --> 00:05:28,328
{\an8}‫لماذا لم يتم نقل الجثّة بعد؟‬

88
00:05:28,474 --> 00:05:30,309
{\an8}‫ما يزال فريق جمع الأدلة‬
‫يعمل على الموقع‬

89
00:05:30,434 --> 00:05:32,853
{\an8}‫لقد سقط من السماء‬
‫علام يعملون منذ ساعة؟‬

90
00:05:33,020 --> 00:05:34,647
{\an8}‫المغفّلون، يرفضون الاستعجال‬

91
00:05:36,774 --> 00:05:38,693
{\an8}‫إذاً، من هذا الرجل (راندال فولك)؟‬

92
00:05:39,694 --> 00:05:42,530
{\an8}‫الرئيس والمدير التنفيذي‬
‫لشركة (كارنيليان) الائتمانية‬

93
00:05:43,823 --> 00:05:46,200
{\an8}‫هي إحدى أكبر عشر شركات‬
‫عقارية خاصة في العالم‬

94
00:05:46,367 --> 00:05:47,910
{\an8}‫يشترون ويبيعون شركات ضخمة‬

95
00:05:48,411 --> 00:05:51,080
{\an8}‫كشركات النفط والفولاذ‬
‫ومصانع السيارات وسلاسل الفنادق‬

96
00:05:51,205 --> 00:05:53,916
{\an8}‫- سمّ ما شئت وهم يملكونه‬
‫- الأوغاد الأثرياء‬

97
00:05:54,125 --> 00:05:56,711
{\an8}‫بمجرّد الانتهاء من الموقع‬
‫توجها أنتما إلى المطار‬

98
00:05:56,836 --> 00:05:59,296
{\an8}‫واعرفا من دخل‬
‫إلى مكان المظلات مساء أمس‬

99
00:05:59,755 --> 00:06:02,466
{\an8}‫واعرفا بشأن خلفية (سبرول)‬
‫وإن كان هناك شيء بماضيه‬

100
00:06:02,591 --> 00:06:04,051
‫- حاضر‬
‫- أجل، لكِ ذلك أيّتها الرئيسة‬

101
00:06:06,929 --> 00:06:08,389
{\an8}‫(فان بيلت)، ما الأمر؟‬

102
00:06:08,514 --> 00:06:10,933
‫- هل أنتِ قريبة من التلفاز؟‬
‫- كلاّ، لماذا؟‬

103
00:06:12,810 --> 00:06:14,186
{\an8}‫تباً‬

104
00:06:15,396 --> 00:06:16,814
{\an8}‫أتريدين شطيرتكِ؟‬

105
00:06:27,783 --> 00:06:29,243
‫أيمكنني مساعدتكما؟‬

106
00:06:29,493 --> 00:06:32,038
‫- نحن نبحث عن السيّد (فولك)‬
‫- إنّه داخل المنزل‬

107
00:06:32,163 --> 00:06:33,664
‫- شكراً لك‬
‫- شكراً‬

108
00:06:35,750 --> 00:06:37,793
‫"بعد وفاة السيّد (ويتيكر) الشنيعة"‬

109
00:06:37,918 --> 00:06:41,005
‫"تمّ خلال الساعة الماضية‬
‫إرسال رسالة إلى الشرطة"‬

110
00:06:41,338 --> 00:06:44,258
‫"وعدد من وسائل الإعلام‬
‫ومن ضمنها القناة الإخبارية الرابعة"‬

111
00:06:44,383 --> 00:06:47,053
‫"وكانت تنص على:‬
‫لقد أثبت وجهة نظري..."‬

112
00:06:47,178 --> 00:06:50,639
‫"لقد أحرزت هدفاً للرجل الصغير‬
‫وسأكرر فعلتي مجدداً"‬

113
00:06:50,765 --> 00:06:56,187
‫"إلاّ في حالة قيام شركة (كارنيليان)‬
‫بتقديم اعتذار علني بسبب جشعها وغطرستها"‬

114
00:06:56,312 --> 00:06:58,522
‫"وقطع وعد بتغيير أساليبها"‬

115
00:06:58,731 --> 00:07:00,900
‫"مع كامل الاحترام‬
‫المواطن المثالي الافتراضي"‬

116
00:07:01,442 --> 00:07:02,902
‫هراء جاهل‬

117
00:07:03,319 --> 00:07:06,113
‫ربما، لكن التهديد على حياتكم جليّ‬

118
00:07:06,572 --> 00:07:09,283
‫نحن بحاجة لتنظيم خطة أمن‬
‫مع أقسام مدير الشرطة‬

119
00:07:09,450 --> 00:07:11,285
‫متى تنوون العودة إلى المدينة؟‬

120
00:07:12,453 --> 00:07:13,829
‫لن نعود‬

121
00:07:14,497 --> 00:07:16,540
‫بل سنبقى هنا ونتابع مخططنا‬

122
00:07:16,707 --> 00:07:18,292
‫بحقك يا (راند)‬

123
00:07:18,459 --> 00:07:20,795
‫ربما عليكَ الأخذ بعين الاعتبار‬
‫ما يحصل هنا؟‬

124
00:07:20,920 --> 00:07:23,839
‫لست واثقاً من أنّ البقاء هنا‬
‫هو الوضع الأكثر أماناً‬

125
00:07:23,964 --> 00:07:28,886
‫سنبقى، لن أسمح لمعتوهٍ طائش‬
‫بأن يزعج عائلة (كارنيليان)‬

126
00:07:29,386 --> 00:07:32,431
‫هذا اختبار لقوّتنا‬
‫كان (ديفيد) ليريدنا أن نستمر‬

127
00:07:32,765 --> 00:07:35,935
‫أجل، كان ليريد هذا‬
‫ما كان (ديفيد) ليتراجع عن قراره‬

128
00:07:36,143 --> 00:07:40,689
‫أكان (ديفيد) ليريد منكم أن تقرّوا‬
‫بكل احترام موته المفاجئ والمأساوي؟‬

129
00:07:41,148 --> 00:07:45,736
‫حسناً، ما كان ليريد أن يقاطع موته‬
‫جدولكم الزمني الخاص بالتجديف‬

130
00:07:49,365 --> 00:07:52,535
‫- اسمك (جون)، أليس كذلك؟‬
‫- بل (جاين)، كاسم الفتاة‬

131
00:07:53,119 --> 00:07:55,579
‫- (جاين)‬
‫- بل سيّد (جاين)‬

132
00:07:56,747 --> 00:07:58,374
‫- سيّد (جاين)‬
‫- شكراً لك‬

133
00:07:59,416 --> 00:08:03,170
‫الأسبوع الذي قضيناه هنا ليس بعطلة‬
‫بل هو اختبار‬

134
00:08:03,754 --> 00:08:06,006
‫فما نتعلّمه هنا عن أنفسنا‬
‫وعن بعضنا البعض‬

135
00:08:06,423 --> 00:08:09,260
‫هو جوهر فلسفة‬
‫نجاح شركة (كارنيليان)‬

136
00:08:10,052 --> 00:08:13,597
‫والآن، ستحين اللحظة الملائمة‬
‫للحداد على صديقنا العزيز‬

137
00:08:15,224 --> 00:08:18,018
‫هذا هو الوقت المناسب لإظهار‬
‫العزم والشجاعة‬

138
00:08:20,855 --> 00:08:24,525
‫والآن، ربما بوسعكما إعطائنا ملخصاً‬
‫موجزاً عن مسار القضية حتى الآن‬

139
00:08:24,817 --> 00:08:27,486
‫نحن نحقق بجرائم القتل‬
‫ولا نعطي بيانات موجزة‬

140
00:08:27,695 --> 00:08:31,240
‫ولماذا؟ لدينا الحق بالمعرفة‬
‫نحن الضحايا هنا‬

141
00:08:31,365 --> 00:08:33,159
‫بل (ديفيد ويتيكر) هو الضحية هنا‬

142
00:08:33,284 --> 00:08:34,869
‫كان من الممكن لأيّ منّا‬
‫استخدام تلكَ المظلّة الغير صالحة‬

143
00:08:35,035 --> 00:08:36,871
‫وكان من الممكن لأيّ منّا‬
‫أن يكون في عِداد الأموات الآن‬

144
00:08:37,037 --> 00:08:39,665
‫أجل، لكنّ المجرم لم يعرف‬
‫أيّ منكم سيموت‬

145
00:08:39,790 --> 00:08:42,376
‫بل برأيه أيّاً منكم كان يفي بالغرض‬

146
00:08:43,460 --> 00:08:47,298
‫"جشع ومتغطرس"‬
‫ما رأيكم بهذا؟‬

147
00:08:47,631 --> 00:08:50,843
‫- أهذه جلسة علاجية؟‬
‫- هل تريدون جلسة علاجية؟‬

148
00:08:51,343 --> 00:08:53,554
‫كلاّ، بل نريد محقق شرطةٍ محترفاً‬

149
00:08:54,805 --> 00:08:59,476
‫سأتحدّث إلى رؤسائكما‬
‫لأضمن أنّكما أفضل خيار موجود‬

150
00:08:59,727 --> 00:09:01,395
‫عليك بهذا‬

151
00:09:01,687 --> 00:09:05,024
‫سؤال سريع‬
‫ما أسوأ ما قمتم به مؤخراً؟‬

152
00:09:07,067 --> 00:09:09,361
‫نحن نسيطر على ممتلكات‬
‫تفوق الـ٥٠ مليار دولار‬

153
00:09:09,570 --> 00:09:11,906
‫توظف شركتنا‬
‫ما يفوق النصف مليون شخص‬

154
00:09:12,573 --> 00:09:14,533
‫وخلال الستة أشهر الماضية‬
‫بالطريقة التي تدهور فيها الاقتصاد‬

155
00:09:14,867 --> 00:09:17,745
‫اضطررت إلى فصل‬
‫ألف رجل وامرأة من العمل‬

156
00:09:17,870 --> 00:09:20,289
‫والآن قد يلقي بعضهم اللوم‬
‫على شركة (كارنيليان) لمصيبتهم‬

157
00:09:20,414 --> 00:09:21,916
‫أنا واثق من ذلك‬
‫فهذا أمر مفهوم‬

158
00:09:22,416 --> 00:09:25,419
‫- هل يضايقكَ هذا الأمر شخصياً؟‬
‫- بالتأكيد‬

159
00:09:25,669 --> 00:09:28,297
‫أنا قلق بشأن الإجراءات الأمنية‬
‫كأيّ شخصٍ آخر‬

160
00:09:28,422 --> 00:09:31,091
‫- لا أعتبر نفسي منيعاً ضدّ الرصاص‬
‫- ليس هذا ما عنيته‬

161
00:09:31,217 --> 00:09:34,345
‫بل قصدت أيضايقك وجود أشخاص‬
‫عاطلين عن العمل بسبب قرارٍ أخذته؟‬

162
00:09:34,470 --> 00:09:37,014
‫كلاّ، فهذا هو عملي‬

163
00:09:37,681 --> 00:09:39,183
‫اتخاذ القرارات الصعبة‬

164
00:09:39,433 --> 00:09:41,685
‫صعبة، لكنّها منطقيّة وأخلاقيّة‬

165
00:09:41,810 --> 00:09:45,147
‫وأجل، أخشى أن يعاني الناس‬
‫جراء ذلك القرار‬

166
00:09:45,731 --> 00:09:48,359
‫إذاً، ليس من المُفاجئ‬
‫أن يأخذ أحدهم موقفاً ضدّكم‬

167
00:09:48,484 --> 00:09:50,945
‫كلاّ، فهناك دائماً الساخطين بيننا‬

168
00:09:51,737 --> 00:09:55,157
‫- سأرسل لكم اللائحة‬
‫- هل تملك لائحة بأسماء الساخطين؟‬

169
00:09:55,282 --> 00:09:57,201
‫كل من قام بمقاضاتنا‬
‫أو هدّد بمقاضاتنا‬

170
00:09:57,326 --> 00:10:00,537
‫أو أرسل رسائل تهديد أو شيء‬
‫كهذا، تتم إضافتهم إلى اللائحة‬

171
00:10:00,746 --> 00:10:03,666
‫- سيفيدنا إلقاء نظرة على تلك اللائحة‬
‫- أجل‬

172
00:10:07,544 --> 00:10:09,713
‫"نريد لائحة بأسماء كل من لديهم‬
‫تصريح أمني لدخول المطار"‬

173
00:10:10,089 --> 00:10:12,549
‫- هل تملكان مذكرّة تفويض؟‬
‫- هذه ليست معلومات سرية يا سيدتي‬

174
00:10:12,675 --> 00:10:14,176
‫يمكنكِ منحنا إياها‬
‫من دون التعرّض للمطالبة‬

175
00:10:14,343 --> 00:10:17,096
‫- حسناً، إن كنتَ واثقاً منذ هذا‬
‫- أجل، أنا واثق‬

176
00:10:17,221 --> 00:10:19,974
‫هل يمكنكِ إرسالها إلى هذا العنوان من فضلكِ؟‬

177
00:10:22,184 --> 00:10:24,728
‫مرحباً، ستصلكِ لائحة‬
‫بموظفي المطار بأيّة لحظة الآن‬

178
00:10:24,853 --> 00:10:26,230
‫حسناً‬

179
00:10:28,148 --> 00:10:30,901
‫وصلتني، سأطابقها بلائحة شركة (كورنيليان)‬

180
00:10:38,200 --> 00:10:40,619
‫ظهر اسم على كِلا اللائحتين‬
‫(لي سكيلينغ)‬

181
00:10:41,328 --> 00:10:43,205
‫- (لي سكيلينغ)‬
‫- أجل‬

182
00:10:43,330 --> 00:10:45,165
‫إنّه يعمل بشاحنة الأمتعة يومين في الأسبوع‬

183
00:10:45,332 --> 00:10:47,376
‫- هو ليس متواجداً اليوم‬
‫- حسناً، شكراً لكِ‬

184
00:10:47,501 --> 00:10:49,169
‫- شكراً لكِ‬
‫- شكراً يا (فان بيلت)‬

185
00:10:49,295 --> 00:10:50,671
‫نعم‬

186
00:10:52,256 --> 00:10:55,384
‫أنتما خدامان وغدان، أتعلمان ذلك؟‬

187
00:10:55,968 --> 00:10:57,761
‫- أيّها اللعينان‬
‫- اهدأ يا (لي)‬

188
00:10:57,886 --> 00:11:00,097
‫- أجبرني على ذلك‬
‫- قفا عندكما!‬

189
00:11:00,347 --> 00:11:02,766
‫- أطلقا سراحه الآن، أتسمعانني؟‬
‫- إنّه ليس محشواً‬

190
00:11:04,310 --> 00:11:06,520
‫والآن ضع تلك البندقية أرضاً‬
‫أيّها الأحمق‬

191
00:11:07,896 --> 00:11:09,857
‫- لكن يا أبي‬
‫- ادخل أيّها الفتى‬

192
00:11:16,989 --> 00:11:19,867
‫- لقد أفزعكما للغاية، أليس كذلك؟‬
‫- أجل، لقد أفزعنا‬

193
00:11:21,286 --> 00:11:22,663
‫كلاّ، لم يفعل ذلك‬

194
00:11:28,303 --> 00:11:30,722
‫"قبل عامين قمتَ بإرسال هذه الرسالة‬
‫إلى مقر شركة (كارنيليان)"‬

195
00:11:31,640 --> 00:11:33,058
‫"أيّها الأوغاد‬
‫عليكم أن تتحلوا بالحكمة الكافية"‬

196
00:11:33,183 --> 00:11:36,186
‫"كي تتجنبوا سرقة المواطنين‬
‫الأمريكيين النزيهين أمثالي"‬

197
00:11:36,520 --> 00:11:38,438
‫"فأنتم لستم أفضل من حثالة‬
‫مجتمع بكتابي"‬

198
00:11:38,647 --> 00:11:40,732
‫"فمن الأفضل لكم أن تدفعوا‬
‫وإلاّ فستكون هناك عواقب وخيمة"‬

199
00:11:41,191 --> 00:11:43,151
‫- هل تتذكر كتابتكَ لهذه الرسالة؟‬
‫- أجل، أتذكر‬

200
00:11:43,860 --> 00:11:46,112
‫- أخبرني بأمرها‬
‫- كما ذكِرَ في الرسالة‬

201
00:11:46,780 --> 00:11:48,990
‫والتي كتبتها بلحظة غضب‬

202
00:11:50,283 --> 00:11:53,286
‫لقد سرقوا منّي ومن عائلتي‬

203
00:11:54,287 --> 00:11:56,373
‫وحين طلبت منهم ذلك‬
‫لم يقوموا فقط بعدم الدفع لي‬

204
00:11:56,498 --> 00:11:58,542
‫بل بذلوا قصارى جهدهم‬
‫لرميي في السجن‬

205
00:11:58,667 --> 00:12:00,043
‫كيف سرقوك؟‬

206
00:12:00,293 --> 00:12:04,214
‫كنت أعمل بخط لفرع تكنولوجيا (غرانت)‬
‫الفضائية بالمحركات الأنبوبية للطائرات‬

207
00:12:04,923 --> 00:12:06,800
‫وكان لديهم مكافأة كبيرة للموظفين‬

208
00:12:07,467 --> 00:12:11,429
‫فإن جاء أحد العاملين بالمصنع بفكرة‬
‫تقوم بتوفير تكاليف أو تزيد من سرعة الخطوط‬

209
00:12:11,555 --> 00:12:14,224
‫فإنّه يحصل على مكافأة‬
‫قدرها ٥٠ ألف دولار‬

210
00:12:14,641 --> 00:12:16,810
‫لذا اقترحت عليهم فكرة‬
‫لتحسين الترس المثبّت‬

211
00:12:16,935 --> 00:12:20,772
‫والذي يوفّر عليهم خمسة سنتات ونصف لكل وحد‬
‫لقد كان أمراً ضخماً‬

212
00:12:21,189 --> 00:12:22,899
‫لذا ستكون مكافأة الـ٥٠ ألف‬
‫من نصيبي، أليس كذلك؟‬

213
00:12:23,024 --> 00:12:25,861
‫- يا له من مبلغ كبير‬
‫- صافحني المدير التنفيذي‬

214
00:12:26,611 --> 00:12:28,488
‫وقمنا بتدوين ذلك‬

215
00:12:29,364 --> 00:12:31,867
‫وبعدها قامت شركة (كارنيليان)‬
‫بشراء فرع (غرانت) للفضاء‬

216
00:12:32,284 --> 00:12:34,786
‫وحين جاء وقت تسديد مكافأتي‬
‫تهرّبوا من الدفع‬

217
00:12:34,995 --> 00:12:37,581
‫فاعترضت على هذا‬
‫حينها فصلوني من العمل‬

218
00:12:37,706 --> 00:12:40,876
‫- ماذا فعلتَ بعد ذلك؟‬
‫- حاولت مقاضاتهم‬

219
00:12:42,085 --> 00:12:44,337
‫أنا ومحامي عجوز أحول‬
‫عثرت عليه بدليل الهاتف‬

220
00:12:44,462 --> 00:12:46,339
‫ضدّ ٢٠ شخصاً مراوغاً‬
‫من جامعات رابطة الـ(لبلاب)‬

221
00:12:46,464 --> 00:12:49,843
‫ما من منافسة لذلك‬
‫لم أحصل حتى على جلسة استماع‬

222
00:12:50,260 --> 00:12:53,221
‫يبدو وكأنّك ظُلمت كثيراً‬
‫يبدو وكأنّ لديك الحق كي تغضب‬

223
00:12:53,346 --> 00:12:56,474
‫أجل، كان لديّ كلّ الحق‬

224
00:13:08,737 --> 00:13:10,530
‫صديقاكما أخذا (لي)، ماذا تريدان؟‬

225
00:13:11,573 --> 00:13:13,033
‫أأنتِ (جيسي سكيلينغ)؟‬

226
00:13:13,617 --> 00:13:15,076
‫كلاّ، بل (سيندي كراوفرد)‬

227
00:13:15,744 --> 00:13:17,412
‫إنّ (جيسي) بعطلة في (المكسيك)‬

228
00:13:32,594 --> 00:13:33,970
‫سيّدتي‬

229
00:13:34,429 --> 00:13:37,265
‫لا يمكنني حتى النظر إليّكما‬
‫فأنتما تثيران غضبي‬

230
00:13:38,141 --> 00:13:40,310
‫لم يفعل (لي) شيئاً، لا شيء‬

231
00:13:40,518 --> 00:13:43,146
‫(جيسي)، إن كان زوجكِ بريئاً‬
‫فنحن أفضل أصدقاء لكِ‬

232
00:13:43,897 --> 00:13:45,273
‫سنثبت براءته‬

233
00:13:49,569 --> 00:13:50,946
‫هل ستساعديننا؟‬

234
00:13:54,074 --> 00:13:55,533
‫أتريدان الماء أو مشروباً غازياً؟‬

235
00:13:56,326 --> 00:13:57,953
‫سيكون من الرائع لو جلبتِ لنا الماء‬

236
00:13:58,328 --> 00:14:01,706
‫أين كنتَ الليلة قبل الماضية؟ من الساعة التاسعة‬
‫مساءً إلى التاسعة من صباح اليوم التالي؟‬

237
00:14:01,831 --> 00:14:04,250
‫كنت في العمل وبعدها في المنزل‬

238
00:14:04,376 --> 00:14:06,294
‫- بالعمل في المطار‬
‫- أجل‬

239
00:14:06,878 --> 00:14:09,506
‫وأجل، كان باستطاعتي الدخول‬
‫إلى مخزن طائرات (سبرول)‬

240
00:14:09,631 --> 00:14:12,425
‫وتخريب تلكَ المظلّة‬
‫لكنّني لم أفعل ذلك‬

241
00:14:13,176 --> 00:14:16,721
‫أديت مناوبتي وبعدها عدت للمنزل‬
‫وهذا كل ما فعلته‬

242
00:14:17,514 --> 00:14:20,225
‫لم أعلم بوجود جماعة شركة (كارنيليان)‬
‫يقفزون بالمظلات في ذلك اليوم‬

243
00:14:20,892 --> 00:14:23,520
‫وهل تعرف أمراً؟ لم أكن لأكترث‬
‫بذلك حتى لو كنت أعلم‬

244
00:14:23,687 --> 00:14:25,105
‫أحقاً؟‬

245
00:14:26,690 --> 00:14:30,276
‫حسناً، أجل، كنت لأكترث‬
‫كان باستطاعتهم إعطائي ذلك المال‬

246
00:14:31,277 --> 00:14:33,530
‫فهو مبلغ تافه بالنسبة إليهم‬
‫لا شيء‬

247
00:14:34,656 --> 00:14:38,076
‫لكن قطع مظلة أحدهم، كلاّ‬

248
00:14:39,035 --> 00:14:41,746
‫خدمتَ ٤ سنوات مع قوّات الصاعقة‬
‫لذا أنتَ خبير بالمظلات‬

249
00:14:42,288 --> 00:14:43,665
‫أجل، أنا كذلك‬

250
00:14:44,249 --> 00:14:46,835
‫- أسبق أن كنتَ بالجيش يا (تشو)؟‬
‫- أجل‬

251
00:14:47,627 --> 00:14:49,004
‫إذاً، فأنتَ تعلم‬

252
00:14:49,295 --> 00:14:54,092
‫كنت لأقطع رقبة الرجل وأتبوّل على رقبته‬
‫قبل أن أقطع مظلّته بتلكَ الطريقة‬

253
00:14:55,301 --> 00:14:56,678
‫أعني...‬

254
00:14:57,762 --> 00:14:59,180
‫ذلك تصرف شرير‬

255
00:15:00,932 --> 00:15:02,308
‫هذا تخطي للحدود‬

256
00:15:04,436 --> 00:15:06,646
‫(لي) رجلّ متديّن‬

257
00:15:07,439 --> 00:15:09,315
‫ما كان ليقتل أحدهم بتلكَ الطريقة‬

258
00:15:09,733 --> 00:15:12,402
‫- مستحيل‬
‫- كان جندياً، وبمقدوره القتل‬

259
00:15:12,527 --> 00:15:15,572
‫من أجل بلاده‬
‫وليس من أجل مصلحته‬

260
00:15:16,448 --> 00:15:17,949
‫وما الفرق بينهما في رأيكِ؟‬

261
00:15:18,199 --> 00:15:20,285
‫لا أعلم، لكنّه يشكّل فارقاً كبيراً‬

262
00:15:20,660 --> 00:15:22,537
‫أنتِ واثقة للغاية من براءته‬

263
00:15:24,122 --> 00:15:25,498
‫كيف أنتِ واثقة هكذا؟‬

264
00:15:27,709 --> 00:15:30,211
‫لأنّي سألته إن قام بذلك‬
‫وأجاب بالنفي وأنّه لم يقم بذلك‬

265
00:15:31,838 --> 00:15:34,174
‫شككتِ أنّه قد يفعلها‬

266
00:15:34,716 --> 00:15:37,844
‫- لكنّه أنكر ذلك وأنتِ تصدّقينه‬
‫- لا يكذب (لي) عليّ‬

267
00:15:38,595 --> 00:15:41,931
‫هو يسبب لي المتاعب والغمّ كثيراً‬
‫لكنّه لا يكذب عليّ‬

268
00:15:43,475 --> 00:15:45,810
‫غالباً ما تقول الزوجات هذا‬
‫عن أزواجهنّ‬

269
00:15:46,561 --> 00:15:49,481
‫من السهل خداع نفسكِ‬
‫بأنّ من تحبّينه شخصّ نزيه‬

270
00:15:51,107 --> 00:15:52,484
‫أجل، إنّه كذلك‬

271
00:15:53,985 --> 00:15:56,571
‫- لكنّي أعلم بأنّه لم يكذب‬
‫- لماذا؟‬

272
00:15:56,738 --> 00:15:58,114
‫هكذا‬

273
00:15:59,616 --> 00:16:02,035
‫- لماذا؟‬
‫- لأنّي أحتضر‬

274
00:16:05,497 --> 00:16:08,792
‫ولن يرغب بالكذب على شخصٍ‬
‫سيغادر هذه الدنيا قريباً‬

275
00:16:11,753 --> 00:16:13,129
‫أنا متأسف‬

276
00:16:14,172 --> 00:16:16,091
‫تحصل مثل هذه الأمور، لا عليك‬

277
00:16:19,761 --> 00:16:21,805
‫الليلة قبل الماضية‬
‫متى عاد (لي) إلى المنزل؟‬

278
00:16:21,930 --> 00:16:24,599
‫الوقت نفسه بكل ليلة‬
‫بعد منتصف الليل بنصف ساعة‬

279
00:16:32,190 --> 00:16:33,566
‫أجل‬

280
00:16:38,988 --> 00:16:40,490
‫لم يفعل زوجي ذلك‬

281
00:16:41,658 --> 00:16:44,035
‫ماذا سيحل بالأطفال إن دخل السجن؟‬

282
00:16:46,204 --> 00:16:47,747
‫سيدخلون مركز رعاية‬

283
00:16:50,125 --> 00:16:51,584
‫ولن يفعل ذلك بي‬

284
00:16:54,504 --> 00:16:55,880
‫لن يفعل‬

285
00:16:57,632 --> 00:16:59,092
‫شكراً على وقتكِ‬

286
00:17:02,971 --> 00:17:04,931
‫"أخبرتنا زوجتك‬
‫بأنّكَ لن تفعل ذلك بها"‬

287
00:17:05,598 --> 00:17:09,185
‫لست متأكداً من هذا، ربما لو ظنت‬
‫أنّكَ ستنجو من فعلتك، فسيحصل هذا‬

288
00:17:11,104 --> 00:17:15,358
‫حين كنت أعمل بفرع (غرانت)‬
‫كانت (جيسي) تحظى بأفضل علاجٍ لمرضها‬

289
00:17:15,984 --> 00:17:20,947
‫لو لم أكن مزعجاً، لكنت ما أزال‬
‫أحتفظ بوظيفتي وبالتأمين الصحي‬

290
00:17:21,698 --> 00:17:23,158
‫وكانت (جيسي) لتكون بخير‬

291
00:17:24,200 --> 00:17:26,703
‫فلماذا كنت أتذمّر وأنوح؟ أليس كذلك؟‬

292
00:17:28,163 --> 00:17:32,250
‫أقصد، لمَ لم ألزم الصمت؟‬
‫لأحتفظ بوظيفتي‬

293
00:17:35,211 --> 00:17:36,588
‫لا أعلم‬

294
00:17:37,338 --> 00:17:39,090
‫بسبب الغرور والكبرياء‬

295
00:17:40,175 --> 00:17:41,634
‫والاختيال على ما أظن‬

296
00:17:43,636 --> 00:17:45,555
‫أجل، أظنه شيئاً من هذا القبيل‬

297
00:17:50,018 --> 00:17:51,811
‫لكن لو ظننت بأنّ باستطاعتي الإفلات من ذلك‬

298
00:17:53,771 --> 00:17:57,525
‫أجل، كنت لأقتل كل واحدٍ‬
‫من هؤلاء الأوغاد من دون استثناء‬

299
00:17:59,235 --> 00:18:01,988
‫لكن لا يمكنكَ قتل أشخاص أثرياء‬
‫والإفلات من ذلك‬

300
00:18:04,490 --> 00:18:05,950
‫الجميع يعرف ذلك‬

301
00:18:06,910 --> 00:18:09,370
‫- أعلم، بوسعي قراءة ما يدور بعقلك‬
‫- هل بوسعكِ ذلك حقاً؟‬

302
00:18:09,495 --> 00:18:13,082
‫تظن بأنّ السيّد (سكيلينغ) بريء‬
‫وبأنّ علينا إخلاء سبيله، (تشو)‬

303
00:18:13,458 --> 00:18:15,168
‫هذا مدهش‬
‫هذا تماماً ما كنت أفكر به‬

304
00:18:15,293 --> 00:18:17,170
‫كيف تقومين بذلك؟ دعيني أحاول‬

305
00:18:18,129 --> 00:18:22,759
‫أنتِ تفكرين أنّ (جاين) محق‬
‫الرجل بريء وعلينا إخلاء سبيله‬

306
00:18:23,009 --> 00:18:26,554
‫كلاّ، بل أظنكَ تريد براءته‬
‫لأنّ إدانته ستكون أمراً سهلاً للغاية‬

307
00:18:27,180 --> 00:18:29,224
‫فهو لديّه الدافع‬
‫الفرصة وليس لديّه حجّة غياب‬

308
00:18:29,474 --> 00:18:31,142
‫- أجل‬
‫- نعم أيّتها الرئيسة‬

309
00:18:31,434 --> 00:18:33,519
‫- أطلق سراح (لي سكيلينغ)‬
‫- أمتأكدة من هذا؟‬

310
00:18:34,354 --> 00:18:35,980
‫ليس لدينا دليل قاطع ضدّه‬

311
00:18:36,522 --> 00:18:37,982
‫حسناً، سأفعل ذلك‬

312
00:18:38,942 --> 00:18:41,027
‫يجدر بنا الذهاب ومخاطبة مدراء‬
‫شركة (كارنيليان) مجدداً‬

313
00:18:41,152 --> 00:18:43,154
‫- ونثير القلق بينهم‬
‫- أهذا رأيك؟ لماذا؟‬

314
00:18:43,404 --> 00:18:45,198
‫حسناً، ماذا لو كان الأمر‬
‫لا يبدو كما هو عليه؟‬

315
00:18:45,323 --> 00:18:46,950
‫ماذا لو كان متعلقاً بأمر‬
‫مختلف تماماً؟‬

316
00:18:47,075 --> 00:18:48,660
‫- مثل ماذا؟‬
‫- لا أعلم‬

317
00:18:48,993 --> 00:18:51,746
‫إذاً، فأنتَ تقترح بأن نثير قلقاً‬
‫من دون سبب وننتظر ما سيحدث‬

318
00:18:51,955 --> 00:18:54,249
‫- أجل‬
‫- كلاّ‬

319
00:18:55,291 --> 00:18:56,668
‫حسناً‬

320
00:19:18,231 --> 00:19:21,776
‫- كيف الحال؟‬
‫- سمعت أنّكما أفرجتما عن مشتبه به محتمل‬

321
00:19:22,986 --> 00:19:25,655
‫لا نظنه قام بذلك، نحن نظن...‬
‫في الواقع أنا من يظن‬

322
00:19:25,780 --> 00:19:27,323
‫فالعميلة (ليزبن) تخالفني الرأي‬

323
00:19:27,490 --> 00:19:30,827
‫أظنّ أنّ الإجابة هنا‬
‫تكمن بواحدٍ منكم‬

324
00:19:31,202 --> 00:19:33,496
‫- لكن هذا أمر سخيف‬
‫- لماذا‬

325
00:19:33,871 --> 00:19:36,958
‫أتظنّ أنّ أحدنا قام بتخريب مظلّة (ديفيد)؟‬

326
00:19:37,250 --> 00:19:39,377
‫لمَ لا؟ فقد كانت مظلته مرقمة‬

327
00:19:39,794 --> 00:19:43,131
‫وكان على المخرّب ببساطة أن يحرص‬
‫على ألاّ يختار المظلة الممزقة‬

328
00:19:43,381 --> 00:19:45,717
‫ولكن أنّى له‬
‫أن يعلم من سيختارها؟‬

329
00:19:45,842 --> 00:19:48,344
‫كان من الممكن أن يقتل‬
‫أحد زملائه بشكل عشوائي‬

330
00:19:48,761 --> 00:19:50,638
‫- لماذا سيودّ أحدنا فعل ذلك؟‬
‫- أجل‬

331
00:19:50,763 --> 00:19:54,309
‫لا أعلم، لكنّنا سنعرف ذلك‬
‫لذا، حدّثونا قليلاً عن أنفسكم‬

332
00:19:54,642 --> 00:19:57,520
‫لنستغل هذا الحزن للحصول‬
‫على بعض الحقائق، هلاّ فعلنا ذلك؟‬

333
00:19:57,812 --> 00:19:59,897
‫(جويس)، ابدئي أنتِ أولاً‬

334
00:20:00,315 --> 00:20:02,358
‫أنا أولاً، لأفعل ماذا بالضبط؟‬

335
00:20:02,650 --> 00:20:04,861
‫سأخبركِ بما أفكر من أجل البدء بالأمر‬

336
00:20:05,361 --> 00:20:07,238
‫أظنكِ شققتِ طريقكِ نحو العالم‬

337
00:20:07,363 --> 00:20:12,160
‫عبر إخفاء مشاعركِ الحقيقية‬
‫تحت قناع الإيجابية واللطف‬

338
00:20:12,535 --> 00:20:15,663
‫لكنّكِ من الداخل تفورين غضباً‬
‫وتشعرين باستياءٍ شديد‬

339
00:20:17,999 --> 00:20:20,001
‫أمّا أنتَ، فتظن بأنّ (فولك)‬
‫عبارة عن مهرّجٍ أحمق‬

340
00:20:20,126 --> 00:20:23,338
‫لكنّكَ أذكى من أن تتحلّى بالشجاعة‬
‫وتخبره بذلك‬

341
00:20:23,588 --> 00:20:24,964
‫كيف تجرؤ؟‬

342
00:20:25,089 --> 00:20:28,176
‫وأنتَ يا سيد (بريمر)‬
‫كنتَ بقوات مشاة البحرية، أليس كذلك؟‬

343
00:20:28,301 --> 00:20:29,677
‫- أجل‬
‫- حسناً‬

344
00:20:29,802 --> 00:20:32,805
‫لا بدّ من أنّ سياسة المكتب‬
‫تبدو تافهة بالمقارنة مع ذلك‬

345
00:20:34,807 --> 00:20:39,729
‫كم تتخيّل سحب بعض أسلحة‬
‫لتظهر لهؤلاء المدنيين بعض الواقعية؟‬

346
00:20:39,937 --> 00:20:42,523
‫هذا ادعاء باطل وغير مناسب‬
‫وأنا أمتعض منه‬

347
00:20:42,648 --> 00:20:48,363
‫أيّتها العميلة (ليزبن)، هذه قضية مهمة‬
‫قضيّة ستحقق تقدمكِ المهني إذا ما تمّت بنجاح‬

348
00:20:49,197 --> 00:20:50,656
‫هل هذه الطريقة‬
‫التي ترغبين فيها بالمضي قدماً؟‬

349
00:20:51,074 --> 00:20:54,827
‫- بممارسة ألعابٍ فظة؟‬
‫- أعتذر، السيّد (جاين) يعمل مستشاراً‬

350
00:20:54,994 --> 00:20:58,623
‫ولا تعبّر تصريحاته عن وجهة النظر‬
‫الرسمية لمكتب كاليفورنيا الفدرالي‬

351
00:20:58,790 --> 00:21:01,793
‫أنا أحاول ببساطة فهم صورة شاملة‬
‫لتفاعلات هذه المجموعة هنا‬

352
00:21:01,918 --> 00:21:06,047
‫مثلاً، أيمتعض أحدكم من العلاقة الرومانسية‬
‫بين (فولك) والآنسة (سوبِل)؟‬

353
00:21:08,257 --> 00:21:09,634
‫هل من أحد؟‬

354
00:21:14,013 --> 00:21:17,600
‫- لماذا سيمتعض أحد من ذلك؟‬
‫- لا تناقشيه يا (ناديا)‬

355
00:21:18,184 --> 00:21:21,062
‫- أستدعينه يملي عليكِ تصرفاتكِ؟‬
‫- هذا يكفي‬

356
00:21:23,523 --> 00:21:25,525
‫- بوسعكما الانصراف الآن‬
‫- أجل، بوسعنا ذلك‬

357
00:21:31,572 --> 00:21:36,160
‫أثرت القلق بينهم، أليس كذلك؟‬
‫ما هي النظرة المتعمّقة التي استخلصتها من ذلك؟‬

358
00:21:36,786 --> 00:21:38,246
‫لا شيء‬

359
00:21:38,371 --> 00:21:39,831
‫هذا مخيبّ للآمال بعض الشيء‬

360
00:21:40,540 --> 00:21:44,627
‫حسناً، ربما تكون هذه القضيّة‬
‫تماماً كما تبدو عليه‬

361
00:21:44,961 --> 00:21:47,213
‫ساكن ضاحية مرير‬
‫يكنّ ضغينة تجاه الأثرياء‬

362
00:21:47,422 --> 00:21:48,798
‫إلاّ أنّها رحلة جميلة‬

363
00:21:49,882 --> 00:21:51,259
‫رحلة جميلة لثلاث ساعات‬

364
00:21:52,802 --> 00:21:54,554
‫أنا جائع؟ هل أنتِ جائعة؟‬

365
00:22:03,980 --> 00:22:05,606
‫- هل أنتِ جاهزة؟‬
‫- جاهزة‬

366
00:22:08,526 --> 00:22:11,571
‫أتعرف ما الغريب بشأن هؤلاء الجماعة؟‬
‫لا يبدو بأنّ أحدهم يكترث مطلقاً‬

367
00:22:11,696 --> 00:22:15,366
‫يسقط زميلهم من السماء‬
‫وهم غير مكترثين للأمر‬

368
00:22:15,616 --> 00:22:16,993
‫أهذا شعور بالذنب أم اللامبالاة؟‬

369
00:22:17,118 --> 00:22:19,454
‫عملية غسل الدماغ التي تفعلها الشركات‬
‫تحوّلهم لرجال آليين‬

370
00:22:19,871 --> 00:22:22,832
‫لا يعود عليهم الحزن بالربح‬
‫وهذا كل ما في الأمر‬

371
00:22:23,332 --> 00:22:25,251
‫لا أصدّق ذلك‬
‫فالناس يتخذون قراراتهم بأنفسهم‬

372
00:22:25,376 --> 00:22:27,086
‫- لا يمكنكَ غسيل أدمغتهم‬
‫- بالطبع يمكن ذلك‬

373
00:22:27,211 --> 00:22:29,046
‫فهذا ما تتعلّق به هذه الرحلات‬
‫الروحية التي تُنظمها الشركة‬

374
00:22:29,672 --> 00:22:32,425
‫إنّها عملية غسيل دماغ بدائية‬
‫عن طريق جعل المجموعة تعاني‬

375
00:22:32,675 --> 00:22:36,512
‫إنّها أشبه بغناء جماعي بالمكتب‬
‫أو طقوس انتماء نادي الأخوة‬

376
00:22:36,762 --> 00:22:40,057
‫- كيف ذلك؟‬
‫- حين يتم إذلال الفرد‬

377
00:22:40,308 --> 00:22:42,643
‫فإنّ قيمتهم ترتفع لدى المجموعة‬

378
00:22:44,270 --> 00:22:46,731
‫ذهبت لأحد الرحلات الروحية‬
‫حين تمت ترقيتي كرئيسة للوحدة‬

379
00:22:47,106 --> 00:22:49,233
‫أعني، لم يتم إذلالي أو غسيل دماغي‬

380
00:22:49,358 --> 00:22:51,110
‫- هذا ما تظنينه‬
‫- لم يحدث ذلك‬

381
00:22:51,444 --> 00:22:53,946
‫- بل كانت الرحلة مفيدة بالحقيقة‬
‫- كيف ذلك؟‬

382
00:22:54,864 --> 00:22:58,701
‫تعلّم مهارات القيادة والاتصال‬
‫وتعلم بناء الثقة‬

383
00:22:59,035 --> 00:23:00,495
‫أمر يمكنك الاستفادة منه‬

384
00:23:02,830 --> 00:23:04,207
‫ماذا يُفترض أن يعني هذا؟‬

385
00:23:04,332 --> 00:23:06,501
‫وكأنّكَ لا تعلم بأنّكَ تعاني‬
‫من مشكلة كبيرة بالثقة في الآخرين‬

386
00:23:07,418 --> 00:23:09,712
‫أنا أثق بالأشخاص، أنا أثق بكِ‬

387
00:23:10,421 --> 00:23:12,131
‫كلاّ، أنتَ لا تثق بي‬
‫وأنا لا أثق بكَ أيضاً‬

388
00:23:18,387 --> 00:23:19,847
‫يضايقني سماع هذا‬

389
00:23:20,640 --> 00:23:23,226
‫- وحقاً، ألا تثقين بي؟‬
‫- بالتأكيد لا أثق بك‬

390
00:23:23,351 --> 00:23:26,812
‫كم من مرّة كذبتَ عليّ‬
‫وخدعتني واحتلتَ عليّ؟‬

391
00:23:26,938 --> 00:23:28,439
‫أتسمي هذه ثقة؟ لا‬

392
00:23:28,648 --> 00:23:30,983
‫حسناً، علينا إصلاح ذلك‬
‫لنقم بسقطة الثقة‬

393
00:23:32,193 --> 00:23:35,238
‫- سقطة الثقة؟‬
‫- بالتأكيد فعلتها برحلاتكِ الروحية‬

394
00:23:35,655 --> 00:23:37,657
‫حين تستديرين وتسقطين نفسكِ للوراء‬
‫وأنا أمسك بكِ‬

395
00:23:37,782 --> 00:23:39,242
‫أجل، فعلنا ذلك‬

396
00:23:39,617 --> 00:23:41,160
‫- كلاّ‬
‫- ألا تريدين فعل هذا؟‬

397
00:23:41,285 --> 00:23:42,745
‫لا تزال تنتظرنا رحلة طويلة‬

398
00:23:43,162 --> 00:23:46,999
‫لدينا هنا زميليّ عمل يعرفان‬
‫حدود علاقتهما المهنية‬

399
00:23:47,124 --> 00:23:50,545
‫أترين؟ أنتِ تودين الوثوق بي‬
‫لكن هناك ما يمنعكِ من ذلك‬

400
00:23:50,670 --> 00:23:54,006
‫أجل، فأنتَ غير جدير بالثقة‬
‫ووظيفتي ألاّ أثق بك‬

401
00:23:54,131 --> 00:23:57,093
‫(ليزبن)، أريد أن تعرفي أنّ بوسعكِ الوثوق بي‬

402
00:23:57,426 --> 00:24:00,680
‫ومهما حصل فسأكون موجوداً من أجلكِ‬
‫سأكون موجوداً‬

403
00:24:02,181 --> 00:24:03,558
‫أريد أن تعرفي هذا‬

404
00:24:05,434 --> 00:24:07,144
‫- والآن، أيمكنني أن أمسك بكِ؟‬
‫- بحقك‬

405
00:24:07,270 --> 00:24:08,646
‫من فضلكِ‬

406
00:24:09,689 --> 00:24:11,065
‫حسناً‬

407
00:24:14,735 --> 00:24:16,112
‫هيّا‬

408
00:24:18,322 --> 00:24:20,324
‫أترين؟ بوسعكِ الوثوق بي‬

409
00:24:20,449 --> 00:24:23,536
‫يا للعجب، نجح ذلك‬
‫فجأة بدأت أثق بك‬

410
00:24:24,287 --> 00:24:27,582
‫أنا أدعكَ تقود بي‬
‫بأرجاء هذه البلدة بهذه السيارة‬

411
00:24:27,707 --> 00:24:29,250
‫تعتبر هذه ثقة كبيرة‬

412
00:24:35,590 --> 00:24:38,551
‫"كان ذلك أداء فني كلاسيكي‬
‫في برنامج (باريس نايت)"‬

413
00:24:38,884 --> 00:24:41,053
‫"حان الوقت للعودة‬
‫إلى موسيقى الـ(جاز)..."‬

414
00:24:41,178 --> 00:24:44,390
‫- تحدّثي إليّ‬
‫- هل عليّ ذلك؟‬

415
00:24:44,557 --> 00:24:49,228
‫كلاّ، يمكنني أن أغفو فحسب‬
‫ويمكننا الانجراف بحركة المرور المقبلة‬

416
00:24:49,687 --> 00:24:51,063
‫القرار عائد إليكِ‬

417
00:24:56,611 --> 00:24:58,112
‫أشاهدتَ فلماً جيداً بالآونة الأخيرة؟‬

418
00:24:59,071 --> 00:25:00,573
‫كلاّ، ماذا عنكِ؟‬

419
00:25:02,366 --> 00:25:03,743
‫كلاّ‬

420
00:25:05,578 --> 00:25:06,954
‫كم هذا مثير للاهتمام‬

421
00:25:21,510 --> 00:25:24,221
‫(ليزبن)، وصلتنا رسالة أخرى‬
‫من المواطن المثالي الافتراضي‬

422
00:25:25,431 --> 00:25:28,100
‫"حين يخلد الجميع للنوم‬
‫فمن الأفضل أن يقولوا وداعاً"‬

423
00:25:28,476 --> 00:25:32,063
‫"حين يخلد الجميع للنوم‬
‫فمن الأفضل أن يقولوا وداعاً"‬

424
00:25:32,480 --> 00:25:35,858
‫"من أجل الحث على عرضي‬
‫فكل شيء سيرتفع"‬

425
00:25:36,942 --> 00:25:40,696
‫"وملك الخائنين، سيواجه مصرعه"‬

426
00:25:41,739 --> 00:25:43,240
‫"التوقيع، المواطن المثالي الافتراضي"‬

427
00:25:43,908 --> 00:25:45,409
‫- "أهذا كل شيء؟"‬
‫- أجل، هذا كل شيء‬

428
00:25:45,660 --> 00:25:47,620
‫- "حسناً"‬
‫- حسناً، إلى اللقاء‬

429
00:25:50,039 --> 00:25:52,083
‫أصبح الآن يكتب شعراً سيئاً‬

430
00:25:52,458 --> 00:25:54,543
‫ماذا يقصد بأنّ "كل شيء سيرتفع"؟‬

431
00:26:08,349 --> 00:26:10,059
‫ماذا؟ ماذا يعني هذا؟‬

432
00:26:10,184 --> 00:26:12,061
‫دسّ قنبلة لقتل (فولك)‬

433
00:26:30,663 --> 00:26:34,375
{\an8}‫"٢١ دقيقة، ٢٠ دقيقة"‬

434
00:26:44,494 --> 00:26:45,871
‫يا للهول!‬

435
00:26:46,997 --> 00:26:49,916
‫- ماذا تفعلان هنا؟‬
‫- تحمّلنا يا سيّد (فولك)، لدينا سبب وجيه‬

436
00:26:50,041 --> 00:26:51,418
‫أجل، ها هي‬

437
00:26:52,419 --> 00:26:54,045
‫- أخبرتكِ‬
‫- ماذا هناك؟‬

438
00:26:54,254 --> 00:26:58,550
‫لا داعي للبهجة! سيّد (فولك)‬
‫هناك قنبلة ما تحت سريرك‬

439
00:26:58,675 --> 00:27:01,928
‫- يا للهول، ماذا تعنين بذلك؟‬
‫- انتظر، دعني ألقي نظرة أفضل‬

440
00:27:03,763 --> 00:27:06,099
‫كلاّ، لا أظنّ أنّ هناك محفّز‬
‫يعمل بالضغط‬

441
00:27:06,433 --> 00:27:08,018
‫- بوسعكَ النهوض الآن‬
‫- لا تظنين ذلك؟‬

442
00:27:08,226 --> 00:27:10,854
‫أنا واثقة من ذلك، فالمؤقت‬
‫مجهز للانفجار بعد ١٠ دقائق‬

443
00:27:10,979 --> 00:27:14,065
‫لذا لدينا متسع من الوقت‬
‫هلاّ تنهض من السرير على مهل‬

444
00:27:14,441 --> 00:27:17,319
‫فلا نريد تحريك القنبلة‬
‫بأيّ شكلٍ من الأشكال‬

445
00:27:20,780 --> 00:27:24,659
‫- بحقك‬
‫- أعتذر، لم أستطع المقاومة‬

446
00:27:26,453 --> 00:27:29,706
‫"(بلوجاي رانش)"‬

447
00:27:29,831 --> 00:27:35,253
‫٩ ثوانٍ، ٨، ٧، ٦، ٥، ٤"‬

448
00:27:35,378 --> 00:27:38,924
‫٣، ٢، ١، صفر"‬

449
00:27:39,841 --> 00:27:41,885
‫- "(بلوجاي رانش)"‬
‫- "لم تنفجر القنبلة، ماذا حدث؟"‬

450
00:27:42,052 --> 00:27:43,428
‫إنّها قنبلة خطيرة للغاية‬

451
00:27:43,637 --> 00:27:46,014
‫فأي شخصٍ موجود بحدود ٦ أمتار‬
‫كان لينتهي أمره‬

452
00:27:46,848 --> 00:27:48,308
‫هل ترون السلك الموجود هنا؟‬

453
00:27:48,433 --> 00:27:50,852
‫حُلّ بمرحلة ما مما تسبب بتعطيلها‬

454
00:27:51,937 --> 00:27:53,939
‫- خطأ سخيف‬
‫- بل من حسن الحظ، أليس كذلك؟‬

455
00:27:55,106 --> 00:27:57,526
‫لا تلمس ذلك‬
‫على الرغم من أنّها معطلة‬

456
00:27:57,651 --> 00:28:00,070
‫إلاّ أنّه إن لمست السلك الأحمر‬
‫فسينتهي أمرنا جميعاً‬

457
00:28:01,446 --> 00:28:02,906
‫تسرني معرفة ذلك‬

458
00:28:03,740 --> 00:28:05,659
‫- تبدو من فعل شخصٍ خبير‬
‫- بالتأكيد‬

459
00:28:05,784 --> 00:28:09,538
‫فلدينا قنبلة عسكرية عالية‬
‫مدمجة مع محفّز متاح بالمتاجر‬

460
00:28:10,080 --> 00:28:12,082
‫فمن صنع هذا الشيء‬
‫كان يعرف تماماً ما يفعله‬

461
00:28:12,332 --> 00:28:13,708
‫- قنبلة جيش‬
‫- أجل‬

462
00:28:13,833 --> 00:28:16,836
‫فالأجزاء الداخلية مكونة من ٥ قنابل‬
‫موصلة معاً وقد تمّ إصدارها للجيش‬

463
00:28:22,092 --> 00:28:25,053
‫فور سماعه بأمر القنبلة‬
‫علم بأنّكم ستلاحقونه‬

464
00:28:25,887 --> 00:28:27,847
‫لذا حمل أغراضه وغادر المكان‬

465
00:28:28,265 --> 00:28:31,351
‫- كيف علم بأمر القنبلة؟‬
‫- أنا أخبرته بذلك‬

466
00:28:31,977 --> 00:28:35,272
‫فالاستماع إلى إذاعة الشرطة‬
‫هو هوايتي‬

467
00:28:35,814 --> 00:28:38,024
‫فأنتم تسمعون بحوادث فظيعة، يا للهول‬

468
00:28:38,149 --> 00:28:39,985
‫أين ذهب؟ لا تزال شاحنته هنا‬

469
00:28:40,110 --> 00:28:41,861
‫- أقلّه أحد الأصدقاء‬
‫- وما اسم هذا الصديق؟‬

470
00:28:41,987 --> 00:28:43,613
‫بالطبع، وكأنّني سأخبركما باسمه‬

471
00:28:43,863 --> 00:28:46,074
‫هروب (لي) سيجعل الأمور‬
‫تبدو أسوأ بالنسبة إليه‬

472
00:28:46,616 --> 00:28:48,076
‫صحيح‬

473
00:28:48,618 --> 00:28:52,622
‫طلب أن أخبركما بأنّه بريء تماماً‬
‫وأنّه لم يقم بذلك‬

474
00:28:52,872 --> 00:28:54,833
‫لكن ذلك لا يهم‬
‫حالما يقبض عليكَ القانون‬

475
00:28:55,166 --> 00:28:57,627
‫- أتعرفين إلى أين ذهب؟‬
‫- ألا ترغبان بمعرفة مكانه؟‬

476
00:28:57,752 --> 00:28:59,546
‫أنا أعرف مكانه‬
‫لكنّي أتسائل إن كنتِ تعرفين‬

477
00:28:59,713 --> 00:29:01,464
‫- أحقاً؟ أين ذهب؟‬
‫- إلى الجبال‬

478
00:29:04,134 --> 00:29:05,802
‫حسناً، تفضلا بالبحث عنه‬
‫فلن تجدوه‬

479
00:29:05,927 --> 00:29:08,805
‫أنا متأكد من أنّكِ محقة‬
‫فزوجكِ رجلّ كفؤ‬

480
00:29:08,972 --> 00:29:10,765
‫- أجل، إنّه كذلك‬
‫- أهو مسلّح؟‬

481
00:29:11,474 --> 00:29:14,019
‫إن كان كذلك، فذلك للصيد‬
‫ليس لسبب آخر‬

482
00:29:14,978 --> 00:29:17,480
‫أبلغيه بتحيتي‬
‫عندما تكلميه في المرة القادمة‬

483
00:29:18,440 --> 00:29:19,816
‫سأبلغه بذلك‬

484
00:29:26,239 --> 00:29:28,825
‫- تباً، ما كان عليّ إخلاء سبيله‬
‫- هو ليس الفاعل‬

485
00:29:29,284 --> 00:29:31,244
‫ربما هو ليس الفاعل‬
‫لكنّه بالتأكيد يبدو كأنّه الفاعل‬

486
00:29:32,245 --> 00:29:35,040
‫(ريغسبي)، أرسل تعميماً‬
‫على مراكز الشرطة عن (لي سكيلينغ)‬

487
00:29:35,415 --> 00:29:37,375
‫إنّه مسلّح وخطير‬
‫ويتوجه نحو المناطق الجبلية‬

488
00:29:38,460 --> 00:29:39,878
‫هو ليس الفاعل‬

489
00:29:40,545 --> 00:29:43,590
‫"إنّ (كارنيليان) عبارة عن شركة‬
‫مؤسسة على القيم الأمريكية الحسنة"‬

490
00:29:44,049 --> 00:29:45,842
‫"سنكون شركة أفضل بسبب هذا"‬

491
00:29:46,176 --> 00:29:50,263
‫"والشخص المختل وراء هذا الهجوم‬
‫لن يؤثر علينا بأيّ طريقة"‬

492
00:29:51,264 --> 00:29:52,766
‫"فنحن لن نخاف"‬

493
00:29:54,059 --> 00:29:56,269
‫الأحمق، يلعب دور البطل‬

494
00:29:56,394 --> 00:29:58,688
‫- سيتسبب بمقتله‬
‫- عليه أن يتصرّف بصلابة‬

495
00:29:58,813 --> 00:30:00,899
‫على شركة (كارنيليان) تحويل‬
‫هذه المسألة إلى مصلحتها العامة‬

496
00:30:01,024 --> 00:30:03,485
‫- أو سيخسر عملهم أموال طائلة‬
‫- ما حال أسعار أسهم (كارنيليان)؟‬

497
00:30:03,610 --> 00:30:06,237
‫انخفضت بنسبة ٥٠٪ منذ وفاة‬
‫(ويتيكر) وما تزال تنخفض‬

498
00:30:06,404 --> 00:30:08,490
‫يا للعجب، أتسائل إن كسب‬
‫أحدهم مالاً من انخفاض الأسهم‬

499
00:30:08,657 --> 00:30:10,116
‫- تقصد بيعه للأسهم‬
‫- أجل‬

500
00:30:10,241 --> 00:30:13,578
‫إن عرفت مسبقاً بأنّ المواطن المثالي‬
‫الافتراضي سيستهدف الشركة‬

501
00:30:13,703 --> 00:30:15,330
‫وذلك لأنّكَ أنتَ هو‬
‫"المواطن المثالي الافتراضي" حينها...‬

502
00:30:15,622 --> 00:30:17,874
‫المراهنة ضدهم في البورصة‬
‫ستكون ربحاً سهلاً‬

503
00:30:17,999 --> 00:30:20,126
‫لا يمكن أن يكون (سكيلينغ)‬
‫فهو لا يملك مالاً ليراهن به‬

504
00:30:20,251 --> 00:30:21,920
‫حسناً، هو ليس (سكيلينغ)‬
‫ونحن نعرف مسبقاً بذلك‬

505
00:30:22,212 --> 00:30:24,381
‫أنتَ تعرف ذلك‬
‫نحن فنبقي خياراتنا مفتوحة‬

506
00:30:26,257 --> 00:30:28,259
‫سأباشر بذلك‬
‫سأبحث بالسجلات التجارية للبورصة‬

507
00:30:28,468 --> 00:30:30,512
‫لنرى إن حصد أحدهم ربحٍ قاتل‬
‫إن جاز التعبير‬

508
00:30:36,685 --> 00:30:40,355
‫- هل من خبر عن (سكيلينغ)؟‬
‫- مشاهدتان محتملتان بجبل (ويتني)‬

509
00:30:40,522 --> 00:30:42,732
‫الشرطة المحلية وإدارة المتنزهات‬
‫الوطنية يبحثون عنه، سنقبض عليه‬

510
00:30:42,899 --> 00:30:45,694
‫أشك بذلك‬
‫فـ(سكيلينغ) بمكانه الطبيعي هناك‬

511
00:30:45,944 --> 00:30:48,113
‫فقد تحقق حلمه‬
‫بعيش حياة خيالية هناك‬

512
00:30:49,155 --> 00:30:52,325
‫- إنّه يختبئ هناك مثل الدبّ‬
‫- وجدتها‬

513
00:30:52,867 --> 00:30:55,412
‫عثرت على حسابٍ تجاري‬
‫قام بعدّة تحرّكات متتالية في البورصة‬

514
00:30:55,537 --> 00:30:56,996
‫ضدّ أسهم شركة (كارنيليان)‬

515
00:30:57,122 --> 00:30:59,124
‫وعمليات البيع هذه متوافقة تماماً‬
‫مع الخط الزمن للأحداث‬

516
00:30:59,290 --> 00:31:00,709
‫أهناك اسم ملحق بذلك الحساب؟‬

517
00:31:00,834 --> 00:31:02,419
‫هناك مسار فرعي...‬

518
00:31:03,086 --> 00:31:07,340
‫لمصرف بريطاني‬
‫حساب شركة باسم (ن.س.هولدينغز)‬

519
00:31:07,465 --> 00:31:09,634
‫(ن.س)، (ناديا سوبِل)‬

520
00:31:12,345 --> 00:31:14,013
‫نحن نبحث عن (ناديا سوبل)‬

521
00:31:14,597 --> 00:31:17,016
‫توجهت للجبال مع الآخرين‬
‫ليلعبوا لعبة الحرب؟‬

522
00:31:17,142 --> 00:31:18,727
‫- الحرب‬
‫- أجل، كمّا تعرفان...‬

523
00:31:18,852 --> 00:31:21,855
‫بنادق رمي الألوان، يقسمون إلى فريقين‬
‫ويرتدون زياً معيّناً‬

524
00:31:21,980 --> 00:31:24,315
‫ويزحفون في الأرجاء‬
‫محاولين قتل بعضكم البعض‬

525
00:31:24,566 --> 00:31:28,361
‫إنّها لعبة مسلية للغاية لو لم ألوِ كاحلي‬

526
00:31:28,778 --> 00:31:32,031
‫إذاً، لمَ تريدان التحدث مع (ناديا)؟‬

527
00:32:10,403 --> 00:32:11,780
‫(ناديا)‬

528
00:32:13,072 --> 00:32:14,449
‫أنتِ‬

529
00:32:15,992 --> 00:32:17,368
‫(ناديا)‬

530
00:32:18,495 --> 00:32:19,871
‫يا إلهي!‬

531
00:32:46,800 --> 00:32:48,302
‫- شكراً‬
‫- ماذا لدينا؟‬

532
00:32:48,719 --> 00:32:50,304
‫أرسلت الجثة إلى المختبر قبل ساعتين‬

533
00:32:50,429 --> 00:32:52,181
‫نظمت الشرطة المحليّة‬
‫شبكة بحث بموقع الجريمة‬

534
00:32:52,639 --> 00:32:54,308
‫- هل من خبر عن (سكيلينغ)؟‬
‫- لا شيء مؤخراً‬

535
00:32:54,558 --> 00:32:56,518
‫لكن آخر مشاهدة جيدة له‬
‫كانت بمنتصف الصباح‬

536
00:32:56,810 --> 00:32:59,563
‫عند مسافة ٥،٦ كلم من قمة الجبل‬
‫حيث تمّ إطلاق النار على (سوبل)‬

537
00:32:59,938 --> 00:33:01,565
‫ويشير الإطار الزمني‬
‫بأنّ بوسعه فعل ذلك بسهولة‬

538
00:33:01,982 --> 00:33:05,652
‫- مجرّد مصادفة، لم يقتلها‬
‫- نحن لا... لا عليك‬

539
00:33:06,195 --> 00:33:09,406
‫- مهما كان الفاعل فهو يظننا حمقى‬
‫- أجل، وهذا خطأ‬

540
00:33:09,698 --> 00:33:11,784
‫كيف ذلك؟‬
‫فنحن بالتأكيد نبدو كالحمقى‬

541
00:33:11,909 --> 00:33:14,578
‫حين تصاب المشتبه بها الرئيسية لدينا‬
‫أمامنا مباشرةً‬

542
00:33:14,703 --> 00:33:16,163
‫ليس أمامنا‬

543
00:33:16,288 --> 00:33:18,248
‫- أوصلت رسالة من المواطن المثالي؟‬
‫- ولا كلمة‬

544
00:33:18,499 --> 00:33:22,211
‫لن يصلكم منه شيء‬
‫فذلك التمويه أصبح مملاً وحسب‬

545
00:33:22,336 --> 00:33:23,962
‫أتظن أنّ المواطن المثالي الافتراضي‬
‫مجرّد حيلة؟‬

546
00:33:24,505 --> 00:33:26,256
‫إذاً ما الدافع وراء‬
‫قتل (ويتيكر) و(سوبل)؟‬

547
00:33:26,423 --> 00:33:27,883
‫أجل، هذا هو السؤال‬

548
00:33:28,133 --> 00:33:31,428
‫كان موت (ويتيكر) عشوائياً، كان بوسع‬
‫أيّ منهم أخذ المظلة الممزقة‬

549
00:33:31,553 --> 00:33:33,680
‫لكن لم يكن موت (سوبل) عشوائياً‬
‫ماذا يدّلنا هذا؟‬

550
00:33:36,350 --> 00:33:39,937
‫- ماذا؟ نحن نستسلم‬
‫- حسناً، أنا لست متأكداً تماماً‬

551
00:33:41,939 --> 00:33:44,274
‫- ألا يزال (فولك) والبقيّة بالداخل؟‬
‫- أجل‬

552
00:33:49,196 --> 00:33:51,949
‫- ما الموجود في داخل الكيس؟‬
‫- غداء النزهة‬

553
00:33:52,491 --> 00:33:54,368
‫- ما الموجود في داخل الكيس؟‬
‫- قنبلة‬

554
00:33:55,536 --> 00:33:57,120
‫ما الموجود في داخل الكيس؟‬
‫أنا جادة‬

555
00:33:57,329 --> 00:33:58,789
‫جدياً، قنبلة‬

556
00:34:00,207 --> 00:34:03,710
‫- "ماذا حدث؟"‬
‫- كنت و(سوبل) نتنافس ضدّ (دي شون) و(جويس)‬

557
00:34:03,836 --> 00:34:05,838
‫كنت أتتبع (جويس)‬
‫حين سمعت الطلقات النارية‬

558
00:34:06,004 --> 00:34:08,841
‫وبعدها سمعت (دي شون)‬
‫يصرخ من أعلى الجبل‬

559
00:34:12,386 --> 00:34:15,389
‫سيّد (فولك)؟ وصلت سياراتكم‬
‫وتمّ تحميل الأمتعة‬

560
00:34:15,722 --> 00:34:17,558
‫- شكراً لكَ يا (جايك)‬
‫- هل ستغادرون؟‬

561
00:34:17,683 --> 00:34:20,352
‫أجل، كان البقاء هنا غلطة‬

562
00:34:20,894 --> 00:34:22,396
‫كنت أجازف بحياتنا‬
‫من أجل إثبات وجهة نظر‬

563
00:34:22,521 --> 00:34:25,774
‫والآن دفعت المسكينة (ناديا)‬
‫ثمن ذلك، هذا لا يحتمل‬

564
00:34:25,899 --> 00:34:28,569
‫- لا تلقي اللوم على نفسك‬
‫- لمَ لا؟‬

565
00:34:29,278 --> 00:34:31,363
‫- المعذرة‬
‫- كلاّ، لا بأس بذلك‬

566
00:34:32,739 --> 00:34:36,785
‫فالملاحظة في محلها، كنت مخطئاً‬
‫وكانت الشركة على خطأ‬

567
00:34:37,202 --> 00:34:39,121
‫عليّ إصدار بيان وتقديم اعتذار‬

568
00:34:39,621 --> 00:34:42,040
‫كلاّ، كلاّ‬
‫لا يمكنكَ ترك هذا المعتوه ينتصر‬

569
00:34:42,165 --> 00:34:44,918
‫كلاّ، ليس للمواطن المثالي الافتراضي‬
‫بل لعامة الناس، للشعب‬

570
00:34:45,377 --> 00:34:47,880
‫ستغير شركة (كارنيليان) أساليبها‬
‫وستصبح شركة أفضل‬

571
00:34:48,046 --> 00:34:52,676
‫من خلال التعويض عن معاناتها، سنجددها‬
‫ونجدد شعارها، الصدق، النزاهة‬

572
00:34:53,468 --> 00:34:56,054
‫- هذا بمنتهى الذكاء‬
‫- أجل إنّه كذلك‬

573
00:34:56,346 --> 00:34:58,765
‫- إنّه بمنتهى الذكاء‬
‫- كلاّ، إنّه ضروري‬

574
00:35:00,100 --> 00:35:02,436
‫بأيّ حال، أريد حملة عن هذه المواضيع‬
‫جاهزة بحلول الأسبوع المقبل‬

575
00:35:02,561 --> 00:35:04,855
‫- سأجعل أحدهم يعمل على ذلك‬
‫- ورد اتصال من (فان بيلت)‬

576
00:35:04,980 --> 00:35:07,482
‫عثر الخبراء على تطابق للرصاصة‬
‫التي تمّ استخراجها من (سوبل)‬

577
00:35:07,900 --> 00:35:12,946
‫إنّها رصاصة من نوع الدقيق بعيار ٢٦٤‬
‫من صُنع شركة (وينشيستر) للأسلحة بعام ١٩٨٩‬

578
00:35:13,155 --> 00:35:15,782
‫كدفعة حسب الطلب مخصصة‬
‫كجائزة للمشتركين العشرة النهائيين‬

579
00:35:15,908 --> 00:35:19,411
‫بمسابقة رعاة البقر الأمريكية السنوية‬
‫للرماية في (رينو)، (نيفادا)‬

580
00:35:19,536 --> 00:35:21,580
‫- أتمزح؟‬
‫- دعني أخمن‬

581
00:35:22,831 --> 00:35:24,541
‫- (جايك كوبي)‬
‫- المركز السابع‬

582
00:35:24,750 --> 00:35:26,919
‫(جايك كوبي)، مدير المزرعة؟‬

583
00:35:27,044 --> 00:35:30,255
‫بالطبع، هذا يبدو منطقياً، هذا مثالي‬

584
00:35:30,589 --> 00:35:33,133
‫- هل هو كذلك؟‬
‫- لمَ سيرغب (كوبي) بقتل أحدهم؟‬

585
00:35:33,675 --> 00:35:35,218
‫حسناً، دعونا نذهب ونسأله‬

586
00:35:35,427 --> 00:35:38,889
‫سيّد (فولك)‬
‫أين تقع استراحة السيّد (كوبي)؟‬

587
00:35:39,389 --> 00:35:41,308
‫- بمطبخ الموظفين‬
‫- شكراً لك‬

588
00:35:41,475 --> 00:35:44,811
‫مهلاً، ما علاقة (جايك) بالقضية؟‬

589
00:35:45,729 --> 00:35:48,690
‫الرصاصة التي تسببت بمقتل (ناديا)‬
‫يبدو أنّها مميزة للغاية‬

590
00:35:48,815 --> 00:35:50,776
‫ومن المؤكد تقريباً‬
‫أنّها تعود للسيّد (كوبي)‬

591
00:35:50,901 --> 00:35:52,569
‫(جايك)، هذا محال‬

592
00:35:52,861 --> 00:35:54,613
‫- أنتَ تعرفه جيداً، أليس كذلك؟‬
‫- أجل‬

593
00:35:54,738 --> 00:35:56,406
‫آتي إلى هنا منذ ٦ أعوام‬
‫نحن صديقان مقرّبان‬

594
00:35:56,657 --> 00:35:59,993
‫هو رجل طيّب، أروع شخص رأيته‬
‫هذا غير ممكن‬

595
00:36:00,827 --> 00:36:02,329
‫الأدلّة الجنائية لا تكذب‬

596
00:36:03,413 --> 00:36:06,667
‫- ألم يبدِ عدائه تجاهك؟‬
‫- كلاّ، مطلقاً‬

597
00:36:07,960 --> 00:36:09,670
‫لا بدّ من أنّها ضغينة خفيّة‬

598
00:36:10,504 --> 00:36:12,589
‫قلتَ مطبخ الموظفين‬
‫أهو بهذا الاتجاه؟‬

599
00:36:16,635 --> 00:36:18,387
‫- ربما بمقدورك مساعدتنا‬
‫- أجل بالطبع، أيّ شيء...‬

600
00:36:18,512 --> 00:36:20,722
‫- رافقني أثناء استجوابي للسيّد (كوبي)‬
‫- حسناً‬

601
00:36:20,847 --> 00:36:23,517
‫- جيّد‬
‫- توقف، لا أظنها فكرة سديدة‬

602
00:36:24,142 --> 00:36:26,478
‫حسناً، هو الشخص الذي (كوبي)‬
‫غاضب منه، لنستغل هذا‬

603
00:36:26,603 --> 00:36:29,398
‫- لنغضبه قليلاً‬
‫- قد يجدي ذلك، لكنّها مجازفة كبيرة‬

604
00:36:29,523 --> 00:36:32,859
‫يمكنكِ الانتظار خارجاً حاملة سلاحكِ‬
‫في حالة ثار جنون (كوبي) قليلاً‬

605
00:36:40,617 --> 00:36:42,828
‫هل تقول إنّني الفاعل؟‬
‫أنا من أطلق النار عليها‬

606
00:36:43,537 --> 00:36:47,874
‫أجل، وقطعت مظلة (ويتيكر)‬
‫وزرعتَ القنبلة التي كادت تقتل السيّد (فولك)‬

607
00:36:48,000 --> 00:36:49,626
‫بالتأكيد لم أفعل ذلك‬

608
00:36:49,960 --> 00:36:52,629
‫يا للهول، لماذا سأفعل أمراً كذلك؟‬

609
00:36:52,754 --> 00:36:55,007
‫- هذا ما نريد معرفته‬
‫- أأنتما جادّين؟‬

610
00:36:55,257 --> 00:36:58,343
‫بحقك، منذ متى تعرفني يا سيد (فوك)؟‬

611
00:36:58,510 --> 00:37:01,888
‫لماذا يا (جايك)؟ ماذا فعلت لكَ‬
‫يوماً كي تبرر فعلتك هذه؟‬

612
00:37:02,681 --> 00:37:04,808
‫- ساعدني على الفهم‬
‫- حسناً‬

613
00:37:05,642 --> 00:37:07,019
‫هذا هو الحال‬

614
00:37:07,978 --> 00:37:11,231
‫- لا أعلم كيف، لكنّكما مخطئان بشأني‬
‫- هل هذا صحيح؟‬

615
00:37:12,232 --> 00:37:15,444
‫إذاً، لمَ رصاصتك التي فزت بها‬
‫ما تسبب بمقتل (ناديا سوبل)؟‬

616
00:37:15,569 --> 00:37:19,364
‫- هل كانت كذلك؟‬
‫- ولمَ صنعت هذه الأداة الذكية، أجب؟‬

617
00:37:19,489 --> 00:37:21,616
‫ماذا؟ هل هذه قنبلة؟‬

618
00:37:22,409 --> 00:37:24,494
‫أجل يا (جايك)، إنّها قنبلتك‬
‫أنت من صنعها‬

619
00:37:24,703 --> 00:37:27,039
‫كلاّ، لم أفعل ذلك‬
‫ماذا كنتَ تدخّن يا رجل؟‬

620
00:37:27,164 --> 00:37:29,833
‫أحقاً؟ أهي ليست قنبلتك؟‬
‫أليس هذا زر التفجير؟‬

621
00:37:30,959 --> 00:37:32,794
‫- بحقك‬
‫- هل هذه...‬

622
00:37:33,045 --> 00:37:36,965
‫لا بأس، التزما الهدوء‬
‫ليس هناك مشكلة‬

623
00:37:37,841 --> 00:37:41,511
‫واثق تماماً من أنّكَ قمتَ بتعطيلها‬
‫بإزالة هذا السلك من الزر الأحمر‬

624
00:37:41,636 --> 00:37:43,722
‫كلاّ، أيّها الأحمق‬

625
00:37:46,141 --> 00:37:50,812
‫- هكذا، ماذا تحاول أن تفعل؟‬
‫- ها هو... كما يقولون‬

626
00:37:51,104 --> 00:37:52,481
‫ماذا تقصد؟‬

627
00:37:53,565 --> 00:37:54,983
‫عرفتَ طريقة تعطيل القنبلة‬

628
00:37:56,068 --> 00:37:57,486
‫لأنّكَ من صنعها‬

629
00:37:58,195 --> 00:38:05,077
‫وضعتها لإبعاد الشبهات عنك‬
‫ولهذا فأنتَ من قتل (ويتيكر) و(سوبل)‬

630
00:38:07,162 --> 00:38:10,582
‫أكره إفساد نظريتك‬
‫لكن من الواضح كيفية تعطيل قنبلة‬

631
00:38:10,707 --> 00:38:13,043
‫كلاّ، لم يكن كذلك‬
‫متأكد من أنّ ٩٠٪ من الناس‬

632
00:38:13,168 --> 00:38:15,462
‫- سيفكرون بإزالة هذا السلك‬
‫- كلاّ‬

633
00:38:16,129 --> 00:38:19,091
‫قامت فرقة تفكيك القنبلة بإزالة المتفجرات‬
‫هذا مجرّد نموذج‬

634
00:38:19,216 --> 00:38:22,385
‫وأنتَ قاتل حقير مخادع وبلا مشاعر‬

635
00:38:22,677 --> 00:38:25,222
‫- أين تحتفظ بالشاي يا سيد (كوبي)؟‬
‫- بالخزانة‬

636
00:38:25,806 --> 00:38:27,307
‫- أنتَ مجنون‬
‫- شكراً لك‬

637
00:38:28,934 --> 00:38:31,853
‫هلاّ تفضلتَ وطلبتَ من العميلة‬
‫(ليزبن) الدخول؟‬

638
00:38:32,521 --> 00:38:33,897
‫شكراً يا سيد (كوبي)‬

639
00:38:38,235 --> 00:38:39,986
‫ليس لديك إثباتً قانونياً على الإطلاق‬

640
00:38:41,988 --> 00:38:43,865
‫سنجد الإثبات القانوني، بلا شك‬

641
00:38:44,741 --> 00:38:46,159
‫لكنّي شخصياً، لست بحاجة إليّه‬

642
00:38:46,910 --> 00:38:48,453
‫فأنا أحب معرفة كوني مُحقاً‬

643
00:38:50,664 --> 00:38:52,624
‫سيدي، ضع يديكَ خلف ظهرك‬

644
00:38:53,625 --> 00:38:55,001
‫أنتَ قيد الاعتقال‬

645
00:38:55,961 --> 00:38:57,337
‫لنذهب‬

646
00:39:13,895 --> 00:39:18,066
‫عرفت أنّكَ القاتل عندما لم تنفجر القنبلة التي‬
‫تحتَ سريرك، كان هذا بمنتهى الذكاء يا (راندي)‬

647
00:39:18,525 --> 00:39:20,902
‫- بمنتهى الذكاء‬
‫- لا تناديني (راندي)‬

648
00:39:21,027 --> 00:39:24,156
‫لكن لماذا أردت قتل أحد مدرائك‬
‫التنفيذيين بشكل عشوائي؟‬

649
00:39:24,531 --> 00:39:27,450
‫لا يبدو هذا منطقياً‬
‫وبعدها تم قتل (سوبل)‬

650
00:39:28,368 --> 00:39:32,038
‫وعرفت خطتكَ بأكملها يا (راندي)‬

651
00:39:32,956 --> 00:39:36,293
‫- هذا تصرّف سخيف‬
‫- وفاة (ويتيكر) كانت مجرّد تمويه‬

652
00:39:36,418 --> 00:39:38,003
‫لإخفاء موت (سوبل)‬

653
00:39:39,129 --> 00:39:40,589
‫فهي من أردت موتها‬

654
00:39:41,715 --> 00:39:44,050
‫لن أتفوه بكلمة إضافية حتى وصول محاميّ‬

655
00:39:44,467 --> 00:39:46,803
‫يكفي القول إنّكَ لا تملك الإثبات على ذلك‬

656
00:39:47,512 --> 00:39:50,265
‫السؤال، ماذا تعرف (سوبل) ضدّك؟‬

657
00:39:50,974 --> 00:39:53,727
‫- ماذا كانت ستفعل؟‬
‫- لا شيء‬

658
00:39:55,145 --> 00:39:56,521
‫كان هذا سؤالاً بلاغياً‬

659
00:39:57,063 --> 00:39:58,690
‫نحن نعرف كل ما نحتاج‬
‫إلى معرفته الآن‬

660
00:39:59,441 --> 00:40:02,027
‫هذه شهادة خطية من محامي‬
‫(ناديا سوبل)‬

661
00:40:03,445 --> 00:40:06,448
‫تفاوضت (ناديا) سراً للانضمام لشركة‬
‫(ك.ب.ت)، الشركة المنافسة الأولى لك‬

662
00:40:06,573 --> 00:40:10,202
‫وكانت أيضاً تخطط لرفع دعوى تحرّش‬
‫ضدك بالتزامن مع وقت مغادرتها‬

663
00:40:10,619 --> 00:40:13,288
‫لهذا السبب كانت تبيع أسهم الشركة‬
‫ولهذا السبب أردت قتلها‬

664
00:40:13,413 --> 00:40:17,125
‫لأنّ لا أحد يتخطّى (راندال فولك)‬
‫أليس كذلك؟‬

665
00:40:18,001 --> 00:40:19,419
‫لا أحد‬

666
00:40:21,338 --> 00:40:22,797
‫أين هو محاميّ؟‬

667
00:40:23,340 --> 00:40:27,385
‫لكن صدقني أنّ خدعة "المواطن المثالي"‬
‫فكرة عبقرية‬

668
00:40:29,012 --> 00:40:34,059
‫لم أفهم كيف يمكنكَ الربح من مهاجمة‬
‫شركتك، ولكن لديّك رؤية‬

669
00:40:34,434 --> 00:40:37,229
‫تولد (كارنيليان) من جديد وتجدد شعارها‬

670
00:40:37,979 --> 00:40:41,816
‫الجميع يحب العودة‬
‫الجميع يحب الخلاص‬

671
00:40:44,110 --> 00:40:46,196
‫- ليس لديكما شيء ضدّي‬
‫- بل لدينا ما يكفي لتدميرك‬

672
00:40:46,321 --> 00:40:51,117
‫وأنتَ تعلم ذلك‬
‫لذا قبل وصول محاميك ومنعنا من استجوابك‬

673
00:40:52,327 --> 00:40:53,703
‫لنعقد صفقة‬

674
00:41:00,168 --> 00:41:01,836
‫- أنا مصغِ‬
‫- جيد‬

675
00:41:02,712 --> 00:41:04,756
‫سنعتبر جريمة قتل (ويتيكر) غير متعمدة‬

676
00:41:05,674 --> 00:41:07,550
‫وسننسى أمر القنبلة‬

677
00:41:09,010 --> 00:41:10,971
‫ولن نطالب بعقوبة الإعدام‬

678
00:41:16,184 --> 00:41:18,061
‫مقابل ماذا؟‬

679
00:41:26,444 --> 00:41:29,155
‫فواتير، ما هذا؟‬

680
00:41:38,623 --> 00:41:42,794
‫"(لي سكيلينغ)، ٥٠٠ ألف دولار"‬

681
00:41:44,462 --> 00:41:46,381
‫"التوقيع: (راندال فولك)"‬

682
00:41:50,343 --> 00:41:51,970
‫يا للهول!‬

683
00:41:55,181 --> 00:41:56,641
‫(ريبا)، انظري إلى هذا‬

